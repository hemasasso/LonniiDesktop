<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      Source files are UTF-8 without a BOM. Without this the compiler falls back to the
      system code page on Windows and the French labels ship double-encoded
      ("Gérez" instead of "Gérez").
    -->
    <CodePage>65001</CodePage>

    <!-- The whole product is Windows-only: WPF client, SQLite on a Windows host. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
