<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The build installed on shops' computers (ShippedHost): its licence rules ignore the switches a
       shop could edit in lonnii.db or appsettings.json. Set by deploy/windows/build-installer.ps1;
       never for the OCI build, which refuses to start with it anyway (it runs on PostgreSQL). -->
  <PropertyGroup Condition="'$(LonniiShippedHost)' == 'true' or '$(Configuration)' == 'DebugInstaller'">
    <DefineConstants>$(DefineConstants);LONNII_SHIPPED_HOST</DefineConstants>
  </PropertyGroup>
  <!-- The marker build-installer.ps1 looks for before packaging. -->
  <ItemGroup Condition="'$(LonniiShippedHost)' == 'true' or '$(Configuration)' == 'DebugInstaller'">
    <AssemblyMetadata Include="LonniiShippedHost" Value="true" />
  </ItemGroup>

  <!-- When this build was made: caps how long a host may run without a signed licence (LicenceGuard). -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildDateUtc" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests exercise account creation without making it part of the public surface. -->
    <InternalsVisibleTo Include="Lonnii.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lonnii.Data\Lonnii.Data.csproj" />
    <ProjectReference Include="..\Lonnii.Shared\Lonnii.Shared.csproj" />
  </ItemGroup>

</Project>
