<Application x:Class="Lonnii.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lonnii.Client">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette must be merged before Styles.xaml, whose styles reference it
                     by DynamicResource, and ThemeManager assumes it sits at index 0. -->
                <ResourceDictionary Source="Theme/Palette.Light.xaml" />
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:RoleLabelConverter x:Key="RoleLabel" />
            <local:CurrencyConverter x:Key="Currency" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
