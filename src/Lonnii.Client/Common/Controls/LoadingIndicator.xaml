<UserControl x:Class="Lonnii.Client.Common.Controls.LoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A veil over the content behind it, with a small card holding a spinning arc and
         "Chargement" followed by dots that come and go. The animations only run while the
         control is visible (see the code-behind), so the hidden busy panels cost nothing. -->
    <UserControl.Resources>
<Storyboard x:Key="Spin">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                                               Duration="0:0:1.2" RepeatBehavior="Forever">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                                               Duration="0:0:1.2" RepeatBehavior="Forever">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                                               Duration="0:0:1.2" RepeatBehavior="Forever">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.2" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.9" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Rectangle Fill="{DynamicResource Surface}" Opacity="0.7" />

        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,20" CornerRadius="12"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource Border}" StrokeThickness="4" />
                    <Path Stroke="{DynamicResource Accent}" StrokeThickness="4" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Data="M 22,2 A 20,20 0 0 1 42,22"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock Text="Chargement" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="Dot1" Text="." FontSize="14" FontWeight="Bold" Opacity="0.2"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="Dot2" Text="." FontSize="14" FontWeight="Bold" Opacity="0.2"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="Dot3" Text="." FontSize="14" FontWeight="Bold" Opacity="0.2"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
