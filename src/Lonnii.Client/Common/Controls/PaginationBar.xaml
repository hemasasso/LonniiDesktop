<!--
  Prev/Next plus a small "jump to page" box, shared by every paged list in the app (Nouvelle
  Vente's catalogue, Liste des Ventes, and the Client/Fournisseur/Catégorie managers) so a long
  list never needs clicking Next a dozen times to reach a specific page.
-->
<UserControl x:Class="Lonnii.Client.Common.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="PrevButton" Style="{StaticResource SecondaryButton}" Padding="10,3"
                ToolTip="Page précédente" Click="Prev_Click">
            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                       Style="{StaticResource ButtonContentText}" />
        </Button>
        <TextBlock x:Name="PageText" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Button x:Name="NextButton" Style="{StaticResource SecondaryButton}" Padding="10,3"
                ToolTip="Page suivante" Click="Next_Click">
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                       Style="{StaticResource ButtonContentText}" />
        </Button>
        <TextBox x:Name="JumpBox" Width="42" Margin="14,0,0,0" Padding="4,3"
                 TextAlignment="Center" ToolTip="Aller à la page…" KeyDown="JumpBox_KeyDown" />
    </StackPanel>
</UserControl>
