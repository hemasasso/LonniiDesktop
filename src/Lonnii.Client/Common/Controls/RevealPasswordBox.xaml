<UserControl x:Class="Lonnii.Client.Common.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A password field with an eye at its right edge: click to read what was typed, click
         again to hide it. Both fields stay in step, so Password is right either way.
         Drop-in for PasswordBox: Password, Clear(), SelectAll(), Focus() and PasswordChanged. -->
    <Grid>
        <PasswordBox x:Name="Hidden" Padding="8,6,34,6" PasswordChanged="Hidden_PasswordChanged" />
        <TextBox x:Name="Shown" Visibility="Collapsed" Padding="8,6,34,6"
                 VerticalContentAlignment="Center" TextChanged="Shown_TextChanged" />

        <ToggleButton x:Name="EyeButton" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Width="30" Margin="0,1,1,1" Focusable="False" Cursor="Hand"
                      Background="Transparent" BorderThickness="0"
                      ToolTip="Afficher le mot de passe" Click="Eye_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="3">
                        <TextBlock x:Name="Glyph" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Eye with a slash: the next click hides the password again. -->
                            <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
