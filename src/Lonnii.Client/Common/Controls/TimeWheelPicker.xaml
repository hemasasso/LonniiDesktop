<!--
  An optional time of day picked without typing.

  Hover the hours or the minutes and turn the mouse wheel to step them (wheel up = later);
  click either one to drop down a scrollable list; Up/Down do the same from the keyboard.
  The x clears the value, because a Programme day may have no hours at all (Repos).
-->
<UserControl x:Class="Lonnii.Client.Common.Controls.TimeWheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34">

    <UserControl.Resources>
        <Style x:Key="Segment" TargetType="Border">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLight}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- The default ListBoxItem paints a system-blue selection and ignores the palette,
             so it would be white-on-white in dark mode. -->
        <Style x:Key="WheelItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="12,5" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Frame" BorderThickness="1" Background="{DynamicResource Surface}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="HourSegment" Grid.Column="0" Style="{StaticResource Segment}"
                    ToolTip="Molette ou clic pour choisir l'heure"
                    MouseWheel="Segment_MouseWheel"
                    MouseLeftButtonUp="Segment_Click"
                    KeyDown="Segment_KeyDown">
                <TextBlock x:Name="HourText" Style="{StaticResource SegmentText}" />
            </Border>

            <TextBlock Grid.Column="1" Text=":" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />

            <Border x:Name="MinuteSegment" Grid.Column="2" Style="{StaticResource Segment}"
                    ToolTip="Molette ou clic pour choisir les minutes"
                    MouseWheel="Segment_MouseWheel"
                    MouseLeftButtonUp="Segment_Click"
                    KeyDown="Segment_KeyDown">
                <TextBlock x:Name="MinuteText" Style="{StaticResource SegmentText}" />
            </Border>

            <TextBlock Grid.Column="3" Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" />

            <Button x:Name="ClearButton" Grid.Column="4" Style="{StaticResource IconButton}"
                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" Padding="4"
                    ToolTip="Effacer l'heure" Focusable="False" Click="Clear_Click" />

            <Popup x:Name="WheelPopup" StaysOpen="False" AllowsTransparency="True"
                   Placement="Bottom" VerticalOffset="4" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="4" Padding="3">
                    <ListBox x:Name="WheelList" MaxHeight="220" MinWidth="60"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource WheelItem}"
                             PreviewMouseLeftButtonUp="WheelList_PreviewMouseLeftButtonUp"
                             KeyDown="WheelList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0:00}}" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
