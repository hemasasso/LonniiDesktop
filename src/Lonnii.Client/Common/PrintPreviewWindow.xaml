<Window x:Class="Lonnii.Client.Common.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu avant impression"
        Width="900" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Fermer" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            IsCancel="True" MinWidth="90" />
                    <Button Content="🖨 Imprimer…" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" MinWidth="120" Click="Print_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="PagesText" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DocumentViewer x:Name="Viewer" />
    </DockPanel>
</Window>
