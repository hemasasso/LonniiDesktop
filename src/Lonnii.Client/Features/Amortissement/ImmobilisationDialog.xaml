<Window x:Class="Lonnii.Client.Features.Amortissement.ImmobilisationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Immobilisation"
        Width="1000"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="560" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="SaveButton" Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          BorderBrush="{DynamicResource Border}">
                <StackPanel Margin="18,16">

                    <StackPanel x:Name="IdentityPanel">
                        <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NomBox" />

                        <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <ComboBox x:Name="CategorieCombo" />
                    </StackPanel>

                    <Grid x:Name="DatesGrid" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date d'acquisition *" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="AcquisitionPicker" />
                        </StackPanel>
                        <StackPanel x:Name="ServicePanel" Grid.Column="2">
                            <TextBlock Text="Mise en service" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="ServicePicker" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ValeurLabel" Text="Valeur d'acquisition *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ValeurBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valeur résiduelle" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ResiduelleBox" Text="0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Durée *" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DureeCombo" MaxDropDownHeight="260" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Méthode *" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="MethodeCombo" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="MethodeHint" Foreground="{DynamicResource TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <StackPanel x:Name="CoefficientPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Coefficient dégressif" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CoefficientCombo" />
                    </StackPanel>

                    <StackPanel x:Name="DetailsPanel">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="N° inventaire" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="InventaireBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Localisation" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LocalisationBox" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fournisseur" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FournisseurBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="N° facture" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FactureBox" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54" />

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Live schedule -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource SurfaceAlt}">
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="Tableau d'amortissement"
                               FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                    <WrapPanel x:Name="SummaryPanel" DockPanel.Dock="Top" Margin="0,0,0,6" />

                    <Grid>
                        <DataGrid x:Name="PreviewGrid">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentYear}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentLight}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Année" Width="60" Binding="{Binding Annee}" />
                                <DataGridTextColumn Header="N°" Width="40" Binding="{Binding NumeroAnnee}" />
                                <DataGridTextColumn Header="VNC début" Width="*" Binding="{Binding VncDebut}"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Dotation" Width="*" Binding="{Binding Dotation}"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Cumul" Width="*" Binding="{Binding Cumule}"
                                                    ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="VNC fin" Width="*" Binding="{Binding VncFin}"
                                                    ElementStyle="{StaticResource NumericCell}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="PreviewEmptyText" Visibility="Collapsed"
                                   Text="Renseignez la valeur, la durée et la méthode pour voir le tableau."
                                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
