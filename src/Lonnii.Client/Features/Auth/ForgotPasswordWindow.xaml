<Window x:Class="Lonnii.Client.Features.Auth.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lonnii.Client.Common.Controls"
        Title="Mot de passe oublié"
        Height="560" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Mot de passe oublié" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                           Text="Pour l'administrateur général de l'espace. Lonnii vous envoie un code par email." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="230" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="NextButton" Content="Envoyer le code" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Next_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">

            <!-- Step 1: who. -->
            <StackPanel x:Name="IdentifierPanel">
                <TextBlock Text="Email ou nom d'utilisateur *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="IdentifierBox" />

                <Border x:Name="ShopNote" Margin="0,16,0,0" Padding="12,10"
                        Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Text="Le code par email demande une connexion Internet. Les autres membres de l'espace demandent à leur administrateur de réinitialiser leur mot de passe." />
                </Border>

                <TextBlock x:Name="OfflineLink" Margin="0,14,0,0" FontSize="12">
                    <Hyperlink Click="Offline_Click">Pas d'Internet ? Obtenir un code auprès de Lonnii</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Step 2, by email: the six-digit code. -->
            <StackPanel x:Name="EmailCodePanel" Visibility="Collapsed">
                <TextBlock Text="Code reçu par email *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CodeBox" MaxLength="6" FontSize="18" />
            </StackPanel>

            <!-- Step 2, without the internet: read the tag out, type Lonnii's code. -->
            <StackPanel x:Name="OfflineCodePanel" Visibility="Collapsed">
                <TextBlock Text="Identifiant du compte, à communiquer à Lonnii" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TagBox" IsReadOnly="True" FontSize="16" FontFamily="Consolas" />
                    <Button x:Name="CopyButton" Grid.Column="1" Content="Copier" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="CopyTag_Click" />
                </Grid>

                <TextBlock Text="Code fourni par Lonnii *" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <TextBox x:Name="OfflineCodeBox" TextWrapping="Wrap" AcceptsReturn="False"
                         Height="64" FontFamily="Consolas" VerticalContentAlignment="Top" />
            </StackPanel>

            <!-- Step 2, either way: the new password. -->
            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                <TextBlock Text="Nouveau mot de passe *" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <controls:RevealPasswordBox x:Name="NewBox" PasswordChanged="Password_Changed" />

                <TextBlock Text="Confirmer le nouveau mot de passe *" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <controls:RevealPasswordBox x:Name="ConfirmBox" PasswordChanged="Password_Changed" />

                <TextBlock x:Name="PasswordHint" Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
