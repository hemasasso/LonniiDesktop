<Window x:Class="Lonnii.Client.Features.Auth.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Choisir un espace"
        Height="580" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Espaces de travail" Style="{StaticResource PageTitle}" FontSize="24" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                       Text="Choisissez l'espace dans lequel travailler. Double-cliquez pour l'ouvrir." />
        </StackPanel>

        <!--
            Cards rather than a table, matching how the web app presents workspaces, but
            sized as small tiles: a till operator picks one by sight, and a shop has a
            handful of spaces, not a list worth sorting.
        -->
        <ListBox x:Name="GroupList" Grid.Row="1"
                 MouseDoubleClick="List_DoubleClick"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Strips the default row highlight so selection reads as an accented card. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,16,16" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Width="180" Height="170"
                                        CornerRadius="12" Padding="0"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="10"
                                                          ShadowDepth="2" Direction="270" />
                                    </Border.Effect>
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource BorderStrong}" />
                                        <Setter TargetName="Card" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#000000" Opacity="0.16" BlurRadius="16"
                                                                  ShadowDepth="4" Direction="270" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <!-- After IsMouseOver, so selection wins while hovering. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource Accent}" />
                                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Card" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4361EE" Opacity="0.35" BlurRadius="18"
                                                                  ShadowDepth="3" Direction="270" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                            Cover: the espace photo when it has one, otherwise a blue gradient with
                            its initial. Two layers rather than one switching, so the rounded top
                            corners hold in both states (an image brush follows the corner radius;
                            an Image element would not).
                        -->
                        <Border Grid.Row="0" CornerRadius="11,11,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5675F8" Offset="0" />
                                    <GradientStop Color="#3347D1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Groupe.Nom, Converter={StaticResource Initial}}"
                                       Foreground="White" Opacity="0.95"
                                       FontSize="34" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="{DynamicResource SurfaceAlt}"
                                Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
                            <Border Margin="8" CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Photo}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- Created by the signed-in user. -->
                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,8,0" CornerRadius="10" Padding="7,2"
                                Background="#99000000"
                                ToolTip="Vous avez créé cet espace"
                                Visibility="{Binding Groupe.IsAdminGeneral, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#x1F451;" FontSize="13" Foreground="#FBBF24" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="14,8,14,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Groupe.Nom}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}"
                                       ToolTip="{Binding Groupe.Nom}" />
                            <TextBlock Margin="0,3,0,0" FontSize="12"
                                       Foreground="{DynamicResource Accent}" FontWeight="Medium"
                                       Text="{Binding Groupe.Role, Converter={StaticResource RoleLabel}}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,6,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}">
                                <Run Text="{Binding Groupe.MemberCount, Mode=OneWay}" />
                                <Run Text="membres" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="EmptyPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Aucun espace" FontWeight="SemiBold" FontSize="15"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextAlignment="Center"
                           Margin="0,6,0,0" MaxWidth="360" TextWrapping="Wrap"
                           Text="Vous n'appartenez à aucun espace. Si vous êtes le propriétaire, créez votre espace avec le bouton « Créer un espace… » ci-dessous. Sinon, demandez à un administrateur de vous ajouter au sien." />
            </StackPanel>
        </Border>

        <!-- Espaces registered with Lonnii and waiting for its approval before they can be built here. -->
        <Border x:Name="PendingPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="3" Padding="12,10">
            <StackPanel>
                <TextBlock Text="En attente d'approbation par Lonnii" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Ces espaces ont été enregistrés. Une fois approuvés, cliquez sur « Vérifier » pour les ouvrir sur ce poste." />
                <ItemsControl x:Name="PendingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Vérifier" Tag="{Binding GroupId}" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Click="CheckPending_Click" />
                                <Button Grid.Column="2" Content="Retirer" Tag="{Binding GroupId}" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="DismissPending_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="ErrorPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <!-- Left side: creating an espace, for the Admin Général only. Photo and deletion are in Paramètres. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="CreateButton" Content="Créer un espace…" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButton}" Click="Create_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OpenButton" Content="Ouvrir" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Open_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
