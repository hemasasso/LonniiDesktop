<Window x:Class="Lonnii.Client.Features.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lonnii.Client.Common.Controls"
        Title="Lonnii — Connexion"
        Height="620" Width="820" MinHeight="480" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel: the same blue in both themes. A soft gradient and a few translucent circles
             give it depth without adding anything to read. -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5675F8" Offset="0" />
                    <GradientStop Color="#4361EE" Offset="0.5" />
                    <GradientStop Color="#2F43C4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Ellipse Width="300" Height="300" Fill="White" Opacity="0.07"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-110,-110,0,0" />
                <Ellipse Width="380" Height="380" Fill="White" Opacity="0.06"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150" />
                <Ellipse Width="120" Height="120" Fill="White" Opacity="0.06"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,-40,0" />
                <Ellipse Width="70" Height="70" Fill="White" Opacity="0.05"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,90" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                    <!-- White-tile logo: it is the one that stands out on blue. -->
                    <Image Source="pack://application:,,,/Assets/icon-light.png" Width="96" Height="96"
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#1B2A8C" Opacity="0.35" BlurRadius="24" ShadowDepth="6" Direction="270" />
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="Lonnii" FontSize="38" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Business" FontSize="20" Foreground="#D6DDFB" Margin="0,-4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <Grid Grid.Column="1" Margin="40,36,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Connexion" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Identifiez-vous pour accéder à votre espace." />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,-12,0" Padding="0,0,12,0">
                <StackPanel>

                <!-- The host is found on its own, on the local network. The address field only
                     appears when nothing answers, or when the user asks to change it. -->
                <StackPanel x:Name="DiscoveryRow" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,10,0"
                             VerticalAlignment="Center" Fill="{DynamicResource Success}" />
                    <TextBlock x:Name="DiscoveryText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <!-- Shown when the search gives up: look again (the server may just have been
                     switched on), or enter a repair code from Lonnii. -->
                <StackPanel x:Name="NotFoundButtons" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button Content="Réessayer" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" Click="Retry_Click" />
                    <Button Content="Réparer la connexion…"
                            Style="{StaticResource SecondaryButton}" Click="Repair_Click" />
                </StackPanel>
                <TextBlock x:Name="HostHint" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />

                <TextBlock Text="Email ou nom d'utilisateur" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                <TextBox x:Name="IdentifierBox" />

                <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <!--
                  No KeyDown handler here: the "Se connecter" button is IsDefault, so Enter
                  already submits. Handling both fired the sign-in twice at once.
                -->
                <controls:RevealPasswordBox x:Name="PasswordBox" />

                <TextBlock x:Name="ForgotPasswordLink" Margin="0,10,0,0" FontSize="12">
                    <Hyperlink Click="ForgotPassword_Click">Mot de passe oublié ?</Hyperlink>
                </TextBlock>

                <!-- Shown only when the host has no account yet. -->
                <Border x:Name="SetupPanel" Visibility="Collapsed" Margin="0,16,0,0"
                        Background="{DynamicResource AccentLight}"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                        CornerRadius="3" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Ce serveur n'a encore aucun compte"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentDark}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                   Text="Vous avez déjà un compte Lonnii ? Installez ici vos espaces. Sinon, créez votre espace en vous inscrivant." />
                        <Button Content="J'ai déjà un compte…" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource PrimaryButton}" Click="ExistingAccount_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Créer mon espace…"
                                    Style="{StaticResource SecondaryButton}" Click="Register_Click" />
                            <!-- Kept for a host someone builds themselves, and for development. -->
                            <Button x:Name="ManualAccountButton" Content="Créer un compte manuellement…" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="CreateAccount_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,16,0,0"
                        Background="{DynamicResource DangerLight}"
                        BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8">
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                               TextWrapping="Wrap" FontSize="12" />
                </Border>

            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="BusyText" Text="Connexion…" Visibility="Collapsed"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondary}" />
                <Button Content="Quitter" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="SignInButton" Content="Se connecter" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="SignIn_Click" />
            </StackPanel>
        </Grid>

        <!-- Away from the shop: switches to the Lonnii online server (remote access). Deliberately
             unlabelled - only administrators are told what it does. Click again to come back. -->
        <Button x:Name="RemoteToggle" Grid.Column="1" Click="ToggleRemote_Click"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,6"
                Width="22" Height="22" Cursor="Hand" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" CornerRadius="11" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderStrong}" Background="Transparent">
                        <TextBlock Text="i" FontStyle="Italic" FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
