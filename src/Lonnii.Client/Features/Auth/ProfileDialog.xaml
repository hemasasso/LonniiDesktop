<Window x:Class="Lonnii.Client.Features.Auth.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mon profil"
        Width="480" SizeToContent="Height" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Mon profil" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="EmailText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="230" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="SaveButton" Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Prénom" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FirstNameBox" MaxLength="100" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LastNameBox" MaxLength="100" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Nom d'utilisateur" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="UsernameBox" MaxLength="30"
                     ToolTip="Pour vous connecter sans taper votre email" />

            <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="PhoneBox" MaxLength="20" />
        </StackPanel>

    </DockPanel>
</Window>
