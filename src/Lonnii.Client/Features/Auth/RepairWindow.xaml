<Window x:Class="Lonnii.Client.Features.Auth.RepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Réparer la connexion"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Réparer la connexion" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Ce poste ne trouve pas le serveur du magasin. Appelez Lonnii, donnez l'identifiant de ce poste et l'adresse du serveur, puis saisissez le code reçu." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Identifiant de ce poste" Style="{StaticResource FieldLabel}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TagBox" IsReadOnly="True" FontFamily="Consolas" />
                <Button x:Name="CopyButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="96" Content="Copier"
                        Style="{StaticResource SecondaryButton}" Click="CopyTag_Click" />
            </Grid>

            <TextBlock Text="Adresse du serveur" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="AddressBox" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Avec le port du serveur (5280 par défaut), par exemple 192.168.1.20:5280." />

            <TextBlock Text="Code de réparation" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="CodeBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto" />

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" MinWidth="110" />
            <Button Content="Valider" IsDefault="True" Click="Apply_Click" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
