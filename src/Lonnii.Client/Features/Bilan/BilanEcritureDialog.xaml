<Window x:Class="Lonnii.Client.Features.Bilan.BilanEcritureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Écriture"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Une écriture ajuste le solde d'un compte du bilan (capital apporté, emprunt, banque…)."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="240" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <TextBlock Text="Compte *" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CompteCombo" MaxDropDownHeight="320" />
            <TextBlock x:Name="CompteHint" Foreground="{DynamicResource TextMuted}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,5,0,0" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date *" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="DatePicker" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Libellé *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LibelleBox" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Débit" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="DebitBox" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Crédit" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CreditBox" Text="0" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="EffetText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />

            <TextBlock Text="Référence" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="ReferenceBox" />

            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54" />
        </StackPanel>

    </DockPanel>
</Window>
