<Window x:Class="Lonnii.Client.Features.Caisse.CaisseStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caisse ouverte"
        Width="520" MinWidth="460" MinHeight="260"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Margin="0,0,110,0">
                    <TextBlock Text="Caisse ouverte" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <!-- Its own row rather than sharing the footer with Annuler/Fermer la caisse -
                     three buttons there ran wider than this window and pushed whichever one
                     came first past the left edge, invisible without the window being resized. -->
                <Button x:Name="WithdrawButton" Content="💸 Retirer" Padding="10,5"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}" Click="Withdraw_Click" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fermer" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="CloseCaisseButton" Content="Fermer la caisse" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="CloseCaisse_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,16">

            <Border Padding="12,10" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Ventes de la session" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="VentesCountText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Chiffre d'affaires" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="ChiffreAffairesText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Encaissé" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="EncaisseText" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource Success}" />
                        <!-- Encaissé is what sales brought in; this is what the till holds after retraits. -->
                        <TextBlock x:Name="EnCaisseText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"
                                   ToolTip="Fonds initial + encaissé − retraits − avoirs remboursés" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Fonds initial" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="MontantInitialText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>

                    <!-- One payment method per line, in a column, so each amount reads on its own. -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Espèces" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="PaiementCashText" FontWeight="SemiBold" />
                        <TextBlock Text="Mobile Money" Style="{StaticResource PageSubtitle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="PaiementMobileText" FontWeight="SemiBold" />
                        <TextBlock Text="Banque/Carte" Style="{StaticResource PageSubtitle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="PaiementCarteText" FontWeight="SemiBold" />
                        <StackPanel x:Name="AutresPanel" Visibility="Collapsed">
                            <TextBlock Text="Autres" Style="{StaticResource PageSubtitle}" Margin="0,8,0,0" />
                            <TextBlock x:Name="PaiementAutresText" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Still owed by customers on this session's sales (paiements partiels, factures). -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                                ToolTip="Ce que les clients doivent encore sur les ventes de cette session (paiements partiels, factures non réglées)">
                        <TextBlock Text="Reste à payer (clients)" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="ResteText" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel x:Name="RetraitsPanel" Grid.Row="3" Grid.Column="0" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Retraits" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="RetraitsText" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}" />
                        <!-- One line per withdrawal, as on the phone: time, amount, pool and motif. -->
                        <TextBlock x:Name="RetraitsDetailText" Style="{StaticResource PageSubtitle}"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="AvoirsPanel" Grid.Row="2" Grid.Column="1"
                                Visibility="Collapsed"
                                ToolTip="Tous les avoirs clients créés pendant la session, remboursés ou non">
                        <TextBlock Text="Avoirs créés" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="AvoirsText" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Warning}" />
                        <!-- Same weight as the created figure, as on the phone: money that left the till. -->
                        <TextBlock Text="Avoirs remboursés" Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"
                                   ToolTip="Avoirs remboursés depuis cette caisse pendant la session (y compris ceux créés avant)" />
                        <TextBlock x:Name="AvoirsSoldesText" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Where the encaissé came from: this session's sales, and older factures settled now. -->
            <TextBlock x:Name="OrigineText" Margin="2,8,0,0" TextWrapping="Wrap"
                       Style="{StaticResource PageSubtitle}" Visibility="Collapsed" />

            <StackPanel x:Name="ClosePanel" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Espèces comptées" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MontantFinalBox" TextChanged="MontantFinal_Changed" />
                        <TextBlock x:Name="ExpectedCashText" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mobile money constaté" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MontantFinalMobileBox" TextChanged="MontantFinal_Changed"
                                 ToolTip="Solde du compte mobile money de la caisse au moment de la fermeture" />
                        <TextBlock x:Name="ExpectedMobileText" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Banque/Carte constatée (optionnel, 0 si vide)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MontantFinalCarteBox" TextChanged="MontantFinal_Changed"
                                 ToolTip="Solde du compte carte de la caisse au moment de la fermeture" />
                        <TextBlock x:Name="ExpectedCarteText" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ExpectedText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock Text="Notes de fermeture (optionnel)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="NotesBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" />
            </StackPanel>

            <TextBlock x:Name="NoCloseNotice" Margin="0,16,0,0" TextWrapping="Wrap"
                       Style="{StaticResource PageSubtitle}"
                       Text="Vous n'êtes pas autorisé à fermer cette caisse."
                       Visibility="Collapsed" />

        </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
