<Window x:Class="Lonnii.Client.Features.CustomerDisplay.CustomerDisplaySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Écran client"
        Width="640" Height="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Écran client" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                           Text="Montre au client les articles et le total à payer. Réglages propres à ce poste." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Appliquer et tester" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="Test_Click" />
                    <Button Content="Aperçu" Style="{StaticResource SecondaryButton}" Click="Preview_Click"
                            ToolTip="Ouvre l'écran client dans une fenêtre, sans second écran" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,10,14">
            <StackPanel Margin="0,0,8,0">

                <CheckBox x:Name="EnabledCheck" Content="Activer l'écran client" FontWeight="SemiBold"
                          Checked="Master_Changed" Unchecked="Master_Changed" />

                <StackPanel x:Name="Body" Margin="0,14,0,0">

                    <!-- Look -->
                    <TextBlock Text="APPARENCE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Modèle" VerticalAlignment="Top" Margin="0,6,0,8" />
                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="LayoutCombo" SelectionChanged="Layout_Changed" />
                                <TextBlock x:Name="LayoutDescription" Style="{StaticResource PageSubtitle}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Thème" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Text="Couleur" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                <Border x:Name="AccentSwatch" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6"
                                        Margin="0,0,8,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                                <TextBox x:Name="AccentBox" DockPanel.Dock="Right" Width="96" Padding="8,6" Margin="8,0,0,0"
                                         ToolTip="Couleur au format #RRGGBB" TextChanged="Accent_TextChanged" />
                                <ComboBox x:Name="AccentCombo" SelectionChanged="AccentPreset_Changed" />
                            </DockPanel>

                            <TextBlock Grid.Row="3" Text="Police" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <ComboBox x:Name="FontCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Text="Taille du texte" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <ComboBox x:Name="ScaleCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Text="Pastille articles" VerticalAlignment="Center" />
                            <ComboBox x:Name="PillCombo" Grid.Row="5" Grid.Column="1" />
                        </Grid>
                    </Border>

                    <!-- Welcome screen: shown while the basket is empty -->
                    <TextBlock Text="ÉCRAN D'ACCUEIL" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Modèle" VerticalAlignment="Top" Margin="0,6,0,8" />
                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="IdleLayoutCombo" SelectionChanged="IdleLayout_Changed" />
                                <TextBlock x:Name="IdleLayoutDescription" Style="{StaticResource PageSubtitle}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Afficher" VerticalAlignment="Top" Margin="0,2,0,8" />
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <CheckBox x:Name="IdleLogoCheck" Content="Logo" Margin="0,0,18,0" />
                                <CheckBox x:Name="IdleQrCheck" Content="QR code" Margin="0,0,18,0" />
                                <CheckBox x:Name="IdleCompanyCheck" Content="Nom de la boutique" />
                            </WrapPanel>

                            <TextBlock Grid.Row="6" Text="Position photo" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <RadioButton x:Name="MediaLeftRadio" GroupName="MediaSide" Content="À gauche" IsChecked="True"
                                             Margin="0,0,18,0" />
                                <RadioButton x:Name="MediaRightRadio" GroupName="MediaSide" Content="À droite" />
                                <TextBlock Text="(modèle Côte à côte)" Margin="12,0,0,0" Style="{StaticResource PageSubtitle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Titre" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <TextBox x:Name="IdleTitleBox" Grid.Row="2" Grid.Column="1" Padding="8,6" Margin="0,0,0,8"
                                     MaxLength="80" ToolTip="Laissez vide pour ne pas afficher de titre" />

                            <TextBlock Grid.Row="3" Text="Message" VerticalAlignment="Top" Margin="0,6,0,8" />
                            <TextBox x:Name="IdleMessageBox" Grid.Row="3" Grid.Column="1" Padding="8,6" Margin="0,0,0,8"
                                     MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                                     ToolTip="Horaires, promotion, slogan… (facultatif)" />

                            <TextBlock Grid.Row="4" Text="Photo / vidéo" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="4" Grid.Column="1">
                                <Button x:Name="RemoveMediaButton" DockPanel.Dock="Right" Content="Retirer" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="RemoveMedia_Click" />
                                <Button DockPanel.Dock="Right" Content="Choisir…" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="ChooseMedia_Click" />
                                <TextBlock x:Name="IdleMediaText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Text="Photo (JPG, PNG), GIF animé ou vidéo sans son (MP4, WMV). Utilisée par les modèles Plein écran, Côte à côte et Affiche." />
                        </Grid>
                    </Border>

                    <!-- Second monitor -->
                    <TextBlock Text="ÉCRAN SUPPLÉMENTAIRE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <CheckBox x:Name="ScreenCheck" Content="Afficher sur un second écran"
                                      ToolTip="Second écran du portable, petit panneau HDMI ou USB-C : Windows le voit comme un moniteur."
                                      Checked="Screen_Changed" Unchecked="Screen_Changed" />
                            <StackPanel x:Name="ScreenBody" Margin="22,10,0,0">
                                <CheckBox x:Name="AutoScreenCheck" Content="Détection automatique (premier écran qui n'est pas l'écran principal)"
                                          Checked="Screen_Changed" Unchecked="Screen_Changed" />
                                <ComboBox x:Name="ScreenCombo" Margin="0,8,0,0" />
                                <TextBlock x:Name="ScreenStatus" Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- USB / serial -->
                    <TextBlock Text="AFFICHEUR USB / SÉRIE" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <CheckBox x:Name="SerialCheck" Content="Afficheur à caractères (pole display, LCD sur Arduino / STM32)"
                                      Checked="Serial_Changed" Unchecked="Serial_Changed" />
                            <Grid x:Name="SerialBody" Margin="22,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <DockPanel Grid.Column="1" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Actualiser" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Click="RefreshPorts_Click" />
                                    <ComboBox x:Name="PortCombo" IsEditable="True" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="Vitesse" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <ComboBox x:Name="BaudCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <ComboBoxItem Content="2400" />
                                    <ComboBoxItem Content="4800" />
                                    <ComboBoxItem Content="9600" />
                                    <ComboBoxItem Content="19200" />
                                    <ComboBoxItem Content="38400" />
                                    <ComboBoxItem Content="57600" />
                                    <ComboBoxItem Content="115200" />
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="Protocole" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <ComboBox x:Name="SerialProtocolCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Text="Taille" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <ComboBox x:Name="SerialSizeCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

                                <TextBlock x:Name="SerialStatus" Grid.Row="4" Grid.ColumnSpan="2"
                                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Network -->
                    <TextBlock Text="AFFICHEUR RÉSEAU (WIFI)" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <CheckBox x:Name="NetworkCheck" Content="Afficheur sur le réseau (ESP32 en TCP)"
                                      Checked="Network_Changed" Unchecked="Network_Changed" />
                            <Grid x:Name="NetworkBody" Margin="22,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Adresse" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <TextBox x:Name="HostBox" Grid.Column="1" Padding="8,6" Margin="0,0,0,8"
                                         ToolTip="Adresse IP ou nom de l'ESP32, ex. 192.168.1.50" />

                                <TextBlock Grid.Row="1" Text="Port TCP" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <TextBox x:Name="NetPortBox" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Text="Protocole" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <ComboBox x:Name="NetProtocolCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Text="Taille" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <ComboBox x:Name="NetSizeCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

                                <TextBlock x:Name="NetworkStatus" Grid.Row="4" Grid.ColumnSpan="2"
                                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="Les afficheurs à caractères n'ont pas d'accents : les textes sont convertis en ASCII. Le format « Texte simple » est décrit dans docs/customer-display.md." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
