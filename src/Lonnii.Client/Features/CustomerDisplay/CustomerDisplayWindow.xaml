<Window x:Class="Lonnii.Client.Features.CustomerDisplay.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — écran client"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Cursor="None"
        Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- Laid out like a big-box retailer's checkout screen: a brand-coloured header bar, the basket
         as white rows (the line just scanned highlighted), and a summary card with a large total.
         Colours are theme brushes (Bg, Card, Ink, ...) filled in by ApplyStyle, so the shop can
         choose light, dark or the app's own theme, and its own brand colour.

         Everything sits on a design canvas that the Viewbox scales to any screen; code-behind
         keeps the canvas the same shape as the screen and moves the summary under the basket on
         a portrait one. Text colours are always set explicitly: the app-wide TextBlock style would
         otherwise win inside the item template. -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Canvas" Width="1280" Height="720">

            <!-- ===================== A sale is being rung up ===================== -->
            <Grid x:Name="SellingPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Brand}" Padding="40,18">
                    <DockPanel>
                        <Border x:Name="HeaderCountPill" DockPanel.Dock="Right" Background="{DynamicResource BrandOnSoft}"
                                CornerRadius="22" Padding="22,8" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderCount" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnBrand}" />
                        </Border>
                        <Border x:Name="HeaderLogoChip" DockPanel.Dock="Left" Background="White" CornerRadius="12"
                                Padding="8" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Image x:Name="HeaderLogo" Height="56" MaxWidth="150" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock x:Name="HeaderCompany" FontSize="38" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnBrand}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Grid x:Name="BodyGrid" Grid.Row="1" Margin="32">
                    <!-- The summary takes 40 % of the screen's width, the basket the other 60 %. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- The basket -->
                    <Border x:Name="ItemsCard" Background="{DynamicResource Card}" CornerRadius="16"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="28,18,28,10">
                                <TextBlock Text="ARTICLE" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="TOTAL" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                            </Grid>

                            <ScrollViewer x:Name="ItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="ItemsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="28,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFocus}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="22" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource Muted}" />
                                                    </StackPanel>
                                                    <!-- A discounted line shows its old price struck through, the new one under it. -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                                        <TextBlock Text="{Binding OldTotalText}" Visibility="{Binding OldTotalVisibility}"
                                                                   FontSize="24" TextAlignment="Right" TextDecorations="Strikethrough"
                                                                   Foreground="{DynamicResource Muted}" />
                                                        <TextBlock Text="{Binding TotalText}" FontSize="32" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Ink}" TextAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- The summary -->
                    <Border x:Name="SummaryCard" Grid.Column="1" Margin="28,0,0,0" Background="{DynamicResource Card}"
                            CornerRadius="16" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="30,26">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="RÉCAPITULATIF" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,0,14" />

                                <Grid x:Name="SubtotalRow" Margin="0,0,0,6">
                                    <TextBlock Text="Sous-total" FontSize="24" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="SubtotalText" FontSize="24" Foreground="{DynamicResource Ink}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="DiscountRow" Margin="0,0,0,6">
                                    <TextBlock Text="Remise" FontSize="24" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="DiscountText" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Good}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="TvaRow" Margin="0,0,0,6">
                                    <TextBlock Text="TVA" FontSize="24" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="TvaText" FontSize="24" Foreground="{DynamicResource Ink}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,16" />

                                <TextBlock Text="TOTAL À PAYER" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock x:Name="TotalText" FontSize="68" FontWeight="Bold"
                                               Foreground="{DynamicResource BrandText}" />
                                </Viewbox>
                            </StackPanel>

                            <StackPanel x:Name="RecuBox" DockPanel.Dock="Bottom" Margin="0,18,0,0">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Reçu" FontSize="24" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="RecuText" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border x:Name="DifferenceCard" CornerRadius="12" Padding="22,14">
                                    <StackPanel>
                                        <TextBlock x:Name="DifferenceLabel" FontSize="22" FontWeight="SemiBold" />
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                            <TextBlock x:Name="DifferenceText" FontSize="50" FontWeight="Bold" />
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== Nothing in the cart ===================== -->
            <Grid x:Name="IdlePanel" Visibility="Collapsed" Background="{DynamicResource BrandDeep}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="IdleLogoChip" Background="White" CornerRadius="22" Padding="22"
                            HorizontalAlignment="Center" Margin="0,0,0,30">
                        <Image x:Name="IdleLogo" MaxHeight="150" MaxWidth="420" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="IdleCompany" FontSize="68" FontWeight="Bold" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource OnBrand}" />
                    <TextBlock Text="Bienvenue" FontSize="42" TextAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource OnBrandSoft}" />
                    <StackPanel x:Name="IdleQrBox" Margin="0,38,0,0" HorizontalAlignment="Center">
                        <Border x:Name="IdleQrCard" Background="White" CornerRadius="14" Padding="12" HorizontalAlignment="Center">
                            <Image x:Name="IdleQr" Height="170" Width="170" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock x:Name="IdleQrNote" FontSize="22" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="560" Margin="0,12,0,0" Foreground="{DynamicResource OnBrandSoft}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===================== The sale was just recorded ===================== -->
            <Grid x:Name="ThanksPanel" Visibility="Collapsed" Background="{DynamicResource Bg}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="150" Height="150" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource Good}" />
                        <TextBlock Text="✓" FontSize="96" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0" />
                    </Grid>
                    <TextBlock Text="Merci !" FontSize="100" FontWeight="Bold" TextAlignment="Center" Margin="0,22,0,0"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="ThanksTotal" FontSize="44" TextAlignment="Center" Margin="0,10,0,0"
                               Foreground="{DynamicResource Muted}" />
                    <Border x:Name="ThanksChangeCard" Background="{DynamicResource GoodSoft}" CornerRadius="16"
                            Padding="40,14" Margin="0,24,0,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="ThanksChange" FontSize="54" FontWeight="Bold" Foreground="{DynamicResource Good}"
                                   TextAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ThanksNote" FontSize="32" TextAlignment="Center" Margin="0,26,0,0"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </Grid>

        </Grid>
    </Viewbox>
</Window>
