<Window x:Class="Lonnii.Client.Features.Licensing.LicenceLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Licence expirée"
        Height="360" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Licence expirée" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="MessageText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed"
                VerticalAlignment="Top"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Quitter" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Quit_Click" />
            <Button x:Name="RetryButton" Content="Réessayer" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Retry_Click" />
        </StackPanel>
    </Grid>
</Window>
