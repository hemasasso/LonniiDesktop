<UserControl x:Class="Lonnii.Client.Features.Marges.MargesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Surface}">

    <UserControl.InputBindings>
        <KeyBinding Command="ApplicationCommands.Print" Key="P" Modifiers="Control" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Card that holds one chart or table section. -->
        <Style x:Key="MargeCard" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="EmptyChartText" TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
            <Setter Property="Text" Value="Aucune donnée disponible." />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- Margin-rate badge, same thresholds as Lonnii Business (>= 30 high, >= 15 medium).
             Outlined rather than filled so it reads in both themes. -->
        <DataTemplate x:Key="MarginBadgeTemplate">
            <Border x:Name="Badge" HorizontalAlignment="Right" Padding="8,1" CornerRadius="9"
                    BorderThickness="1" BorderBrush="{DynamicResource Danger}">
                <TextBlock x:Name="BadgeText" Text="{Binding MarginDisplay}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Danger}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MarginLevel}" Value="high">
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Success}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MarginLevel}" Value="medium">
                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Warning}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Profit cell: red when the line loses money. -->
        <Style x:Key="ProfitCell" TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CostSourceCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEstimated}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Analyse des Marges" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" ToolTip="Imprimer (Ctrl+P)"
                            Style="{StaticResource SecondaryButton}" Click="Print_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets"
                                       Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                            <TextBlock Text="Imprimer" Style="{StaticResource ButtonContentText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                       Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                            <TextBlock Text="Exporter" Style="{StaticResource ButtonContentText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Module tabs -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OverviewTabButton" Tag="overview" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Vue d'ensemble" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="ProductsTabButton" Tag="products" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Produits" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="CategoriesTabButton" Tag="categories"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Catégories" Style="{StaticResource ButtonContentText}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Filters, shared by every tab -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DateFilterCombo" Width="180" Margin="0,0,8,0"
                              SelectionChanged="DateFilter_Changed">
                        <ComboBoxItem Content="Aujourd'hui" Tag="today" />
                        <ComboBoxItem Content="7 derniers jours" Tag="week" />
                        <ComboBoxItem Content="Ce mois" Tag="month" IsSelected="True" />
                        <ComboBoxItem Content="Mois dernier" Tag="lastmonth" />
                        <ComboBoxItem Content="Ce trimestre" Tag="quarter" />
                        <ComboBoxItem Content="Cette année" Tag="year" />
                        <ComboBoxItem Content="Toutes les périodes" Tag="all" />
                        <ComboBoxItem Content="Période personnalisée…" Tag="custom" />
                    </ComboBox>
                    <ComboBox x:Name="CategoryFilterCombo" Width="200" Margin="0,0,12,0"
                              DisplayMemberPath="Nom" SelectionChanged="CategoryFilter_Changed" />
                    <TextBlock x:Name="PeriodText" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- The estimated-cost notice, folded: shown only while the notice applies
                         and the user has closed it. -->
                    <Button x:Name="EstimateNoticeIcon" Visibility="Collapsed" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Padding="10,7"
                            BorderBrush="{DynamicResource Warning}"
                            Click="ExpandEstimateNotice_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EstimateNoticeIconText" Margin="6,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource Warning}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                            <TextBlock Text="Actualiser" Style="{StaticResource ButtonContentText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- Estimated-cost notice: the margin is only as good as the purchase prices behind it -->
        <Border x:Name="EstimateNotice" DockPanel.Dock="Top" Visibility="Collapsed" Padding="14,8"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Warning}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Margin="6,0,0,0" VerticalAlignment="Center"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Foreground="{DynamicResource TextPrimary}"
                        ToolTip="Réduire (un ⚠ reste à droite de la barre de filtres pour le rouvrir)"
                        Click="CollapseEstimateNotice_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="11"
                        VerticalAlignment="Center"
                        Content="Voir les produits" Click="ShowEstimated_Click" />
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0"
                           Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                <TextBlock x:Name="EstimateNoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>

            <!-- Vue d'ensemble -->
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <WrapPanel x:Name="MainTilesPanel" Orientation="Horizontal" />
                    <WrapPanel x:Name="RatioTilesPanel" Orientation="Horizontal" Margin="0,0,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,5,10" Style="{StaticResource MargeCard}">
                            <StackPanel>
                                <TextBlock x:Name="WaterfallTitle" Style="{StaticResource CardTitle}" />
                                <!-- Drawn in plain WPF rather than LiveCharts: every label and
                                     amount is real text, sharp at any display scale, and each bar
                                     floats from where the previous step left off. -->
                                <Grid Height="270">
                                    <Grid x:Name="WaterfallHost" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WaterfallEmptyText" Style="{StaticResource EmptyChartText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="5,0,0,10" Style="{StaticResource MargeCard}">
                            <StackPanel>
                                <TextBlock Text="Répartition de la Marge Brute par Catégorie" Style="{StaticResource CardTitle}" />
                                <Grid Height="270">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <lvc:PieChart x:Name="CategoryPieChart" Background="Transparent" />
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                                        <StackPanel x:Name="CategoryLegendPanel" Margin="8,0,0,0" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="CategoryEmptyText" Grid.ColumnSpan="2" Style="{StaticResource EmptyChartText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,0,0,10" Style="{StaticResource MargeCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel x:Name="MonthlyLegendPanel" DockPanel.Dock="Right" Orientation="Horizontal" />
                                <TextBlock x:Name="MonthlyTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Height="280">
                                <lvc:CartesianChart x:Name="MonthlyChart" Background="Transparent" />
                                <TextBlock x:Name="MonthlyEmptyText" Style="{StaticResource EmptyChartText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,5,10" Style="{StaticResource MargeCard}">
                            <StackPanel>
                                <TextBlock x:Name="TopProductsTitle" Style="{StaticResource CardTitle}" />
                                <Grid Height="276">
                                    <!-- ExactMatch: the tooltip shows only the bar under the cursor.
                                         Each bar is its own series (see MargesView.Bar), and the default
                                         strategy listed all of them - NaN placeholders included - which
                                         overflowed the top of the chart. -->
                                    <lvc:CartesianChart x:Name="TopProductsChart" Background="Transparent"
                                                        FindingStrategy="ExactMatch" TooltipPosition="Auto" />
                                    <TextBlock x:Name="TopProductsEmptyText" Style="{StaticResource EmptyChartText}" />
                                </Grid>
                                <WrapPanel x:Name="TopProductsLegendPanel" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="5,0,0,10" Style="{StaticResource MargeCard}">
                            <StackPanel>
                                <TextBlock Text="Répartition des Produits par Taux de Marge" Style="{StaticResource CardTitle}" />
                                <Grid Height="300">
                                    <lvc:CartesianChart x:Name="DistributionChart" Background="Transparent"
                                                        FindingStrategy="ExactMatch" TooltipPosition="Auto" />
                                    <TextBlock x:Name="DistributionEmptyText" Style="{StaticResource EmptyChartText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource MargeCard}">
                        <StackPanel>
                            <TextBlock Text="Points d'attention" Style="{StaticResource CardTitle}" />
                            <StackPanel x:Name="AlertsPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Produits -->
            <DockPanel x:Name="ProductsPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="240" Margin="0,0,8,0">
                                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" />
                                <TextBlock x:Name="SearchPlaceholder" Text="🔍 Rechercher un produit…"
                                           Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ComboBox x:Name="ProductFilterCombo" Width="230" SelectionChanged="ProductFilter_Changed">
                                <ComboBoxItem Content="Tous les produits" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="10 plus rentables" Tag="top" />
                                <ComboBoxItem Content="10 moins rentables" Tag="least" />
                                <ComboBoxItem Content="Faible marge (moins de 10 %)" Tag="low" />
                                <ComboBoxItem Content="Marge négative (à perte)" Tag="negative" />
                                <ComboBoxItem Content="Coût estimé (prix d'achat manquant)" Tag="estimated" />
                                <ComboBoxItem Content="Sans coût (services)" Tag="nocost" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="ProductCountText" Grid.Column="1" Style="{StaticResource PageSubtitle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="14,8" Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="ProductTotalsText" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <Grid>
                    <DataGrid x:Name="ProductsGrid" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produit" Width="2*" MinWidth="160" Binding="{Binding Nom}" />
                            <DataGridTextColumn Header="Catégorie" Width="*" MinWidth="110" Binding="{Binding Categorie}" />
                            <DataGridTextColumn Header="Qté vendue" Width="90" Binding="{Binding QuantiteDisplay}"
                                                SortMemberPath="Quantite" ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="Chiffre d'affaires" Width="140" Binding="{Binding RevenueDisplay}"
                                                SortMemberPath="Revenue" ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="Coût" Width="130" Binding="{Binding CostDisplay}"
                                                SortMemberPath="Cost" ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="Marge" Width="140" Binding="{Binding ProfitDisplay}"
                                                SortMemberPath="Profit" ElementStyle="{StaticResource ProfitCell}" />
                            <DataGridTemplateColumn Header="Taux" Width="90" SortMemberPath="Margin"
                                                    CellTemplate="{StaticResource MarginBadgeTemplate}" />
                            <DataGridTextColumn Header="Part de la marge" Width="115" Binding="{Binding ShareDisplay}"
                                                SortMemberPath="Share" ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="Coût basé sur" Width="115" Binding="{Binding CostSourceDisplay}"
                                                SortMemberPath="CostSourceDisplay" ElementStyle="{StaticResource CostSourceCell}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="ProductsEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <TextBlock Text="Aucun produit ne correspond à ces critères." Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Catégories -->
            <ScrollViewer x:Name="CategoriesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Border Margin="0,0,0,10" Style="{StaticResource MargeCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel x:Name="CategoryChartLegendPanel" DockPanel.Dock="Right" Orientation="Horizontal" />
                                <TextBlock x:Name="CategoryChartTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Height="280">
                                <lvc:CartesianChart x:Name="CategoryChart" Background="Transparent" />
                                <TextBlock x:Name="CategoryChartEmptyText" Style="{StaticResource EmptyChartText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MargeCard}" Padding="0">
                        <DataGrid x:Name="CategoriesGrid" CanUserSortColumns="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Catégorie" Width="*" MinWidth="150" Binding="{Binding Categorie}" />
                                <DataGridTextColumn Header="Qté vendue" Width="90" Binding="{Binding QuantiteDisplay}"
                                                    SortMemberPath="Quantite" ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Chiffre d'affaires" Width="140" Binding="{Binding RevenueDisplay}"
                                                    SortMemberPath="Revenue" ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Coût" Width="130" Binding="{Binding CostDisplay}"
                                                    SortMemberPath="Cost" ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Marge" Width="140" Binding="{Binding ProfitDisplay}"
                                                    SortMemberPath="Profit" ElementStyle="{StaticResource ProfitCell}" />
                                <DataGridTemplateColumn Header="Taux" Width="90" SortMemberPath="Margin"
                                                        CellTemplate="{StaticResource MarginBadgeTemplate}" />
                                <DataGridTextColumn Header="Part du CA" Width="100" Binding="{Binding RevenueShareDisplay}"
                                                    SortMemberPath="RevenueShare" ElementStyle="{StaticResource NumericCell}" />
                                <DataGridTextColumn Header="Part de la marge" Width="115" Binding="{Binding ShareDisplay}"
                                                    SortMemberPath="Share" ElementStyle="{StaticResource NumericCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

    </DockPanel>
</UserControl>
