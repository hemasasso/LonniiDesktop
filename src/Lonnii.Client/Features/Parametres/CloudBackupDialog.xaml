<Window x:Class="Lonnii.Client.Features.Parametres.CloudBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegarde en ligne" Height="380" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SAUVEGARDE EN LIGNE" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="BusyText" Style="{StaticResource PageSubtitle}" Margin="0,10,0,0"
                       Visibility="Collapsed" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Une sauvegarde est envoyée automatiquement toutes les 15 minutes. « Restaurer » recharge la copie en ligne dans cet espace, uniquement s'il est encore vide ; « Repartir de zéro » met la copie existante de côté et en commence une nouvelle." />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RestartButton" Content="Repartir de zéro" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" Click="Restart_Click" />
            <Button x:Name="RestoreButton" Content="Restaurer" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" Click="Restore_Click" />
            <Button x:Name="RunButton" Content="Sauvegarder maintenant" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}" Click="Run_Click" />
            <Button Content="Fermer" IsCancel="True" Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </Grid>
</Window>
