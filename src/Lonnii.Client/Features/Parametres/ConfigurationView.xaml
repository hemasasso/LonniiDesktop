<UserControl x:Class="Lonnii.Client.Features.Parametres.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Configuration &amp; Serveurs" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Connexion aux serveurs, devise, reçus et factures, écran client, bilan automatique, consommation et données de l'espace." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
            <StackPanel>

                <!-- Connexion: every server this espace depends on, filled from /api/parametres/connexion.
                     The central server is named, never addressed. -->
                <StackPanel x:Name="ConnexionPanel" Visibility="Collapsed">
                <TextBlock Text="CONNEXION AUX SERVEURS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="16,12">
                    <StackPanel>
                        <StackPanel x:Name="ConnexionList" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Actualiser" Padding="10,3" FontSize="11"
                                    Style="{StaticResource SecondaryButton}" Click="RefreshConnexion_Click" />
                            <TextBlock x:Name="MachineText" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Devise -->
                <StackPanel x:Name="CurrencyPanel" Visibility="Collapsed">
                    <TextBlock Text="DEVISE" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Libellé de la devise"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="200" />
                                <TextBox x:Name="CurrencyBox" Width="120" MaxLength="12"
                                         TextChanged="CurrencyInput_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Position"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="200" />
                                <RadioButton x:Name="CurrencyAfterRadio" GroupName="CurrencyPosition"
                                             Content="Après le montant (1 000 F CFA)" IsChecked="True"
                                             VerticalAlignment="Center" Checked="CurrencyInput_Changed" />
                                <RadioButton x:Name="CurrencyBeforeRadio" GroupName="CurrencyPosition"
                                             Content="Avant le montant ($1 000)" Margin="18,0,0,0"
                                             VerticalAlignment="Center" Checked="CurrencyInput_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Aperçu"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="200" />
                                <TextBlock x:Name="CurrencyPreviewText" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="120" />
                                <Button Content="Enregistrer" Margin="10,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="SaveCurrency_Click" />
                                <TextBlock x:Name="CurrencyStatusText" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Reçus et factures: printed on customer-facing documents. -->
                <StackPanel x:Name="VentesSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="REÇUS ET FACTURES" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Configurer" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenReceiptSettings_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Paramètre Reçu et Facture" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="Logo, QR Code, nom de l'entreprise, titre facture, notes." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Écran client: drives hardware plugged into this till. -->
                <StackPanel x:Name="CustomerDisplaySettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="ÉCRAN CLIENT" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Configurer" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenCustomerDisplay_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Affichage pour le client" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                           Text="Second écran, afficheur USB ou LCD réseau : articles et montant à payer." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="BilanSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="BILAN ET COMPTE DE RÉSULTAT" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <CheckBox x:Name="CalculAutomatiqueCheck" Content="Calcul automatique"
                                      Checked="CalculAutomatique_Changed" Unchecked="CalculAutomatique_Changed" />
                            <TextBlock Style="{StaticResource PageSubtitle}" Margin="20,4,0,0" TextWrapping="Wrap"
                                       Text="Activé (par défaut) : ventes, charges et amortissement alimentent les statuts automatiquement - seuls les produits et charges financiers/exceptionnels se saisissent en écriture. Désactivé : chaque compte se saisit en écriture, pour une entreprise qui tient ses comptes elle-même." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Consommation données -->
                <StackPanel x:Name="ConsumptionPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,20,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="ConsumptionYearCombo" Width="120"
                                      SelectionChanged="ConsumptionYear_Changed" />
                        </StackPanel>
                        <!-- Collapsed until the header is clicked: the figures are rarely wanted. -->
                        <TextBlock x:Name="ConsumptionHeader" Text="▸  CONSOMMATION DONNÉES"
                                   Style="{StaticResource SectionHeader}" VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonUp="ConsumptionHeader_Click" />
                    </DockPanel>
                    <Border x:Name="ConsumptionBody" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="Enregistrements" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionRecordsText" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Volume estimé" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionVolumeText" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Sections utilisées" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionSectionsText" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Images produits" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionFilesText" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </UniformGrid>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Margin="0,12,0,0">
                                <DataGrid x:Name="ConsumptionGrid" MaxHeight="340" BorderThickness="0"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding Section}" Width="120" />
                                        <DataGridTextColumn Header="Données" Binding="{Binding Label}" Width="*" />
                                        <DataGridTextColumn Header="Enregistrements" Binding="{Binding CountDisplay}" Width="120" />
                                        <DataGridTextColumn Header="Volume estimé" Binding="{Binding BytesDisplay}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock x:Name="ConsumptionNoteText" Style="{StaticResource PageSubtitle}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Volume estimé à partir d'une taille moyenne par enregistrement (500 Ko par image produit), comme sur Lonnii Business : ce n'est pas la taille réelle de la base." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Espace data: download as one .db file, or load one into an empty espace.
                     The dialog itself hides the import half from anyone but the Admin Général,
                     as the API does; the online restore is the Admin Général's alone too. -->
                <StackPanel x:Name="EspaceDataPanel" Visibility="Collapsed">
                    <TextBlock Text="DONNÉES DE L'ESPACE" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ouvrir" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenEspaceTransfer_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Télécharger ou importer (.db)" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                           Text="Tout le contenu de l'espace dans un seul fichier, images comprises — à recharger dans un nouvel espace vide." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ouvrir" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenCloudBackup_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sauvegarde en ligne" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                           Text="Copie automatique des données et des photos sur le serveur Lonnii (mode en ligne), à restaurer si l'ordinateur est perdu." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>


            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
