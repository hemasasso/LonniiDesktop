<UserControl x:Class="Lonnii.Client.Features.Parametres.ParametresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Configuration de l'espace et des accès." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
            <StackPanel>

                <!-- Workspace -->
                <TextBlock Text="ESPACE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom de l'espace"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="GroupNameText" Grid.Row="0" Grid.Column="1"
                                   FontWeight="SemiBold" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Votre rôle"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="RoleText" Grid.Row="1" Grid.Column="1" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Membres"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="MemberCountText" Grid.Row="2" Grid.Column="1" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Module Gestion"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="GestionAccessText" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                    </Grid>
                </Border>

                <!-- Members & privileges (admin only). Opens the full screen in its own
                     resizable window (MembresDialog) rather than embedding it here - see that
                     class's doc comment for why. -->
                <StackPanel x:Name="MembersPanel" Visibility="Collapsed">
                    <TextBlock Text="MEMBRES ET PRIVILÈGES" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Gérer" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenMembers_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Membres, rôles et privilèges" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="Ajoutez des membres, changez leur rôle et accordez des privilèges individuels (Comptable, Financier, Caissier…)." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Espace photo (admin only): what the group picker shows for this espace. -->
                <StackPanel x:Name="PhotoPanel" Visibility="Collapsed">
                    <TextBlock Text="PHOTO DE L'ESPACE" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                                    Background="{DynamicResource Accent}" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="PhotoInitial" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="White"
                                               FontSize="26" FontWeight="SemiBold" />
                                    <Image x:Name="PhotoImage" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Affichée dans la liste des espaces, à la connexion."
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Choisir une photo…"
                                            Style="{StaticResource SecondaryButton}" Click="ChoosePhoto_Click" />
                                    <Button x:Name="RemovePhotoButton" Content="Supprimer la photo" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                            Click="RemovePhoto_Click" />
                                    <TextBlock x:Name="PhotoStatusText" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Moyens de paiement: Mobile Money, cartes, Google Pay, Apple Pay. Built but hidden until
                     a provider is wired - see PaymentProviderRegistry.SettingsVisible. -->
                <StackPanel x:Name="PaymentSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="MOYENS DE PAIEMENT" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Configurer" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenPaymentProviders_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Paiements non espèces" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                                           Text="Mobile Money, cartes Visa / Mastercard, Google Pay, Apple Pay." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Delete the espace (Admin Général only: the API refuses anyone else). -->
                <StackPanel x:Name="DeleteEspacePanel" Visibility="Collapsed">
                    <TextBlock Text="SUPPRIMER L'ESPACE" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Danger}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       Text="Supprime définitivement cet espace et toutes ses données : produits, ventes, membres, paramètres. Cette action est irréversible." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="🗑 Supprimer cet espace…" Style="{StaticResource DangerButton}"
                                        Click="DeleteEspace_Click" />
                                <TextBlock x:Name="DeleteEspaceStatusText" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Danger}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Privilege summary: pointless for the Admin Général, who already has
                     everything, so this whole block is hidden for them in code-behind. -->
                <StackPanel x:Name="PrivilegeSection">
                    <TextBlock Text="VOS PRIVILÈGES" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <TextBlock x:Name="PrivilegeSummary" Style="{StaticResource PageSubtitle}"
                               Margin="12,0,0,8" TextWrapping="Wrap" />
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                        <DataGrid x:Name="PrivilegeGrid" MaxHeight="320" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="150" />
                                <DataGridTextColumn Header="Privilège" Binding="{Binding DisplayName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
