<UserControl x:Class="Lonnii.Client.Features.Parametres.ParametresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Configuration de l'espace et des accès." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
            <StackPanel>

                <!-- Workspace -->
                <TextBlock Text="ESPACE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom de l'espace"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="GroupNameText" Grid.Row="0" Grid.Column="1"
                                   FontWeight="SemiBold" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Votre rôle"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="RoleText" Grid.Row="1" Grid.Column="1" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Membres"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="MemberCountText" Grid.Row="2" Grid.Column="1" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Module Gestion"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="GestionAccessText" Grid.Row="3" Grid.Column="1" Margin="0,3" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Module Prestations"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="PrestationsText" Grid.Row="4" Grid.Column="1" Margin="0,3" />
                    </Grid>
                </Border>

                <!-- Members & privileges (admin only). Opens the full screen in its own
                     resizable window (MembresDialog) rather than embedding it here - see that
                     class's doc comment for why. -->
                <StackPanel x:Name="MembersPanel" Visibility="Collapsed">
                    <TextBlock Text="MEMBRES ET PRIVILÈGES" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Gérer" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenMembers_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Membres, rôles et privilèges" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="Ajoutez des membres, changez leur rôle et accordez des privilèges individuels (Comptable, Financier, Caissier…)." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Currency (admin only) -->
                <StackPanel x:Name="CurrencyPanel" Visibility="Collapsed">
                    <TextBlock Text="DEVISE" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Libellé de la devise"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="200" />
                                <TextBox x:Name="CurrencyBox" Width="120" MaxLength="12"
                                         TextChanged="CurrencyInput_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Position"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="200" />
                                <RadioButton x:Name="CurrencyAfterRadio" GroupName="CurrencyPosition"
                                             Content="Après le montant (1 000 F CFA)" IsChecked="True"
                                             VerticalAlignment="Center" Checked="CurrencyInput_Changed" />
                                <RadioButton x:Name="CurrencyBeforeRadio" GroupName="CurrencyPosition"
                                             Content="Avant le montant ($1 000)" Margin="18,0,0,0"
                                             VerticalAlignment="Center" Checked="CurrencyInput_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Aperçu"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                           Width="200" />
                                <TextBlock x:Name="CurrencyPreviewText" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="120" />
                                <Button Content="Enregistrer" Margin="10,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Click="SaveCurrency_Click" />
                                <TextBlock x:Name="CurrencyStatusText" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ventes (admin only, same as the currency above: what these settings
                     change is printed on customer-facing documents). -->
                <StackPanel x:Name="VentesSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="VENTES" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Configurer" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="OpenReceiptSettings_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Paramètre Reçu et Facture" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="Logo, QR Code, nom de l'entreprise, titre facture, notes." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="BilanSettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="BILAN ET COMPTE DE RÉSULTAT" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <CheckBox x:Name="CalculAutomatiqueCheck" Content="Calcul automatique"
                                      Checked="CalculAutomatique_Changed" Unchecked="CalculAutomatique_Changed" />
                            <TextBlock Style="{StaticResource PageSubtitle}" Margin="20,4,0,0" TextWrapping="Wrap"
                                       Text="Activé (par défaut) : ventes, charges et amortissement alimentent les statuts automatiquement - seuls les produits et charges financiers/exceptionnels se saisissent en écriture. Désactivé : chaque compte se saisit en écriture, pour une entreprise qui tient ses comptes elle-même." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Data consumption (admin only, as the API requires) -->
                <StackPanel x:Name="ConsumptionPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,20,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="ConsumptionYearCombo" Width="120"
                                      SelectionChanged="ConsumptionYear_Changed" />
                        </StackPanel>
                        <TextBlock Text="CONSOMMATION DONNÉES" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <StackPanel>
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="Enregistrements" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionRecordsText" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Volume estimé" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionVolumeText" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Sections utilisées" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionSectionsText" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Images produits" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    <TextBlock x:Name="ConsumptionFilesText" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </UniformGrid>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Margin="0,12,0,0">
                                <DataGrid x:Name="ConsumptionGrid" MaxHeight="340" BorderThickness="0"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding Section}" Width="120" />
                                        <DataGridTextColumn Header="Données" Binding="{Binding Label}" Width="*" />
                                        <DataGridTextColumn Header="Enregistrements" Binding="{Binding CountDisplay}" Width="120" />
                                        <DataGridTextColumn Header="Volume estimé" Binding="{Binding BytesDisplay}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <TextBlock x:Name="ConsumptionNoteText" Style="{StaticResource PageSubtitle}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Volume estimé à partir d'une taille moyenne par enregistrement (500 Ko par image produit), comme sur Lonnii Business : ce n'est pas la taille réelle de la base." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Connection -->
                <TextBlock Text="CONNEXION" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Serveur"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="HostText" Grid.Row="0" Grid.Column="1" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Poste"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3" />
                        <TextBlock x:Name="MachineText" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    </Grid>
                </Border>

                <!-- Privilege summary: pointless for the Admin Général, who already has
                     everything, so this whole block is hidden for them in code-behind. -->
                <StackPanel x:Name="PrivilegeSection">
                    <TextBlock Text="VOS PRIVILÈGES" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
                    <TextBlock x:Name="PrivilegeSummary" Style="{StaticResource PageSubtitle}"
                               Margin="12,0,0,8" TextWrapping="Wrap" />
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                        <DataGrid x:Name="PrivilegeGrid" MaxHeight="320" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="150" />
                                <DataGridTextColumn Header="Privilège" Binding="{Binding DisplayName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
