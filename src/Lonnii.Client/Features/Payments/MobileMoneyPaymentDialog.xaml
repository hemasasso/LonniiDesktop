<Window x:Class="Lonnii.Client.Features.Payments.MobileMoneyPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paiement Mobile Money"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <StackPanel Margin="28,24,28,28">

        <!-- Header -->
        <TextBlock Text="Paiement Mobile Money" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock x:Name="AmountLabel" FontSize="34" FontWeight="Bold" Margin="0,0,0,18" />

        <!-- Account selector (hidden when only one account) -->
        <StackPanel x:Name="AccountPanel" Visibility="Collapsed" Margin="0,0,0,14">
            <TextBlock Text="Compte à utiliser" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="AccountCombo" Margin="0,4,0,0" Padding="8,6" />
        </StackPanel>

        <!-- Phone number -->
        <TextBlock Text="Numéro du client" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="PhoneBox" Margin="0,4,0,14" Padding="8,6"
                 InputMethod.IsInputMethodEnabled="False"
                 ToolTip="Ex. 70 00 00 00 · le préfixe 226 est ajouté automatiquement." />

        <!-- OTP (hidden for Moov, operator_id=12) -->
        <StackPanel x:Name="OtpPanel" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource FieldLabel}">
                Code OTP <Run x:Name="OtpHintRun" Foreground="{DynamicResource TextMuted}" FontSize="11" />
            </TextBlock>
            <PasswordBox x:Name="OtpBox" Margin="0,4,0,0" Padding="8,6" />
            <TextBlock x:Name="OtpInstruction" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Error / status -->
        <Border x:Name="ErrorBorder" Visibility="Collapsed" Background="{DynamicResource ErrorSoft}"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Error}" />
        </Border>

        <!-- Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="Annuler" Grid.Column="0"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
            <Button x:Name="PayButton" Content="Payer" Grid.Column="2"
                    Style="{StaticResource PrimaryButton}" Click="Pay_Click" />
        </Grid>

    </StackPanel>
</Window>
