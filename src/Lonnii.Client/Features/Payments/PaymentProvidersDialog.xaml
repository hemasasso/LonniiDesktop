<Window x:Class="Lonnii.Client.Features.Payments.PaymentProvidersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moyens de paiement"
        Width="620" Height="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Moyens de paiement" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                           Text="Mobile Money, cartes, Google Pay et Apple Pay. Réglages propres à ce poste ; les clés secrètes sont chiffrées." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="Enregistrer" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,10,14">
            <!-- One card per provider, built in code from PaymentProviderRegistry.Planned. -->
            <StackPanel x:Name="Cards" Margin="0,0,8,0" />
        </ScrollViewer>

    </DockPanel>
</Window>
