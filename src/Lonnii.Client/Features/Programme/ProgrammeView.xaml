<UserControl x:Class="Lonnii.Client.Features.Programme.ProgrammeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                        <TextBlock Text="🗓" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Programme" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="WorkerCombo" Width="200" Margin="0,0,8,0"
                              DisplayMemberPath="Nom" SelectionChanged="WorkerCombo_SelectionChanged" />
                    <Button x:Name="PrintButton" Content="🖨 Imprimer"
                            Style="{StaticResource SecondaryButton}" Click="Print_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Month navigation -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" Width="32" Style="{StaticResource SecondaryButton}" Click="PreviousMonth_Click" />
                    <TextBlock x:Name="MonthLabel" FontSize="14" FontWeight="Bold" Margin="10,0"
                               VerticalAlignment="Center" MinWidth="150" TextAlignment="Center" />
                    <Button Content="›" Width="32" Style="{StaticResource SecondaryButton}" Click="NextMonth_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Aller au" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondary}" />
                    <DatePicker x:Name="GoToDatePicker" Width="130" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="Choisissez une date pour afficher son mois"
                                SelectedDateChanged="GoToDate_Changed" />
                    <Button x:Name="AddAnnouncementButton" Content="＋ Annonce" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="AddAnnouncement_Click" />
                    <Button Content="Aujourd'hui" Style="{StaticResource SecondaryButton}" Click="Today_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Calendar board -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="18">
                <StackPanel>
                    <UniformGrid x:Name="WeekdaysRow" Columns="7" Margin="0,0,0,6" />
                    <Grid x:Name="CalendarGrid" />
                </StackPanel>
            </ScrollViewer>

            <!-- Announcements -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Text="Annonces du mois" Style="{StaticResource SectionHeader}"
                               Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AnnouncementsList" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
