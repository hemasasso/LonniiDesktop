<Window x:Class="Lonnii.Client.Features.Ventes.ClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="300" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16">
                <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NomBox" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TelephoneBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EmailBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="AdresseBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ville" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="VilleBox" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="NotesBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                <CheckBox x:Name="ActiveCheck" Content="Client actif" Margin="0,16,0,0" IsChecked="True" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Un client désactivé n'est plus proposé à la caisse, mais son historique reste visible." />

                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="Les ventes sont rattachées au client par son téléphone, puis par son nom tel qu'il est saisi à la caisse." />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
