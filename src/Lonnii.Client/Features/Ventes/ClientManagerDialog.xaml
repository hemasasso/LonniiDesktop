<Window x:Class="Lonnii.Client.Features.Ventes.ClientManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lonnii.Client.Common.Controls"
        Title="Clients"
        Height="620" Width="1000"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Clients" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton" Content="Nouveau client" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                    <Button x:Name="EditButton" Content="Modifier" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Edit_Click" />
                    <Button x:Name="ToggleActiveButton" Content="Désactiver" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="ToggleActive_Click" />
                    <Button x:Name="ShowSalesButton" Content="Voir ses ventes" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="ShowSales_Click" />
                    <Rectangle Width="1" Margin="10,2" Fill="{DynamicResource Border}" />
                    <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Trier par" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="SortField" Width="130" Margin="0,0,4,0" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Classement" IsSelected="True" />
                        <ComboBoxItem Content="Nom" />
                        <ComboBoxItem Content="Total acheté" />
                        <ComboBoxItem Content="Reste dû" />
                        <ComboBoxItem Content="Dernier achat" />
                    </ComboBox>
                    <Button x:Name="SortDirectionButton" Content="▲" Width="30" MinWidth="30"
                            Padding="0" Margin="0,0,10,0" ToolTip="Ordre croissant"
                            Style="{StaticResource SecondaryButton}" Click="SortDirection_Click" />
                    <CheckBox x:Name="ResteDuCheck" Content="Reste dû uniquement" VerticalAlignment="Center"
                              Margin="0,0,10,0" Checked="ResteDuFilter_Changed" Unchecked="ResteDuFilter_Changed" />
                    <Grid Width="240">
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 Nom ou téléphone…"
                                   Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="560" HorizontalAlignment="Left" FontSize="12" />
                <Button Content="Fermer" IsCancel="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Par page" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PageSizeCombo" Width="70" SelectionChanged="PageSize_Changed">
                        <ComboBoxItem Content="10" IsSelected="True" />
                        <ComboBoxItem Content="15" />
                        <ComboBoxItem Content="20" />
                    </ComboBox>
                </StackPanel>
                <controls:PaginationBar x:Name="Pager" PageChanged="Pager_PageChanged" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- Sort column/direction live in the toolbar above (SortField/SortDirectionButton),
                 since column-click sorting here would only reorder the current page's 10-20
                 rows, not the whole filtered list behind it. -->
            <DataGrid x:Name="ClientGrid" RowHeight="34" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False"
                      MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                    <DataGridTextColumn Header="Nom" Binding="{Binding Client.Nom}" Width="2*" />
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Client.Telephone}" Width="130" />
                    <DataGridTextColumn Header="Achats" Binding="{Binding Client.NombreAchats}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total acheté" Binding="{Binding TotalDisplay}"
                                        SortMemberPath="Client.TotalAchats" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Reste dû" Binding="{Binding ResteDisplay}"
                                        SortMemberPath="Client.ResteDu" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Dernier achat" Binding="{Binding DernierDisplay}"
                                        SortMemberPath="Client.DernierAchat" Width="110" />
                    <DataGridTextColumn Header="Fiche" Binding="{Binding FicheDisplay}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Aucun client" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                               MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Les clients apparaissent ici dès qu'un nom est saisi sur une vente, ou quand vous en enregistrez un." />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
