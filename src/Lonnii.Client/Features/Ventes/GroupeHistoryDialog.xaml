<Window x:Class="Lonnii.Client.Features.Ventes.GroupeHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lonnii.Client.Common.Controls"
        Title="Historique des paiements groupés"
        Width="1040" Height="620"
        MinWidth="780" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Historique des paiements groupés" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Du" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,6,6" />
                <DatePicker x:Name="DebutPicker" Width="140" Margin="0,0,12,6" />
                <TextBlock Text="au" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,6,6" />
                <DatePicker x:Name="FinPicker" Width="140" Margin="0,0,12,6" />
                <Button Content="Filtrer" Margin="0,0,8,6" Style="{StaticResource PrimaryButton}" Click="Filter_Click" />
                <Button Content="Effacer" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Click="Clear_Click" />
                <Button Content="Actualiser" Margin="0,0,0,6" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="640" HorizontalAlignment="Left" FontSize="12" />
                <Button Content="Fermer" IsCancel="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <controls:PaginationBar x:Name="Pager" PageChanged="Pager_PageChanged" />
        </Border>

        <Grid>
            <DataGrid x:Name="HistoryGrid" RowHeight="34" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="130" />
                    <DataGridTextColumn Header="Client" Binding="{Binding ClientDisplay}" Width="*" />
                    <DataGridTextColumn Header="Caissier" Binding="{Binding CaissierDisplay}" Width="150" />
                    <DataGridTextColumn Header="Factures" Binding="{Binding FacturesDisplay}" Width="2*" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Avoir" Binding="{Binding AvoirDisplay}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🖨 Reçu" Padding="8,2" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}" Click="Print_Click" />
                                    <Button Content="Solder l'avoir" Padding="8,2"
                                            Visibility="{Binding SolderVisibility}"
                                            Style="{StaticResource SecondaryButton}" Click="Solder_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <TextBlock Text="Aucun paiement groupé" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

    </DockPanel>
</Window>
