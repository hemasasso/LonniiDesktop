<Window x:Class="Lonnii.Client.Features.Ventes.GroupePaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paiement groupé"
        Width="1020" Height="700"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Paiement groupé" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Réglez le reste à payer de plusieurs factures en une seule fois."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="PayButton" Content="Payer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Pay_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: find factures, who is paying and how. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Rechercher une facture impayée" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,4,0,0">
                        <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 N° de vente ou nom du client…"
                                   Foreground="{DynamicResource TextMuted}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <DataGrid x:Name="PickerGrid" Height="130" Margin="0,6,0,0" RowHeight="30"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                              SelectionMode="Extended" MouseDoubleClick="PickerGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° vente" Binding="{Binding Vente.NumeroVente}" Width="120" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientDisplay}" Width="*" />
                            <DataGridTextColumn Header="Reste" Binding="{Binding RestantDisplay}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Ajouter" Style="{StaticResource SecondaryButton}"
                                Click="AddSelected_Click" />
                        <TextBlock x:Name="PickerHint" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Nom du client (optionnel)" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                    <TextBox x:Name="ClientNameBox" Margin="0,4,0,0" Padding="8,6" />

                    <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <ComboBox x:Name="ModeCombo" Margin="0,4,0,0" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="Espèces" Tag="cash" IsSelected="True" />
                        <ComboBoxItem Content="Mobile Money" Tag="mobile_money" />
                        <ComboBoxItem Content="Carte bancaire" Tag="carte" />
                        <ComboBoxItem Content="Virement" Tag="virement" />
                        <ComboBoxItem Content="Chèque" Tag="cheque" />
                    </ComboBox>

                    <!-- Cash only: any other mode is charged exactly what is owed, so there is
                         no change to hand back. -->
                    <StackPanel x:Name="CashPanel" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock x:Name="TotalDueText" DockPanel.Dock="Right" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="Montant reçu" Style="{StaticResource FieldLabel}" />
                        </DockPanel>
                        <TextBox x:Name="MontantRecuBox" Margin="0,4,0,0" Padding="8,6"
                                 TextChanged="MontantRecu_TextChanged" LostFocus="MontantRecu_LostFocus" />
                        <TextBlock x:Name="MonnaieText" Margin="0,8,0,0" FontWeight="Bold" FontSize="13"
                                   TextWrapping="Wrap" />

                        <!-- Appears only when the customer handed over more than is owed. -->
                        <CheckBox x:Name="AvoirCheck" Margin="0,8,0,0" Visibility="Collapsed"
                                  Content="Je n'ai pas toute la monnaie (créer un avoir)"
                                  Checked="Avoir_Changed" Unchecked="Avoir_Changed" />
                        <StackPanel x:Name="RemisPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Monnaie remise maintenant" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MontantRemisBox" Margin="0,4,0,0" Padding="8,6"
                                     TextChanged="MontantRemis_TextChanged" LostFocus="MontantRemis_LostFocus" />
                            <TextBlock x:Name="AvoirText" Margin="0,6,0,0" FontWeight="Bold"
                                       Foreground="{DynamicResource Warning}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: what is being paid. -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="SelectedCountText" DockPanel.Dock="Right" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Factures sélectionnées" Style="{StaticResource FieldLabel}" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="Total à payer" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid>
                    <DataGrid x:Name="SelectedGrid" RowHeight="30" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Réf" Binding="{Binding Vente.NumeroVente}" Width="110" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientDisplay}" Width="*" />
                            <DataGridTextColumn Header="Reste" Binding="{Binding RestantDisplay}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" ToolTip="Retirer" Padding="0" MinWidth="0" Width="28" Height="24" Margin="2,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource SecondaryButton}" Click="RemoveSelected_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptySelectedText" Text="Aucune facture sélectionnée"
                               Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
