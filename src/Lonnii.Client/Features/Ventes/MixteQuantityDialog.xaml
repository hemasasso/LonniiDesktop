<Window x:Class="Lonnii.Client.Features.Ventes.MixteQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantité"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="200" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Ajouter" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <TextBlock x:Name="GrosLabel" Text="Cartons" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="GrosBox" LostFocus="Regroup_LostFocus" />

            <TextBlock x:Name="DetailLabel" Text="Unités" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="DetailBox" LostFocus="Regroup_LostFocus" />
        </StackPanel>

    </DockPanel>
</Window>
