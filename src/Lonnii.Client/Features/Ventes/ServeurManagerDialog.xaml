<Window x:Class="Lonnii.Client.Features.Ventes.ServeurManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serveurs"
        Height="560" Width="720"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Serveurs" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <!-- One form for both: empty = add, a row selected = edit that row. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NomBox" MaxLength="255" KeyDown="Form_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Téléphone (optionnel)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TelephoneBox" MaxLength="100" KeyDown="Form_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="SaveButton" Content="Ajouter" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    <Button x:Name="CancelEditButton" Content="Annuler" Margin="6,0,0,0" Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}" Click="CancelEdit_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ToggleActiveButton" Content="Désactiver"
                            Style="{StaticResource SecondaryButton}" Click="ToggleActive_Click" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" FontSize="12" />
                </StackPanel>
                <Button Content="Fermer" IsCancel="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Grid>
            <DataGrid x:Name="ServeurGrid" RowHeight="34" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Serveur.Nom}" Width="2*" />
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Serveur.Telephone}" Width="*" />
                    <DataGridTextColumn Header="Statut" Binding="{Binding StatutDisplay}" Width="100" />
                    <DataGridTextColumn Header="Ajouté le" Binding="{Binding CreatedDisplay}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="Aucun serveur" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                               MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Ajoutez les noms ci-dessus : la caisse les choisira sur chaque vente, sans les retaper." />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
