<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lonnii.Shared\Lonnii.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The .exe/shortcut icon is baked in at build time and cannot itself switch with the
         theme, so it uses the black-ink (light-background) variant. The window icon, which
         WPF sets at runtime, switches to the white-ink variant in dark mode - see AppIcon.cs. -->
    <ApplicationIcon>Assets\icon-light.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon-light.ico" />
    <Resource Include="Assets\icon-dark.ico" />

    <!-- Yellow bolt mark, no black ink, for the always-dark top nav bar. -->
    <Resource Include="Assets\icon-dark.png" />
  </ItemGroup>

</Project>
