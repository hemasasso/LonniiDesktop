<Window x:Class="Lonnii.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii"
        Height="760" Width="1240"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceAlt}">

    <Window.Resources>

        <!-- Rounded pill, used for both the top nav's section buttons and the Gestion
             dropdown's rows. Colour and hover feedback come entirely from Background,
             set per-button in code, so one template covers active and inactive alike. -->
        <ControlTemplate x:Key="PillNavButtonTemplate" TargetType="Button">
            <!-- The shadow is a sibling behind the pill, not an Effect on it: an Effect renders
                 its element, text included, as a bitmap and loses ClearType, blurring the label. -->
            <Grid x:Name="Root" UseLayoutRounding="True">
                <Border CornerRadius="16" Background="{TemplateBinding Background}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="#0B1B33" />
                    </Border.Effect>
                </Border>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Small circular button for the nav bar's utility icons (refresh, notifications,
             the avatar, home). Fixed 30x30 so mixed glyph widths still line up. -->
        <ControlTemplate x:Key="IconCircleButtonTemplate" TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    Width="30" Height="30"
                    CornerRadius="15"
                    SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Same idea, but square-ish with a smaller radius, for the back button. -->
        <ControlTemplate x:Key="IconSquareButtonTemplate" TargetType="Button">
            <!-- Box and arrow are separate siblings (not icon-inside-box) so the disabled
                 trigger below can dim just the box's Opacity without taking the arrow down
                 with it to near-invisible. -->
            <Grid Width="32" Height="32" SnapsToDevicePixels="True">
                <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="8" />
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <!-- Brightens the box on hover rather than fading it - fading made the arrow
                     harder to see exactly when the user was pointing at it. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Row used inside the Gestion dropdown: an accent stripe plus a label, exactly
             what the old sidebar used, since the dropdown replaces that sidebar. -->
        <ControlTemplate x:Key="DropdownRowTemplate" TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentLight}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Prêt" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusUser" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Remote access: says plainly that this is the shop's last backup, not the shop live. -->
        <Border x:Name="RemoteBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource AccentLight}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1" Padding="14,6">
            <TextBlock x:Name="RemoteBannerText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextPrimary}" />
        </Border>

        <!-- A new version held by the shop's main computer; admins only. -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource AccentLight}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1" Padding="14,5">
            <DockPanel>
                <Button x:Name="UpdateInstallButton" DockPanel.Dock="Right" Content="Installer maintenant"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,3" Margin="12,0,0,0" Click="UpdateInstall_Click" />
                <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" />
            </DockPanel>
        </Border>

        <!--
          Top navigation. Replaces the old menu bar and left sidebar: every module the
          user can reach now lives in this one bar, either as a direct pill (Chat,
          Programme, Options...) or, for Gestion, behind a dropdown listing its
          sub-modules - there is nowhere left to show that list at a glance the way the
          sidebar did. Account actions (change group, change password, sign out...)
          moved into the avatar's own menu.
        -->
        <!-- Gray grid bar; HeaderBackground lives in both palettes so it follows the theme. -->
        <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource HeaderBackground}">

            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back: pops the last module off the in-app navigation history. A plain
                     string Content here used to get auto-wrapped in a TextBlock that took
                     the implicit TextBlock style's Foreground (dark TextPrimary) instead of
                     this button's own White - a Style setter beats inherited Foreground -
                     same reason every other icon TextBlock below uses ButtonContentText. -->
                <Button x:Name="BackButton" Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0"
                        FontSize="15" Foreground="{DynamicResource HeaderPillText}" Cursor="Hand"
                        Background="{DynamicResource HeaderPill}" BorderThickness="0" IsEnabled="False"
                        Template="{StaticResource IconSquareButtonTemplate}"
                        Click="Back_Click" ToolTip="Retour">
                    <TextBlock Text="←" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HeaderPillText}" />
                </Button>

                <!-- One pill per module the session's menu allows. -->
                <StackPanel x:Name="NavPillPanel" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" />

                <!-- Utilities + account -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Segoe MDL2 Assets glyphs rather than emoji throughout this group: an
                         emoji ignores Foreground and keeps its own built-in colours, which
                         read as dark/muddy against this translucent-white-on-purple bar. -->
                    <Button x:Name="DarkModeButton" FontSize="13" Foreground="{DynamicResource HeaderPillText}"
                            Background="{DynamicResource HeaderPill}" BorderThickness="0" Margin="0,0,6,0"
                            Template="{StaticResource IconCircleButtonTemplate}"
                            ToolTip="Mode sombre" Click="DarkMode_Click">
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource ButtonContentText}" />
                    </Button>
                    <Button x:Name="TopRefreshButton" FontSize="15" Foreground="{DynamicResource HeaderPillText}"
                            Background="{DynamicResource HeaderPill}" BorderThickness="0" Margin="0,0,6,0"
                            Template="{StaticResource IconCircleButtonTemplate}"
                            ToolTip="Actualiser (F5)" Click="Refresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource ButtonContentText}" />
                    </Button>
                    <Button x:Name="NotificationsButton" FontSize="13" Foreground="{DynamicResource HeaderPillText}"
                            Background="{DynamicResource HeaderPill}" BorderThickness="0" Margin="0,0,12,0"
                            Template="{StaticResource IconCircleButtonTemplate}"
                            ToolTip="Notifications" Click="Notifications_Click">
                        <Grid>
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource ButtonContentText}" />
                            <!-- Count of active alerts; hidden when there are none. -->
                            <Border x:Name="NotificationBadge" Visibility="Collapsed"
                                    Background="#DC2626" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-11,0">
                                <TextBlock x:Name="NotificationBadgeText" Foreground="White" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Popup x:Name="NotificationsPopup" StaysOpen="False" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=NotificationsButton}"
                           HorizontalOffset="-300" AllowsTransparency="True" PopupAnimation="None">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}"
                                BorderThickness="1.5" CornerRadius="10" Padding="6" Width="340" Margin="0,6,12,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.35" Color="#0B1B33" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold" Margin="8,4,8,6"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="NotificationsPanel" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="AvatarButton" Content="?" FontSize="12" FontWeight="Bold"
                            Foreground="#1B1F27" Background="#FFC839" BorderThickness="0" Margin="0,0,6,0"
                            Template="{StaticResource IconCircleButtonTemplate}"
                            ToolTip="Compte" Click="Avatar_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AvatarMenu" Placement="Bottom">
                                <MenuItem x:Name="AvatarGroupHeader" IsEnabled="False" FontWeight="SemiBold" />
                                <MenuItem x:Name="AvatarRoleHeader" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="Changer d'espace…" Click="ChangeGroup_Click" />
                                <MenuItem x:Name="ProfileMenuItem" Header="Mon profil…" Click="Profile_Click" />
                                <MenuItem Header="Changer mon mot de passe…" Click="ChangePassword_Click" />
                                <Separator />
                                <MenuItem Header="À propos de Lonnii…" Click="About_Click" />
                                <MenuItem Header="Se déconnecter" Click="SignOut_Click" />
                                <MenuItem Header="Quitter" Click="Quit_Click" InputGestureText="Alt+F4" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="HomeButton" FontSize="13" Foreground="{DynamicResource HeaderPillText}"
                            Background="{DynamicResource HeaderPill}" BorderThickness="0"
                            Template="{StaticResource IconCircleButtonTemplate}"
                            ToolTip="Accueil" Click="Home_Click">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource ButtonContentText}" />
                    </Button>
                </StackPanel>

                <!-- The modules of whichever section pill was last clicked (Opérations,
                     Finance & Analyse, Administration). One popup serves all three: it is
                     refilled and re-anchored on each click, since only one can be open. -->
                <Popup x:Name="SectionPopup" Grid.Column="2" StaysOpen="False" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="None">
                    <!-- Margin leaves room for the shadow, which AllowsTransparency would otherwise clip. -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1.5" CornerRadius="10" Padding="6" MinWidth="250" Margin="0,6,12,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.35" Color="#0B1B33" />
                        </Border.Effect>
                        <StackPanel x:Name="SectionPopupPanel" />
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Content host -->
        <ContentControl x:Name="ContentHost" />

    </DockPanel>
</Window>
