<!--
  Dark counterpart of Palette.Light.xaml - same keys, same shapes (an accent, three
  surfaces, two borders, three text tones, on-accent text, three status colours and one
  light status tint), just re-tuned for a dark background. See Palette.Light.xaml for how
  these get swapped in at runtime.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Accent" Color="#5B72F5" />
    <SolidColorBrush x:Key="AccentDark" Color="#4358D6" />
    <SolidColorBrush x:Key="AccentLight" Color="#242C4C" />

    <SolidColorBrush x:Key="Surface" Color="#1E2029" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#16171F" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#12131A" />
    <SolidColorBrush x:Key="Border" Color="#2E313D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3C4050" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F1F2F6" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A9AFBD" />
    <SolidColorBrush x:Key="TextMuted" Color="#767C8C" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Success" Color="#34D399" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
    <SolidColorBrush x:Key="DangerLight" Color="#3B1B1E" />

    <!-- Buttons on the top bar: a lighter blue than the bar so they stand out without glare. -->
    <SolidColorBrush x:Key="HeaderPill" Color="#35659E" />
    <SolidColorBrush x:Key="HeaderPillBorder" Color="#5A8AC4" />
    <SolidColorBrush x:Key="HeaderPillText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderPillActive" Color="#FFC839" />
    <SolidColorBrush x:Key="HeaderPillActiveText" Color="#1B1F27" />

    <!-- Top bar: a muted navy blue, lighter than the dark surfaces so it still reads as a bar. -->
    <DrawingBrush x:Key="HeaderBackground" TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute"
                  Viewbox="0,0,22,22" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1F3F66">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,22,22" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#264970">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,22,1" />
                            <RectangleGeometry Rect="0,0,1,22" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
