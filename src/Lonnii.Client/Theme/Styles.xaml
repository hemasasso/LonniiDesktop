<!--
  Shared look for the whole client.

  Colours are NOT defined here any more - see Theme/Palette.Light.xaml and
  Theme/Palette.Dark.xaml. Every brush this file's styles use (Accent, Surface,
  TextPrimary...) is a DynamicResource, so swapping which palette dictionary is merged
  in App.xaml.Resources.MergedDictionaries (see ThemeManager) re-themes every window and
  control already on screen, not just ones created afterwards.

  The layout itself is deliberately plain Windows: a menu bar, toolbars, DataGrids and
  modal dialogs, rather than a re-creation of the web app's cards.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Lonnii.Client">

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Margin" Value="12,14,12,6" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      ComboBox's default template is drawn by the OS theme (Aero/Fluent), not by our
      Background/Foreground setters, so on a dark palette it stayed a light control in a
      dark toolbar. This template replaces the whole chrome - closed box, drop arrow and
      the popup's item list - with the same brushes every other control uses, all via
      DynamicResource so it re-themes live like everything else.
    -->
    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- DisplayMemberPath works through ItemTemplateSelector, not
                                     SelectionBoxItemTemplate: without the selector the closed box
                                     shows the item's ToString(), e.g. "RoleOption { Value = ... }". -->
                                <ContentPresenter Grid.Column="0"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                   ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                   Margin="{TemplateBinding Padding}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />

                                <TextBlock Grid.Column="1" Text="▾" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide"
                               Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
      The calendar popup DatePicker opens is a separate control (Calendar, made of
      CalendarItem/CalendarDayButton/CalendarButton parts), so it needed its own
      DynamicResource-based theming - otherwise it stayed the OS's light popup even with
      everything else on the dark palette.
    -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="3" Margin="1">
                        <!-- Calendar sets Content to a plain day-number string, which
                             ContentPresenter auto-wraps in a TextBlock - and that TextBlock
                             takes the app's global implicit TextBlock style (Foreground =
                             TextPrimary, always) instead of inheriting this button's own
                             Foreground, silently undoing every Trigger below that sets it
                             (IsInactive, IsBlackedOut, IsSelected). Same trap as a Button
                             given a bare string Content (see BackButton in MainWindow.xaml) -
                             a Resources override scoped to this ContentPresenter, closer in
                             the tree than the app-level style, wins the implicit lookup and
                             binds back to whatever Foreground this button actually has. -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,3">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CalendarDayButton}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="3" Margin="1">
                        <!-- Same fix as CalendarDayButton above: without this, the
                             auto-wrapped TextBlock for this button's plain-string Content
                             ignores the IsInactive trigger below. -->
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,8">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CalendarButton}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- CalendarItem.OnApplyTemplate looks this DataTemplate up by this
                             exact ComponentResourceKey (TypeInTargetAssembly=CalendarItem,
                             ResourceId="DayTitleTemplate" - both from the WPF source) to
                             build each day-of-week header cell; PopulateGrids() then sets
                             DataContext on the loaded element to the culture's short day
                             name string (Calendar.FirstDayOfWeek-adjusted), so a plain
                             Text="{Binding}" is enough. Omitting this key means Calendar
                             falls back to a bare, content-less ContentControl per header
                             cell - a blank row, not blank text. -->
                        <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type primitives:CalendarItem}, ResourceId=DayTitleTemplate}">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSunken}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="◀" Padding="6,3" />
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center" />
                                <Button x:Name="PART_NextButton" Grid.Column="2" Content="▶" Padding="6,3" />
                            </Grid>

                            <!-- CalendarItem.PopulateGrids() (WPF source) assigns Grid.Row/Grid.Column
                                 to each day/month button it creates but never adds
                                 RowDefinitions/ColumnDefinitions itself - it expects the template to
                                 already provide the 7x7 (month view: 1 day-title row + 6 week rows,
                                 7 days) / 3x4 (year/decade view: ROWS x COLS per the WPF source's
                                 YEAR_ROWS/YEAR_COLS constants) grid structure. Leaving these Grids
                                 empty, as before, meant every generated button landed in the single
                                 implicit (0,0) cell and rendered stacked on top of each other -
                                 which is what "the day grid is just one giant cell" actually was. -->
                            <Grid Grid.Row="1" x:Name="PART_MonthView" Visibility="Visible"
                                  HorizontalAlignment="Center" Width="238" Height="182">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Grid Grid.Row="1" x:Name="PART_YearView" Visibility="Hidden"
                                  HorizontalAlignment="Center" Width="220" Height="132">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Background/BorderBrush setters alone left the day-grid area white: Calendar's default
      ControlTemplate (from the OS theme's generic dictionary) draws its own chrome around
      PART_CalendarItem rather than referencing {TemplateBinding Background} there, so a
      plain Setter had nothing to apply to. Replacing the whole template with a thin wrapper
      around CalendarItem hands every pixel to the CalendarItem style above instead, which
      already themes the header and day grid correctly.
    -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <!-- Calendar generates its day and month/year buttons in code and assigns their
             Style from these two properties explicitly (bypassing implicit type-based
             lookup), so the CalendarDayButton/CalendarButton styles above only reach them
             through here. An earlier attempt at this broke the month view instead - not
             because of these Setters, but because PART_MonthView/PART_YearView above had no
             RowDefinitions/ColumnDefinitions, so every generated button (CalendarItem's own
             source never adds them - the template must) landed in the same implicit (0,0)
             cell. Now that those are defined, this is safe. -->
        <Setter Property="CalendarButtonStyle" Value="{StaticResource {x:Type CalendarButton}}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource {x:Type CalendarDayButton}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Like ComboBox, DatePicker's default template draws its border, textbox chrome and
      calendar-toggle button with OS/Aero visuals that ignore simple Background/Foreground
      setters, so it stayed a light control in dark mode. This replaces the whole chrome -
      the popup that hosts the Calendar (styled separately below) is left as the built-in
      PART_Popup, untouched.
    -->
    <Style TargetType="DatePickerTextBox">
        <!-- Belt and braces with the ScrollViewer's own Foreground below: DatePickerTextBox
             is a TextBox subclass, and TextBox draws its text from its own Foreground, not
             from PART_ContentHost's - relying on inheritance alone left the typed date
             rendering in Control's black default rather than the palette's TextPrimary. -->
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border Background="Transparent" Padding="8,6">
                        <ScrollViewer x:Name="PART_ContentHost" Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- The gap the Calendar style's own CalendarButtonStyle/CalendarDayButtonStyle
             setters didn't close: DatePicker builds its popup Calendar itself and assigns
             its Style explicitly from THIS property (default: the OS theme's light style),
             the same "explicit beats implicit" trap one level up. Nothing done to the
             Calendar style directly could ever reach a Calendar DatePicker constructs this
             way - this is what finally does. -->
        <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" />

                                <Button x:Name="PART_Button" Grid.Column="1" Width="26" Focusable="False"
                                        Content="📅" Padding="0" BorderThickness="0" Cursor="Hand"
                                        Background="Transparent" Foreground="{DynamicResource TextSecondary}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ContextMenu (e.g. the "Plus" overflow menu, the avatar's account menu) is another
      OS-chrome control that ignored our palette, so it stayed a light popup even in dark
      mode. Retemplated the same way as ComboBox's popup.
    -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ToolTip is another OS-chrome popup left unthemed until now: every icon-only button
      whose only label is its tooltip (the ventes list's action column especially) popped up
      the system's plain white tooltip on hover, even in dark mode.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                               VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceSunken}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- A Button given a plain string for Content (rather than an explicit TextBlock or
             a composite like a StackPanel) has WPF auto-wrap that string in its own TextBlock,
             which - having no explicit Style - falls back to the app's global implicit
             <Style TargetType="TextBlock"> and its Foreground, ignoring the coloured
             Foreground PrimaryButton/DangerButton set on the Button itself: white text turns
             back to body-text dark on top of a blue or red background.
             ButtonStringContentTemplateSelector only ever applies the fix-up template for
             that plain-string case - an unconditional ContentTemplate Setter would apply to
             every Content value regardless of type, including a composite Content such as an
             icon+label StackPanel, which would then render as its own ToString() through the
             template's {Binding} instead of being displayed directly. FontFamily/FontSize are
             carried over too. so a Segoe MDL2 Assets glyph passed as Content (an icon-only
             button) keeps rendering as its icon instead of falling back to the default UI
             font, which has no glyph at that code point. -->
        <Setter Property="ContentTemplateSelector">
            <Setter.Value>
                <local:ButtonStringContentTemplateSelector>
                    <local:ButtonStringContentTemplateSelector.StringTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </DataTemplate>
                    </local:ButtonStringContentTemplateSelector.StringTemplate>
                </local:ButtonStringContentTemplateSelector>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <!-- Fading the whole Border's Opacity also faded its text to the
                             point of being unreadable (pale text on a pale background is
                             still low-contrast at any lightness). Swapping to flat neutral
                             brushes keeps the label legible while still reading as disabled. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BorderStrong}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDark}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A small transparent, borderless button for a single icon glyph (a table row's action
         column, a "remove" mark). Based on ButtonBase rather than left at the WPF default
         Button style, whose built-in template paints a solid system-colour highlight on
         hover/press that Background="Transparent" cannot suppress - it would flash white
         even in dark mode. ButtonBase's template fades opacity instead, so whatever
         Foreground this button was given stays that colour throughout. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Toolbar -->
    <Style x:Key="ToolbarPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!--
      Pill-shaped tab, used to switch a module between its own sub-views (e.g. Stock /
      Analyse). Active vs inactive is a Background + Foreground + FontWeight the
      code-behind sets directly (same as the icon/list view toggle): the active tab gets
      an Accent pill like "+ Ajouter Produit", the inactive one stays flat/transparent.
    -->
    <Style x:Key="ModuleTabButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill-shaped primary action button, e.g. "+ Ajouter Produit" in a module toolbar -->
    <Style x:Key="PillPrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data grid -->
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="RowBackground" Value="{DynamicResource Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentLight}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Right-aligned cell text, for quantities and money -->
    <Style x:Key="NumericCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- Status bar -->
    <Style TargetType="StatusBar">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!--
      For a TextBlock placed inside a Button's content (icon + label layouts).

      The implicit TextBlock style above sets Foreground, and in WPF a style setter beats
      property inheritance - so such a TextBlock takes TextPrimary (dark) and ignores the
      white Foreground its Button was given, leaving dark text on a filled Accent/Danger
      button. Binding to the ancestor Button's own Foreground fixes that and keeps following
      it, which matters for buttons that swap between filled and plain states (the payment
      mode picker, the module tabs) rather than being one fixed colour.
    -->
    <Style x:Key="ButtonContentText" TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
