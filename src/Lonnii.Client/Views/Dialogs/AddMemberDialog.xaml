<Window x:Class="Lonnii.Client.Views.Dialogs.AddMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un membre"
        Height="590" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Ajouter un membre" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="250" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="AddButton" Content="Ajouter" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,16">

            <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
            <RadioButton x:Name="NewAccountRadio" GroupName="Mode" IsChecked="True"
                         Content="Créer un nouveau compte" Margin="0,2,0,0"
                         Checked="Mode_Changed" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="20,0,0,0" TextWrapping="Wrap"
                       Text="Pour une personne qui n'a jamais utilisé Lonnii." />

            <RadioButton x:Name="ExistingAccountRadio" GroupName="Mode"
                         Content="Ajouter un compte existant" Margin="0,10,0,0"
                         Checked="Mode_Changed" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="20,0,0,0" TextWrapping="Wrap"
                       Text="Pour quelqu'un qui a déjà un compte sur ce serveur." />

            <Rectangle Height="1" Fill="{DynamicResource Border}" Margin="0,16,0,16" />

            <TextBlock x:Name="IdentifierLabel" Text="Adresse email *" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="IdentifierBox" />

            <StackPanel x:Name="NewAccountFields">

                <TextBlock Text="Nom d'utilisateur" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="UsernameBox"
                         ToolTip="Identifiant court, plus rapide à saisir au comptoir qu'une adresse email" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Prénom" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FirstNameBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LastNameBox" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Mot de passe *" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Plain text on purpose: the admin must read it out to the employee. -->
                    <TextBox x:Name="PasswordBox" Grid.Column="0" TextChanged="Password_Changed" />
                    <Button Grid.Column="1" Content="Générer" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Generate_Click" />
                </Grid>
                <TextBlock x:Name="PasswordHint" Style="{StaticResource PageSubtitle}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <Border Margin="0,14,0,0" Padding="12,10"
                        Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Text="Communiquez ce mot de passe à la personne concernée. Il ne pourra plus être affiché ensuite : seul un nouveau mot de passe pourra être défini." />
                </Border>

            </StackPanel>

            <TextBlock x:Name="ExistingHint" Visibility="Collapsed"
                       Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Le compte sera ajouté à cet espace avec le rôle « membre » et les accès de base. Vous pourrez ensuite lui accorder des privilèges." />

        </StackPanel>

    </DockPanel>
</Window>
