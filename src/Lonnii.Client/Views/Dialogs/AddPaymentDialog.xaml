<Window x:Class="Lonnii.Client.Views.Dialogs.AddPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un paiement"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Ajouter un paiement" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Montant" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MontantBox" Margin="0,4,0,0" Padding="8,6" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="PaymentCashButton" Width="70" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}" Click="PaymentMode_Click" Tag="cash">
                    <TextBlock Text="Espèces" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="PaymentMobileButton" Width="90" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="PaymentMode_Click" Tag="mobile_money">
                    <TextBlock Text="Mobile Money" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="PaymentCarteButton" Width="70" Height="34"
                        Style="{StaticResource SecondaryButton}" Click="PaymentMode_Click" Tag="carte">
                    <TextBlock Text="Carte" Style="{StaticResource ButtonContentText}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border x:Name="ErrorPanel" Grid.Row="3" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0,10,0,0"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Enregistrer le paiement" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
