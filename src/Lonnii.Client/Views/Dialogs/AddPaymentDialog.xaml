<Window x:Class="Lonnii.Client.Views.Dialogs.AddPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un paiement"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Ajouter un paiement" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Montant" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MontantBox" Margin="0,4,0,0" Padding="8,6" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="PaymentCashButton" Width="70" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}" Click="PaymentMode_Click" Tag="cash">
                    <TextBlock Text="Espèces" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="PaymentMobileButton" Width="90" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="PaymentMode_Click" Tag="mobile_money">
                    <TextBlock Text="Mobile Money" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="PaymentCarteButton" Width="70" Height="34"
                        Style="{StaticResource SecondaryButton}" Click="PaymentMode_Click" Tag="carte">
                    <TextBlock Text="Carte" Style="{StaticResource ButtonContentText}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Cash only - a card or mobile payment is charged exactly what is typed above, so
             there is no change to hand back. Change is measured against Montant itself (what
             the cashier is actually applying to the sale), not the amount still owed - typing
             more than Montant here means the customer handed over more than is being recorded
             as paid right now. -->
        <Border x:Name="MontantRecuPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,6"
                Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Montant reçu"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="MontantRecuBox" Padding="8,6"
                             TextChanged="MontantRecu_TextChanged" LostFocus="MontantRecu_LostFocus" />
                </DockPanel>
                <TextBlock x:Name="MonnaieARendreText" Margin="0,6,0,0" FontWeight="Bold"
                           FontSize="13" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorPanel" Grid.Row="4" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0,10,0,0"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Enregistrer le paiement" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
