<Window x:Class="Lonnii.Client.Views.Dialogs.BilanCompteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compte"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tableau" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TableCombo">
                        <ComboBoxItem Content="Bilan" Tag="bilan" IsSelected="True" />
                        <ComboBoxItem Content="Compte de résultat" Tag="resultat" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="N° compte *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NumeroBox" MaxLength="20" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Libellé *" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="LibelleBox" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Type de compte *" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TypeCombo" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sous-type" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SousTypeBox" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SystemNotice" Visibility="Collapsed" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                       Text="Compte par défaut : son type et son sous-type sont ce qui lui fait recevoir les montants automatiques (ventes, stock, immobilisations…), ils ne se modifient donc pas." />

            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54" />
        </StackPanel>

    </DockPanel>
</Window>
