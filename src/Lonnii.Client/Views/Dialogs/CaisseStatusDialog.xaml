<Window x:Class="Lonnii.Client.Views.Dialogs.CaisseStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caisse ouverte"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Margin="0,0,110,0">
                    <TextBlock Text="Caisse ouverte" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <!-- Its own row rather than sharing the footer with Annuler/Fermer la caisse -
                     three buttons there ran wider than this window and pushed whichever one
                     came first past the left edge, invisible without the window being resized. -->
                <Button x:Name="WithdrawButton" Content="💸 Retirer" Padding="10,5"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}" Click="Withdraw_Click" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fermer" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="CloseCaisseButton" Content="Fermer la caisse" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="CloseCaisse_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">

            <Border Padding="12,10" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Ventes de la session" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="VentesCountText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Chiffre d'affaires" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="ChiffreAffairesText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Encaissé" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="EncaisseText" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource Success}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Fonds initial" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="MontantInitialText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Espèces" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="PaiementCashText" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Mobile / Carte / Autres" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="AutresModesText" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel x:Name="RetraitsPanel" Grid.Row="3" Grid.Column="0" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Retraits" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="RetraitsText" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Danger}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="ClosePanel" Margin="0,16,0,0">
                <TextBlock Text="Montant compté en caisse (espèces)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MontantFinalBox" TextChanged="MontantFinal_Changed" />
                <TextBlock x:Name="ExpectedText" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Notes de fermeture (optionnel)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="NotesBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" />
            </StackPanel>

            <TextBlock x:Name="NoCloseNotice" Margin="0,16,0,0" TextWrapping="Wrap"
                       Style="{StaticResource PageSubtitle}"
                       Text="Vous n'êtes pas autorisé à fermer cette caisse."
                       Visibility="Collapsed" />

        </StackPanel>

    </DockPanel>
</Window>
