<Window x:Class="Lonnii.Client.Views.Dialogs.CancelVenteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annuler la vente"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Annuler la vente" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Le stock des articles sera restitué. Cette action ne peut pas être annulée." />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Motif d'annulation" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MotifBox" Margin="0,4,0,0" Padding="8,6"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <Border x:Name="ErrorPanel" Grid.Row="2" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0,10,0,0"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Annuler la vente" IsDefault="True"
                    Style="{StaticResource DangerButton}" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
