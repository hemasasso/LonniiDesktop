<Window x:Class="Lonnii.Client.Views.Dialogs.CategoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catégories"
        Height="560" Width="740"
        MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Catégories" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nouvelle catégorie" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                <Button x:Name="EditButton" Content="Modifier" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Edit_Click" />
                <Button x:Name="ToggleActiveButton" Content="Désactiver" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="ToggleActive_Click" />
                <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Border}" />
                <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="400" HorizontalAlignment="Left" FontSize="12" />
                <Button Content="Fermer" IsCancel="True" IsDefault="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Grid>
            <DataGrid x:Name="CategoryGrid" RowHeight="44" MouseDoubleClick="Grid_DoubleClick"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Photo" Width="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="36" Height="36" Margin="4"
                                        Background="{StaticResource SurfaceAlt}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        CornerRadius="3">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Category.Name}" Width="*" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Category.Description}" Width="2*" />
                    <DataGridTextColumn Header="Produits" Binding="{Binding Category.ProductCount}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding Category.IsActive}" Width="60" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{StaticResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Aucune catégorie" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                               MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Créez une première catégorie pour commencer à organiser votre inventaire." />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
