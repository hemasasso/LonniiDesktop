<Window x:Class="Lonnii.Client.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changer mon mot de passe"
        Height="410" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Changer mon mot de passe" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="AccountText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="230" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="SaveButton" Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,16">

            <TextBlock Text="Mot de passe actuel *" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="CurrentBox" />

            <TextBlock Text="Nouveau mot de passe *" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <PasswordBox x:Name="NewBox" PasswordChanged="Password_Changed" />

            <TextBlock Text="Confirmer le nouveau mot de passe *" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="Password_Changed" />

            <TextBlock x:Name="PasswordHint" Style="{StaticResource PageSubtitle}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />

            <Border Margin="0,16,0,0" Padding="12,10"
                    Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="3">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           Text="Vos autres sessions seront fermées. Aucune récupération par email n'existe sur un serveur local : notez bien ce mot de passe." />
            </Border>

        </StackPanel>

    </DockPanel>
</Window>
