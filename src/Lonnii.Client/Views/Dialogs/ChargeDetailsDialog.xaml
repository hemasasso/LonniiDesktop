<Window x:Class="Lonnii.Client.Views.Dialogs.ChargeDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détails de la charge récurrente"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Button Content="Fermer" IsCancel="True" IsDefault="True"
                    HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,0">
            <Border Padding="12,10" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Montant mensuel" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="MontantText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Catégorie" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="CategorieText" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Prochaine création" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="NextText" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Jusqu'au" Style="{StaticResource PageSubtitle}" />
                        <TextBlock x:Name="EndText" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Charges déjà créées automatiquement" FontWeight="SemiBold" Margin="0,16,0,8" />
        </StackPanel>

        <Grid Margin="18,0,18,14">
            <DataGrid x:Name="GeneratedGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Width="110"
                                        Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                    <DataGridTextColumn Header="Montant" Width="*" Binding="{Binding MontantDisplay}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Text="Aucune occurrence créée pour le moment."
                       Style="{StaticResource PageSubtitle}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

    </DockPanel>
</Window>
