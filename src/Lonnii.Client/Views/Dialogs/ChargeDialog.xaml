<Window x:Class="Lonnii.Client.Views.Dialogs.ChargeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charge"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="240" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Margin="18,16">
            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="DescriptionBox" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Montant" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MontantBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TypeCombo">
                        <ComboBoxItem Content="Variable" Tag="variable" IsSelected="True" />
                        <ComboBoxItem Content="Fixe" Tag="fixe" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CategorieCombo" DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="DatePicker" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="RecurringCheck" Content="Charge récurrente (créée chaque mois automatiquement)"
                      Margin="0,16,0,0" Checked="RecurringCheck_Changed" Unchecked="RecurringCheck_Changed" />

            <StackPanel x:Name="RecurringPanel" Margin="20,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Créer jusqu'au (dernier mois inclus)" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="RecurringEndPicker" />

                <TextBlock Text="Jour de création" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <ComboBox x:Name="RecurringDayCombo">
                    <ComboBoxItem Content="Le 1er du mois" Tag="debut" />
                    <ComboBoxItem Content="Le dernier jour du mois" Tag="fin" IsSelected="True" />
                </ComboBox>

                <Grid Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Ou un jour précis (1-31)"
                               Foreground="{DynamicResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="RecurringDayBox" Width="60" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <TextBlock x:Name="GeneratedNotice" Visibility="Collapsed" Margin="0,16,0,0"
                       TextWrapping="Wrap" Style="{StaticResource PageSubtitle}"
                       Text="Cette charge a été créée automatiquement par une charge récurrente et ne peut pas devenir elle-même une source récurrente." />
        </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
