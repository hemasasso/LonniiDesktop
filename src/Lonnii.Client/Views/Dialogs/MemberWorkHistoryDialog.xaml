<Window x:Class="Lonnii.Client.Views.Dialogs.MemberWorkHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique de présence"
        Width="980" Height="620" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,100,0" />
                <Button Content="Fermer" IsCancel="True" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Grid Margin="18,14">
            <!-- RowHeight="NaN" overrides the app-wide fixed 32px row (Styles.xaml) back to
                 auto-sizing - needed here since Connexions wraps to several lines on a day
                 with more than one session, and a fixed row height would clip it. -->
            <DataGrid x:Name="DaysGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="NaN">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Jour" Width="170" Binding="{Binding DateDisplay}" />
                    <DataGridTextColumn Header="Prévu" Width="150" Binding="{Binding PlannedDisplay}" />
                    <DataGridTemplateColumn Header="Connexions" Width="*" MinWidth="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SessionsDisplay}" TextWrapping="Wrap" Margin="4,6" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Total" Width="90" Binding="{Binding TotalDisplay}" />
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FlagDisplay}" Foreground="{Binding FlagBrush}"
                                           FontWeight="SemiBold" FontSize="11" Margin="4,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource PageSubtitle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Aucune connexion ni journée prévue sur les 30 derniers jours." />
        </Grid>

    </DockPanel>
</Window>
