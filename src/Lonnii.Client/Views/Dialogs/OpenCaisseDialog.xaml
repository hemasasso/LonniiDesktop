<Window x:Class="Lonnii.Client.Views.Dialogs.OpenCaisseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ouvrir la caisse"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Ouvrir la caisse" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Comptez le fonds de caisse avant la première vente."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Ouvrir" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Open_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <TextBlock Text="Fonds initial — Espèces" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MontantCashBox" />

            <TextBlock Text="Fonds initial — Mobile Money (optionnel)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="MontantMobileBox" />

            <TextBlock Text="Notes (optionnel)" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="NotesBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" />
        </StackPanel>

    </DockPanel>
</Window>
