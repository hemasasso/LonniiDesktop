<Window x:Class="Lonnii.Client.Views.Dialogs.PrivilegeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privilèges"
        Height="640" Width="740"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="MemberName" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="MemberHint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" />
                <Button Content="Fermer" IsCancel="True" IsDefault="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="12" BorderThickness="1"
                    BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}" />

    </DockPanel>
</Window>
