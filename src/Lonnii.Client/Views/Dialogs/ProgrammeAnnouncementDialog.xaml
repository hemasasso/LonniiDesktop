<Window x:Class="Lonnii.Client.Views.Dialogs.ProgrammeAnnouncementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annonce"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Affichée sur le programme imprimé de la période concernée."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Destinataire" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="WorkerCombo" DisplayMemberPath="Nom" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="DatePicker" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Titre" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <TextBox x:Name="TitreBox" />

            <TextBlock Text="Message" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <TextBox x:Name="MessageTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
        </StackPanel>

    </DockPanel>
</Window>
