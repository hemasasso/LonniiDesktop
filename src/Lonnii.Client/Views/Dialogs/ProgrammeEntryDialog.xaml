<Window x:Class="Lonnii.Client.Views.Dialogs.ProgrammeEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lonnii.Client.Controls"
        Title="Journée"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="HeaderHint" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="150" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ClearButton" Content="Effacer" Margin="0,0,8,0"
                            Style="{StaticResource DangerButton}" Click="Clear_Click" />
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Enregistrer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <TextBlock Text="Type de journée" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TypeCombo">
                <ComboBoxItem Content="Travail" Tag="travail" IsSelected="True" />
                <ComboBoxItem Content="Réunion" Tag="reunion" />
                <ComboBoxItem Content="Repos" Tag="repos" />
            </ComboBox>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="De" Style="{StaticResource FieldLabel}" />
                    <controls:TimeWheelPicker x:Name="HeureDebutPicker" DefaultValue="08:00:00" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="À" Style="{StaticResource FieldLabel}" />
                    <controls:TimeWheelPicker x:Name="HeureFinPicker" DefaultValue="17:00:00" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Survolez l'heure ou les minutes et tournez la molette, ou cliquez pour choisir dans la liste."
                       Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="Note (facultatif)" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <TextBox x:Name="NoteBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
        </StackPanel>

    </DockPanel>
</Window>
