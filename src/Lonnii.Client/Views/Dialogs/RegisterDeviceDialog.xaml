<Window x:Class="Lonnii.Client.Views.Dialogs.RegisterDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Autoriser ce poste"
        Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Autoriser ce poste" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Cet ordinateur n'est pas encore autorisé pour cet espace. Un administrateur doit l'ajouter, et cette opération nécessite une connexion Internet." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Email administrateur" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="EmailBox" Margin="0,4,0,0" Padding="8,6" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0" Padding="8,6" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Ce poste" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="DeviceText" Margin="0,4,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="ErrorPanel" Grid.Row="4" Visibility="Collapsed"
                VerticalAlignment="Top"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="RegisterButton" Content="Autoriser" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Register_Click" />
        </StackPanel>
    </Grid>
</Window>
