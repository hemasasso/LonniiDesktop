<Window x:Class="Lonnii.Client.Views.Dialogs.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réinitialiser le mot de passe"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Réinitialiser le mot de passe" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="MemberText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="240" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Réinitialiser" IsDefault="True"
                            Style="{StaticResource DangerButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="20,16">

            <TextBlock Text="Nouveau mot de passe *" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Plain text on purpose: the admin has to read it out to the employee. -->
                <TextBox x:Name="PasswordBox" Grid.Column="0" TextChanged="Password_Changed" />
                <Button Grid.Column="1" Content="Générer" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Generate_Click" />
            </Grid>
            <TextBlock x:Name="PasswordHint" Style="{StaticResource PageSubtitle}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <Border Margin="0,18,0,0" Padding="12,10"
                    Background="{DynamicResource DangerLight}"
                    BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                    CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="Ce que cela implique" FontWeight="SemiBold"
                               Foreground="{DynamicResource Danger}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="• L'ancien mot de passe cesse immédiatement de fonctionner.&#10;• Les sessions ouvertes de cette personne, sur ce poste comme sur les autres, sont fermées.&#10;• Communiquez-lui le nouveau mot de passe : il ne sera plus affiché ensuite." />
                </StackPanel>
            </Border>

        </StackPanel>

    </DockPanel>
</Window>
