<Window x:Class="Lonnii.Client.Views.Dialogs.StockAdjustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajuster le stock"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="ProductName" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="CurrentStock" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Valider" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">

            <TextBlock Text="Type de mouvement" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="MovementBox" SelectedValuePath="Value" SelectionChanged="Movement_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Quantité" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="QuantityBox" TextChanged="Quantity_Changed" LostFocus="Quantity_LostFocus" />

            <Border Margin="0,12,0,0" Padding="12,10"
                    Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="3">
                <StackPanel>
                    <TextBlock x:Name="PreviewText" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewHint" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Motif" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="ReasonBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     ToolTip="Apparaîtra dans l'historique du produit" />

        </StackPanel>

    </DockPanel>
</Window>
