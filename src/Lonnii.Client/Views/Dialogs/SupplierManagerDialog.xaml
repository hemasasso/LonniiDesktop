<Window x:Class="Lonnii.Client.Views.Dialogs.SupplierManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lonnii.Client.Controls"
        Title="Fournisseurs"
        Height="560" Width="820"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Fournisseurs" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Nouveau fournisseur" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                    <Button x:Name="EditButton" Content="Modifier" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Edit_Click" />
                    <Button x:Name="ToggleActiveButton" Content="Désactiver" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="ToggleActive_Click" />
                    <Rectangle Width="1" Margin="10,2" Fill="{DynamicResource Border}" />
                    <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Trier par" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="SortField" Width="110" Margin="0,0,4,0" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Nom" IsSelected="True" />
                        <ComboBoxItem Content="Montant dû" />
                    </ComboBox>
                    <Button x:Name="SortDirectionButton" Content="▲" Width="30" MinWidth="30"
                            Padding="0" Margin="0,0,10,0" ToolTip="Ordre croissant"
                            Style="{StaticResource SecondaryButton}" Click="SortDirection_Click" />
                    <CheckBox x:Name="MontantDuCheck" Content="Montant dû uniquement" VerticalAlignment="Center"
                              Margin="0,0,10,0" Checked="MontantDuFilter_Changed" Unchecked="MontantDuFilter_Changed" />
                    <Grid Width="220">
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 Nom du fournisseur…"
                                   Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="400" HorizontalAlignment="Left" FontSize="12" />
                <Button Content="Fermer" IsCancel="True" IsDefault="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Par page" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PageSizeCombo" Width="70" SelectionChanged="PageSize_Changed">
                        <ComboBoxItem Content="10" IsSelected="True" />
                        <ComboBoxItem Content="15" />
                        <ComboBoxItem Content="20" />
                    </ComboBox>
                </StackPanel>
                <controls:PaginationBar x:Name="Pager" PageChanged="Pager_PageChanged" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- Sort column/direction live in the toolbar above (SortField/SortDirectionButton) -
                 column-click sorting here would only reorder the current page's rows, since
                 SupplierGrid's ItemsSource is a fresh slice every time (see RenderPage). -->
            <DataGrid x:Name="SupplierGrid" RowHeight="36" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False"
                      MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Supplier.Name}" Width="*" />
                    <DataGridTextColumn Header="Contact" Binding="{Binding Supplier.ContactPerson}" Width="*" />
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Supplier.Phone}" Width="140" />
                    <DataGridTextColumn Header="Ville" Binding="{Binding Supplier.City}" Width="120" />
                    <DataGridTextColumn Header="Note" Binding="{Binding RatingDisplay}" Width="80" />
                    <DataGridTextColumn Header="Montant dû" Binding="{Binding MontantDuDisplay}"
                                        SortMemberPath="Supplier.MontantDu" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Supplier.IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Aucun fournisseur" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                               MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Ajoutez un premier fournisseur pour le rattacher à vos produits." />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
