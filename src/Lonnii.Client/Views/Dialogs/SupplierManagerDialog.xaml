<Window x:Class="Lonnii.Client.Views.Dialogs.SupplierManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fournisseurs"
        Height="560" Width="820"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Fournisseurs" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nouveau fournisseur" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                <Button x:Name="EditButton" Content="Modifier" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Edit_Click" />
                <Button x:Name="ToggleActiveButton" Content="Désactiver" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="ToggleActive_Click" />
                <Rectangle Width="1" Margin="10,2" Fill="{DynamicResource Border}" />
                <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="400" HorizontalAlignment="Left" FontSize="12" />
                <Button Content="Fermer" IsCancel="True" IsDefault="True"
                        HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <Grid>
            <DataGrid x:Name="SupplierGrid" RowHeight="36" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Supplier.Name}" Width="*" />
                    <DataGridTextColumn Header="Contact" Binding="{Binding Supplier.ContactPerson}" Width="*" />
                    <DataGridTextColumn Header="Téléphone" Binding="{Binding Supplier.Phone}" Width="140" />
                    <DataGridTextColumn Header="Ville" Binding="{Binding Supplier.City}" Width="120" />
                    <DataGridTextColumn Header="Note" Binding="{Binding RatingDisplay}" Width="80" />
                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Supplier.IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Aucun fournisseur" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                               MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Ajoutez un premier fournisseur pour le rattacher à vos produits." />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
