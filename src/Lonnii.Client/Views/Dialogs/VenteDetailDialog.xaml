<Window x:Class="Lonnii.Client.Views.Dialogs.VenteDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détails de la vente"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,16"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Accent}" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Button Content="Fermer" IsCancel="True" IsDefault="True"
                    HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel x:Name="SectionsPanel" />
        </ScrollViewer>

    </DockPanel>
</Window>
