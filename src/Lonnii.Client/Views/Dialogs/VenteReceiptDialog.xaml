<Window x:Class="Lonnii.Client.Views.Dialogs.VenteReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reçu de vente"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAlt}">

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fermer" IsCancel="True" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="🖨 Imprimer" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Print_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
            <!-- The "paper": also the exact visual PrintVisual prints, so what is on screen
                 is what comes out of the printer. -->
            <Border x:Name="ReceiptPaper" Width="440" Padding="28"
                    Background="White" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>

                    <TextBlock x:Name="CompanyText" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="Black" />
                    <TextBlock Text="Reçu de vente" FontSize="12" HorizontalAlignment="Center"
                               Foreground="#555" Margin="0,2,0,14" />

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="N° vente" Foreground="#555" />
                        <TextBlock x:Name="NumeroText" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="Black" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Date" Foreground="#555" />
                        <TextBlock x:Name="DateText" HorizontalAlignment="Right" Foreground="Black" />
                    </Grid>
                    <StackPanel x:Name="ClientPanel" Margin="0,0,0,4">
                        <Grid>
                            <TextBlock Text="Client" Foreground="#555" />
                            <TextBlock x:Name="ClientText" HorizontalAlignment="Right" Foreground="Black" />
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Article" FontWeight="SemiBold" Foreground="Black" />
                        <TextBlock Grid.Column="1" Text="Qté" FontWeight="SemiBold" Foreground="Black" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="P.U." FontWeight="SemiBold" Foreground="Black" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" Foreground="Black" TextAlignment="Right" />
                    </Grid>

                    <ItemsControl x:Name="ItemsList" />

                    <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Sous-total" Foreground="#555" />
                        <TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" Foreground="Black" />
                    </Grid>
                    <Grid x:Name="RemiseRow" Margin="0,0,0,3" Visibility="Collapsed">
                        <TextBlock Text="Remise globale" Foreground="#555" />
                        <TextBlock x:Name="RemiseText" HorizontalAlignment="Right" Foreground="Black" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="15" Foreground="Black" />
                        <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Right" Foreground="Black" />
                    </Grid>

                    <Border BorderBrush="#CCC" BorderThickness="0,1,0,0" Margin="0,10,0,10" />

                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Mode de paiement" Foreground="#555" />
                        <TextBlock x:Name="ModePaiementText" HorizontalAlignment="Right" Foreground="Black" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Montant payé" Foreground="#555" />
                        <TextBlock x:Name="MontantPayeText" HorizontalAlignment="Right" Foreground="Black" />
                    </Grid>
                    <Grid x:Name="RestantRow" Margin="0,0,0,3" Visibility="Collapsed">
                        <TextBlock Text="Reste à payer" Foreground="#B45309" />
                        <TextBlock x:Name="RestantText" HorizontalAlignment="Right" Foreground="#B45309" FontWeight="SemiBold" />
                    </Grid>

                    <TextBlock Text="Merci de votre achat !" FontSize="12" Foreground="#777"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />

                </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>
</Window>
