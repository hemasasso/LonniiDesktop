<Window x:Class="Lonnii.Client.Views.Dialogs.VenteReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reçu de vente"
        Width="520" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAlt}">

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="TemplateText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fermer" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="PrintButton" Content="🖨 Imprimer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Print_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The paper itself is built in code by ReceiptDocument, in whichever layout the
             workspace chose for this document. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="18">
            <ContentControl x:Name="PaperHost" HorizontalAlignment="Center" VerticalAlignment="Top" />
        </ScrollViewer>

    </DockPanel>
</Window>
