<Window x:Class="Lonnii.Client.Views.Dialogs.VenteReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reçu de vente"
        Width="520" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAlt}">

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fermer" IsCancel="True" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="PrintButton" Content="🖨 Imprimer" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Print_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
            <!-- The "paper": also the exact visual PrintVisual prints, so what is on screen
                 is what comes out of the printer. Same border dashed-line look as Lonnii
                 Business's printed receipt/facture (VentePrintModals.jsx). -->
            <Border x:Name="ReceiptPaper" Width="440" Padding="28"
                    Background="White" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>

                    <!-- Header. The sizes below are the defaults; code-behind overwrites
                         them from the workspace's configured font size (ReceiptTypography),
                         so a shop that has never opened Paramètres prints what is here. -->
                    <Image x:Name="LogoImage" MaxHeight="72" Stretch="Uniform"
                           Margin="0,0,0,10" Visibility="Collapsed" />
                    <TextBlock x:Name="CompanyText" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#4C3B9E"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="DocumentTitleText" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#4C3B9E" Margin="0,4,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="NumeroText" FontSize="11" HorizontalAlignment="Center"
                               Foreground="#333" Margin="0,4,0,0" />
                    <TextBlock x:Name="DateText" FontSize="11" HorizontalAlignment="Center"
                               Foreground="#666" Margin="0,2,0,0" />

                    <Line X1="0" Y1="0" X2="384" Y2="0" Stroke="Black" StrokeThickness="1"
                          StrokeDashArray="4 2" Margin="0,12,0,10" />

                    <!-- Client / Vendeur -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Client:" Foreground="#333" FontSize="12" />
                        <TextBlock x:Name="ClientText" HorizontalAlignment="Right" FontWeight="SemiBold"
                                   FontSize="12" Foreground="Black" />
                    </Grid>
                    <!-- "Vendeur", not "Caissier": this is whoever created the sale
                         (ventes.user_id), same as Lonnii Business's own receipt - a preparer
                         and the cashier who later collects payment can be different people
                         (lonnii-preparer-cashier-flow), and who actually collected each
                         payment is already shown per-row in "Historique des Paiements" below. -->
                    <Grid x:Name="VendeurRow" Margin="0,0,0,3">
                        <TextBlock x:Name="VendeurLabelText" Text="Vendeur:" Foreground="#333" FontSize="12" />
                        <TextBlock x:Name="VendeurText" HorizontalAlignment="Right" FontWeight="SemiBold"
                                   FontSize="12" Foreground="Black" />
                    </Grid>

                    <Line X1="0" Y1="0" X2="384" Y2="0" Stroke="Black" StrokeThickness="1"
                          StrokeDashArray="4 2" Margin="0,10,0,10" />

                    <!-- Items -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Article" FontWeight="SemiBold" FontSize="11" Foreground="Black" />
                        <TextBlock Grid.Column="1" Text="Qte" FontWeight="SemiBold" FontSize="11" Foreground="Black" TextAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="P.U (FCFA)" FontWeight="SemiBold" FontSize="11" Foreground="Black" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Total (FCFA)" FontWeight="SemiBold" FontSize="11" Foreground="Black" TextAlignment="Right" />
                    </Grid>

                    <ItemsControl x:Name="ItemsList" />

                    <Line X1="0" Y1="0" X2="384" Y2="0" Stroke="Black" StrokeThickness="1"
                          StrokeDashArray="4 2" Margin="0,10,0,10" />

                    <!-- Totals -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Sous-total:" FontSize="12" Foreground="#333" />
                        <TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" FontSize="12" Foreground="Black" />
                    </Grid>
                    <Grid x:Name="RemiseRow" Margin="0,0,0,3" Visibility="Collapsed">
                        <TextBlock x:Name="RemiseLabelText" Text="Remise totale:" FontSize="12" Foreground="#E74C3C" />
                        <TextBlock x:Name="RemiseText" HorizontalAlignment="Right" FontSize="12" Foreground="#E74C3C" />
                    </Grid>

                    <Border Background="#F3F3F3" BorderBrush="Black" BorderThickness="1" Padding="10,8" Margin="0,4,0,10">
                        <Grid>
                            <TextBlock x:Name="TotalLabelText" Text="TOTAL:" FontWeight="Bold" FontSize="14" Foreground="Black" />
                            <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Right" Foreground="Black" />
                        </Grid>
                    </Border>

                    <!-- Paid-sale-only: payment summary -->
                    <StackPanel x:Name="PaymentInfoPanel">
                        <Grid x:Name="MontantPayeRow" Margin="0,0,0,3">
                            <TextBlock Text="Total Payé:" FontSize="12" Foreground="#333" />
                            <TextBlock x:Name="MontantPayeText" HorizontalAlignment="Right" FontSize="12" Foreground="Black" />
                        </Grid>
                        <!-- Only when a payment was actually collected by someone other than
                             the Vendeur above (a préparateur builds the cart, a différent
                             caissier settles it later) - otherwise this would just repeat the
                             Vendeur line for every ordinary single-person sale. -->
                        <Grid x:Name="CaissierRow" Margin="0,0,0,3" Visibility="Collapsed">
                            <TextBlock Text="Caissier:" FontSize="12" Foreground="#333" />
                            <TextBlock x:Name="CaissierText" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="Black" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Mode de paiement:" FontSize="12" Foreground="#333" />
                            <TextBlock x:Name="ModePaiementText" HorizontalAlignment="Right" FontSize="12" Foreground="Black" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Statut:" FontSize="12" Foreground="#333" />
                            <TextBlock x:Name="StatutText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="Black" />
                        </Grid>
                        <Grid x:Name="RestantRow" Margin="0,0,0,3" Visibility="Collapsed">
                            <TextBlock Text="Reste à payer:" FontSize="12" Foreground="#B45309" />
                            <TextBlock x:Name="RestantText" HorizontalAlignment="Right" FontSize="12" Foreground="#B45309" FontWeight="SemiBold" />
                        </Grid>
                        <!-- Shown when the client overpaid: the excess becomes a credit note
                             (see lonnii's AvoirAmount) rather than being silently absorbed. -->
                        <Grid x:Name="AvoirRow" Margin="0,0,0,3" Visibility="Collapsed">
                            <TextBlock Text="Avoir client:" FontSize="12" Foreground="#B45309" />
                            <TextBlock x:Name="AvoirText" HorizontalAlignment="Right" FontSize="12" Foreground="#B45309" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>

                    <!-- Facture-only: pay-at-till notice, dashed border like Lonnii Business's -->
                    <Grid x:Name="FactureNoticePanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <Rectangle Stroke="Black" StrokeThickness="1" StrokeDashArray="3 2" RadiusX="2" RadiusY="2" />
                        <StackPanel Margin="10,8">
                            <TextBlock x:Name="FactureNoticeTitleText" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" Foreground="Black"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="FactureNoticeBodyText"
                                       FontSize="11" HorizontalAlignment="Center" Foreground="#333"
                                       Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Avoir-only: unsolded credit note notice, same dashed-border treatment
                         as the facture notice above. -->
                    <Grid x:Name="AvoirNoticePanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <Rectangle Stroke="Black" StrokeThickness="1" StrokeDashArray="3 2" RadiusX="2" RadiusY="2" />
                        <StackPanel Margin="10,8">
                            <TextBlock x:Name="AvoirNoticeTitleText" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" Foreground="Black"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="AvoirNoticeText" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="#333" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Shown only when the sale was settled in more than one instalment
                         (paiements_ventes has more than one row) - mirrors Lonnii Business's
                         VentePrintModals.jsx, which renders this table alongside "Total Payé"
                         above rather than replacing it. -->
                    <StackPanel x:Name="PaymentHistoryPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <Line X1="0" Y1="0" X2="384" Y2="0" Stroke="Black" StrokeThickness="1"
                              StrokeDashArray="4 2" Margin="0,10,0,10" />
                        <TextBlock Text="HISTORIQUE DES PAIEMENTS" FontWeight="Bold" FontSize="11"
                                   Foreground="Black" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="98" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" FontSize="10" Foreground="Black" />
                            <TextBlock Grid.Column="1" Text="Montant (FCFA)" FontWeight="SemiBold" FontSize="10" Foreground="Black" TextAlignment="Right" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="Mode" FontWeight="SemiBold" FontSize="10" Foreground="Black" />
                            <TextBlock Grid.Column="3" Text="Date" FontWeight="SemiBold" FontSize="10" Foreground="Black" />
                            <TextBlock Grid.Column="4" Text="Par" FontWeight="SemiBold" FontSize="10" Foreground="Black" />
                        </Grid>
                        <ItemsControl x:Name="PaymentHistoryList" />
                    </StackPanel>

                    <TextBlock x:Name="FooterText" FontSize="12" FontWeight="SemiBold" Foreground="#4C3B9E"
                               HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <!-- Payment QR, last on the paper so the customer scans it after seeing
                         what they owe. Shown when either the image or its note is configured. -->
                    <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Image x:Name="QrImage" MaxHeight="130" Stretch="Uniform"
                               HorizontalAlignment="Center" />
                        <TextBlock x:Name="QrNoteText" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="#333" Margin="0,5,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>
</Window>
