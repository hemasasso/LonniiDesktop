<Window x:Class="Lonnii.Client.Views.Dialogs.WithdrawCaisseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retirer de la caisse"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="18,14"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Retirer de la caisse" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="220" HorizontalAlignment="Left" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="Retirer" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Withdraw_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="18,16">
            <TextBlock Text="Montant à retirer (espèces)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MontantBox" />

            <TextBlock Text="Motif" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="MotifBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" ToolTip="Ex. : achat de fournitures, livraison, dépannage…" />
        </StackPanel>

    </DockPanel>
</Window>
