<Window x:Class="Lonnii.Client.Views.FirstLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Activation"
        Height="440" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Activer cette installation" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Ouvrez le fichier d'identifiants que Lonnii vous a remis, puis saisissez la phrase secrète communiquée séparément." />
        </StackPanel>

        <!-- The file -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Fichier d'identifiants" Style="{StaticResource FieldLabel}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FileBox" Grid.Column="0" IsReadOnly="True"
                         VerticalContentAlignment="Center" Padding="8,6" />
                <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
            </Grid>
        </StackPanel>

        <!-- The passphrase -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Phrase secrète" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="PassphraseBox" Margin="0,4,0,0" Padding="8,6" />
        </StackPanel>

        <!--
            Shown rather than hidden: a shop that has to call support should be able to read
            this number out, and it is what identifies the machine in their device list.
        -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Ce poste" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="DeviceText" Margin="0,4,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="ErrorPanel" Grid.Row="4" Visibility="Collapsed"
                VerticalAlignment="Top"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="BusyText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"
                       Text="Activation en cours…" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ActivateButton" Content="Activer" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Activate_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
