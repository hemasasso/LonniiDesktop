<Window x:Class="Lonnii.Client.Views.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Choisir un espace"
        Height="530" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Espaces de travail" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Choisissez l'espace dans lequel travailler." />
        </StackPanel>

        <!--
            Cards rather than a table, matching how the web app presents workspaces, but
            sized as small tiles: a till operator picks one by sight, and a shop has a
            handful of spaces, not a list worth sorting.
        -->
        <ListBox x:Name="GroupList" Grid.Row="1"
                 MouseDoubleClick="List_DoubleClick"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <!-- Strips the default row highlight so selection reads as an accented card. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,10,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Width="170" Height="146"
                                        CornerRadius="6" Padding="12"
                                        Background="{DynamicResource SurfaceAlt}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource BorderStrong}" />
                                    </Trigger>
                                    <!-- After IsMouseOver, so selection wins while hovering. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="Background"
                                                Value="{DynamicResource AccentLight}" />
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource Accent}" />
                                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Card" Property="Padding" Value="11" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Avatar and, for the space's creator, a crown. -->
                        <Grid Grid.Row="0">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}">
                                <TextBlock Text="{Binding Nom, Converter={StaticResource Initial}}"
                                           Foreground="{DynamicResource TextOnAccent}"
                                           FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="&#x1F451;" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       ToolTip="Vous avez créé cet espace"
                                       Visibility="{Binding IsAdminGeneral,
                                                    Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding Nom}" Margin="0,8,0,0"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"
                                   ToolTip="{Binding Nom}" />

                        <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Role, Converter={StaticResource RoleLabel}}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}">
                            <Run Text="{Binding MemberCount, Mode=OneWay}" />
                            <Run Text="membres" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="EmptyPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Aucun espace" FontWeight="SemiBold" FontSize="15"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextAlignment="Center"
                           Margin="0,6,0,0" MaxWidth="360" TextWrapping="Wrap"
                           Text="Vous n'appartenez à aucun espace. Créez le vôtre, ou demandez à un administrateur de vous ajouter au sien." />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Créer un espace…" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}" Click="Create_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OpenButton" Content="Ouvrir" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Open_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
