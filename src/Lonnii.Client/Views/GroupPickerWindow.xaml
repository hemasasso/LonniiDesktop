<Window x:Class="Lonnii.Client.Views.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lonnii — Choisir un espace"
        Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Espaces de travail" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Choisissez l'espace dans lequel travailler." />
        </StackPanel>

        <DataGrid x:Name="GroupGrid" Grid.Row="1"
                  MouseDoubleClick="Grid_DoubleClick"
                  BorderThickness="1" BorderBrush="{DynamicResource Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Espace" Binding="{Binding Nom}" Width="*" />
                <DataGridTextColumn Header="Rôle" Width="150"
                                    Binding="{Binding Role, Converter={StaticResource RoleLabel}}" />
                <DataGridTextColumn Header="Membres" Binding="{Binding MemberCount}" Width="80" />
                <DataGridCheckBoxColumn Header="Gestion" Binding="{Binding GestionAccess}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="EmptyPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Aucun espace" FontWeight="SemiBold" FontSize="15"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource PageSubtitle}" TextAlignment="Center"
                           Margin="0,6,0,0" MaxWidth="360" TextWrapping="Wrap"
                           Text="Vous n'appartenez à aucun espace. Créez le vôtre, ou demandez à un administrateur de vous ajouter au sien." />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                CornerRadius="3" Padding="10,8">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Créer un espace…" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}" Click="Create_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OpenButton" Content="Ouvrir" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Open_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
