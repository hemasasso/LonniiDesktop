<UserControl x:Class="Lonnii.Client.Views.Modules.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Audit · Planning &amp; Présences" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource PageSubtitle}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                            <TextBlock Text="Actualiser" Style="{StaticResource ButtonContentText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Today at a glance -->
        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="14,14,14,4">
            <Border Margin="4" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                <StackPanel>
                    <TextBlock Text="EN LIGNE" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="OnlineCount" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Success}" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                <StackPanel>
                    <TextBlock Text="EN RETARD" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="LateCount" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                <StackPanel>
                    <TextBlock Text="ABSENTS" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="AbsentCount" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Danger}" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                <StackPanel>
                    <TextBlock Text="PRÉVUS AUJOURD'HUI" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="PlannedCount" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                <StackPanel>
                    <TextBlock Text="PRODUCTIVITÉ MOYENNE" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="ProductivityAverage" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock DockPanel.Dock="Top" Margin="18,4,18,8" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                   Text="Les horaires prévus viennent du Programme. Retard au-delà de 5 minutes après l'heure prévue ; absent après 30 minutes sans connexion. Double-cliquez sur un membre pour son historique sur 30 jours." />

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="18,0,18,14">
            <DataGrid x:Name="AttendanceGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="46"
                      MouseDoubleClick="AttendanceGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Membre" Width="*" MinWidth="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RoleDisplay}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Statut" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Prévu aujourd'hui" Width="130" Binding="{Binding ScheduleDisplay}" />
                    <DataGridTextColumn Header="Arrivée" Width="70" Binding="{Binding ArrivalDisplay}" />
                    <DataGridTextColumn Header="Retard" Width="70" Binding="{Binding RetardDisplay}" />
                    <DataGridTextColumn Header="Dernière activité" Width="120" Binding="{Binding LastSeenDisplay}" />
                    <DataGridTextColumn Header="Module" Width="110" Binding="{Binding ModuleDisplay}" />
                    <DataGridTextColumn Header="Poste" Width="120" Binding="{Binding DeviceDisplay}" />
                    <DataGridTextColumn Header="Semaine" Width="110" Binding="{Binding WeekDisplay}" />
                    <DataGridTemplateColumn Header="Productivité" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProductivityValue, Mode=OneWay}"
                                                 Foreground="{Binding ProductivityBrush}" Visibility="{Binding ProductivityVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProductivityDisplay}" TextAlignment="Right"
                                               FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                        Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                        Foreground="{DynamicResource TextPrimary}"
                                        ToolTip="Historique sur 30 jours" Click="History_Click" Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <TextBlock Text="Aucun membre dans cet espace." Style="{StaticResource PageSubtitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
