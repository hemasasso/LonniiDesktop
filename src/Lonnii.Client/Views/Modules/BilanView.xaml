<UserControl x:Class="Lonnii.Client.Views.Modules.BilanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bilan &amp; Résultat" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrintButton" Content="🖨 Imprimer" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="Print_Click" />
                    <Button x:Name="ExportButton" Content="⬇ Exporter" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="Export_Click" />
                    <Button x:Name="AddCompteButton" Content="＋ Compte" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="AddCompte_Click" />
                    <Button x:Name="AddEcritureButton" Content="＋ Nouvelle Écriture"
                            Style="{StaticResource PrimaryButton}" Click="AddEcriture_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Module tabs + year -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BilanTabButton" Tag="bilan" Margin="0,0,6,0"
                            Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                        <TextBlock Text="Bilan" Style="{StaticResource ButtonContentText}" />
                    </Button>
                    <Button x:Name="ResultatTabButton" Tag="resultat" Margin="0,0,6,0"
                            Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                        <TextBlock Text="Compte de résultat" Style="{StaticResource ButtonContentText}" />
                    </Button>
                    <Button x:Name="EcrituresTabButton" Tag="ecritures" Margin="0,0,6,0"
                            Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                        <TextBlock Text="Écritures" Style="{StaticResource ButtonContentText}" />
                    </Button>
                    <Button x:Name="ComptesTabButton" Tag="comptes"
                            Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                        <TextBlock Text="Plan comptable" Style="{StaticResource ButtonContentText}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="StatusBadge" CornerRadius="10" Padding="10,3" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Exercice" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondary}" />
                    <ComboBox x:Name="YearCombo" Width="100" SelectionChanged="Year_Changed" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="0"
                            Padding="10,7" ToolTip="Actualiser" Click="Refresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ButtonContentText}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <Grid>

            <!-- Bilan -->
            <ScrollViewer x:Name="BilanPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ActifColumn" Grid.Column="0" />
                        <StackPanel x:Name="PassifColumn" Grid.Column="2" />
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TotalActifBorder" Grid.Column="0" />
                        <Border x:Name="TotalPassifBorder" Grid.Column="2" />
                    </Grid>

                    <Border x:Name="EquilibreBanner" Margin="0,12,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="EquilibreText" FontWeight="SemiBold" />
                            <TextBlock x:Name="EquilibreHint" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Compte de résultat -->
            <ScrollViewer x:Name="ResultatPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Border Padding="14,12" CornerRadius="8" BorderThickness="1" Margin="0,0,0,14"
                            Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}">
                        <StackPanel>
                            <TextBlock x:Name="IntegrationTitle" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <WrapPanel x:Name="IntegrationPanel" />
                            <TextBlock x:Name="IntegrationNote" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ProduitsColumn" Grid.Column="0" />
                        <StackPanel x:Name="ChargesColumn" Grid.Column="2" />
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TotalProduitsBorder" Grid.Column="0" />
                        <Border x:Name="TotalChargesBorder" Grid.Column="2" />
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                        <StackPanel x:Name="SoldesPanel" />
                    </Border>

                    <Border x:Name="NetBanner" Margin="0,14,0,0" Padding="18,14" CornerRadius="8" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="NetTitle" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NetValue" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock x:Name="NetDetail" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Écritures -->
            <DockPanel x:Name="EcrituresPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="EcritureCompteFilter" Width="260" Margin="0,0,10,0"
                                  MaxDropDownHeight="320" SelectionChanged="EcrituresFilter_Changed" />
                        <CheckBox x:Name="EcrituresYearOnly" Content="Exercice sélectionné seulement" IsChecked="True"
                                  VerticalAlignment="Center" Checked="EcrituresFilter_Changed" Unchecked="EcrituresFilter_Changed" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="14,6" Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="EcrituresTotalText" Style="{StaticResource PageSubtitle}" Margin="0" />
                </Border>

                <Grid>
                    <DataGrid x:Name="EcrituresGrid" MouseDoubleClick="EcrituresGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Width="90" Binding="{Binding Date}" />
                            <DataGridTextColumn Header="Compte" Width="220" Binding="{Binding Compte}" />
                            <DataGridTextColumn Header="Libellé" Width="*" Binding="{Binding Libelle}" />
                            <DataGridTextColumn Header="Débit" Width="120" Binding="{Binding Debit}"
                                                ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="Crédit" Width="120" Binding="{Binding Credit}"
                                                ElementStyle="{StaticResource NumericCell}" />
                            <DataGridTextColumn Header="Réf." Width="90" Binding="{Binding Reference}" />
                            <DataGridTextColumn Header="Par" Width="110" Binding="{Binding CreatedByName}" />
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    ToolTip="Modifier" Visibility="{Binding CanEdit}"
                                                    Click="EditEcriture_Click" Tag="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource Danger}"
                                                    ToolTip="Supprimer" Visibility="{Binding CanDelete}"
                                                    Click="DeleteEcriture_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="EcrituresEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <TextBlock Text="Aucune écriture." Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Plan comptable -->
            <Grid x:Name="ComptesPanel" Visibility="Collapsed" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Comptes du bilan" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid x:Name="BilanComptesGrid" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Width="55" Binding="{Binding Numero}" />
                            <DataGridTextColumn Header="Libellé" Width="*" Binding="{Binding Libelle}" />
                            <DataGridTextColumn Header="Type" Width="130" Binding="{Binding Type}" />
                            <DataGridTextColumn Header="" Width="60" Binding="{Binding Systeme}" />
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    ToolTip="Modifier" Visibility="{Binding CanEdit}"
                                                    Click="EditCompte_Click" Tag="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource Danger}"
                                                    ToolTip="Supprimer" Visibility="{Binding CanDelete}"
                                                    Click="DeleteCompte_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Comptes de résultat" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid x:Name="ResultatComptesGrid" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Width="55" Binding="{Binding Numero}" />
                            <DataGridTextColumn Header="Libellé" Width="*" Binding="{Binding Libelle}" />
                            <DataGridTextColumn Header="Type" Width="150" Binding="{Binding Type}" />
                            <DataGridTextColumn Header="" Width="60" Binding="{Binding Systeme}" />
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    ToolTip="Modifier" Visibility="{Binding CanEdit}"
                                                    Click="EditCompte_Click" Tag="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="24"
                                                    Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Foreground="{DynamicResource Danger}"
                                                    ToolTip="Supprimer" Visibility="{Binding CanDelete}"
                                                    Click="DeleteCompte_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

        </Grid>

    </DockPanel>
</UserControl>
