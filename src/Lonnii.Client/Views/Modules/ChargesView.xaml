<UserControl x:Class="Lonnii.Client.Views.Modules.ChargesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xEC59;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Gestion des Charges" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExportButton" Content="⬇ Exporter" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="Export_Click" />
                    <Button x:Name="AddButton" Content="＋ Nouvelle Charge"
                            Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Module tabs -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ChargesTabButton" Tag="charges" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Charges" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="RecurringTabButton" Tag="recurring" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Récurrentes" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="CategoriesTabButton" Tag="categories" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Catégories" Style="{StaticResource ButtonContentText}" />
                </Button>
                <Button x:Name="AnalyticsTabButton" Tag="analytics"
                        Style="{StaticResource ModuleTabButton}" Click="Tab_Click">
                    <TextBlock Text="Analyse" Style="{StaticResource ButtonContentText}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <Grid>

        <!-- Charges -->
        <Grid x:Name="ChargesPanel">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CategoryFilterCombo" Width="180" Margin="0,0,8,0"
                                      SelectionChanged="Filters_Changed" DisplayMemberPath="Nom" />
                            <ComboBox x:Name="DateFilterCombo" Width="170"
                                      SelectionChanged="DateFilter_Changed">
                                <ComboBoxItem Content="Ce mois" Tag="month" IsSelected="True" />
                                <ComboBoxItem Content="Cette année" Tag="year" />
                                <ComboBoxItem Content="7 derniers jours" Tag="week" />
                                <ComboBoxItem Content="Toutes" Tag="all" />
                                <ComboBoxItem Content="Période personnalisée" Tag="custom" />
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RefreshCharges_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                           Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                                <TextBlock Text="Actualiser" Style="{StaticResource ButtonContentText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid>
                    <DataGrid x:Name="ChargesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              MouseDoubleClick="ChargesGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Width="90"
                                                Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                            <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" />
                            <DataGridTemplateColumn Header="Catégorie" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"
                                                    Background="{Binding CategoryBrush}" />
                                            <TextBlock Text="{Binding Categorie}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Width="80" Binding="{Binding TypeDisplay}" />
                            <DataGridTextColumn Header="Montant" Width="120" Binding="{Binding MontantDisplay}" />
                            <DataGridTextColumn Header="Récurrente" Width="90" Binding="{Binding RecurringDisplay}" />
                            <DataGridTextColumn Header="Créé par" Width="120" Binding="{Binding CreatedByName}" />
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                    Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    ToolTip="Modifier" Visibility="{Binding CanEdit}"
                                                    Click="EditCharge_Click" Tag="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                    Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    ToolTip="Supprimer" Visibility="{Binding CanDelete}"
                                                    Click="DeleteCharge_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="ChargesEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Aucune charge sur cette période." Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Récurrentes -->
        <Grid x:Name="RecurringPanel" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <TextBlock Text="Charges fixes qui se recréent automatiquement chaque mois."
                               Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" />
                </Border>

                <Grid>
                    <DataGrid x:Name="RecurringGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" />
                            <DataGridTextColumn Header="Catégorie" Width="140" Binding="{Binding Categorie}" />
                            <DataGridTextColumn Header="Montant" Width="120" Binding="{Binding MontantDisplay}" />
                            <DataGridTextColumn Header="Création" Width="170" Binding="{Binding ScheduleDisplay}" />
                            <DataGridTextColumn Header="Jusqu'au" Width="100" Binding="{Binding EndDateDisplay}" />
                            <DataGridTextColumn Header="Statut" Width="90" Binding="{Binding StatusDisplay}" />
                            <DataGridTemplateColumn Header="" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"
                                                    Margin="0,0,6,0" Content="Détails"
                                                    Click="ChargeDetails_Click" Tag="{Binding}" />
                                            <Button Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"
                                                    Content="{Binding ToggleLabel}" Visibility="{Binding CanEdit}"
                                                    Click="ToggleRecurring_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="RecurringEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <TextBlock Text="Aucune charge récurrente." Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Catégories -->
        <Grid x:Name="CategoriesPanel" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Catégories utilisées pour classer vos charges."
                                   Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" />
                        <Button x:Name="AddCategoryButton" Grid.Column="1" Content="＋ Catégorie"
                                Style="{StaticResource SecondaryButton}" Click="AddCategory_Click" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="CategoriesWrap" Margin="14" />
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Analyses -->
        <Grid x:Name="AnalyticsPanel" Visibility="Collapsed">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="YearCombo" Width="120" HorizontalAlignment="Left"
                                  SelectionChanged="Year_Changed" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RefreshAnalytics_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                           Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                                <TextBlock Text="Actualiser" Style="{StaticResource ButtonContentText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <WrapPanel x:Name="StatsTilesPanel" Orientation="Horizontal" Margin="0,0,0,6" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,5,10" Padding="14"
                                    CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <TextBlock Text="Charges par Catégorie" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <lvc:PieChart x:Name="CategoryPieChart" Grid.Column="0"
                                                      Background="Transparent" TooltipPosition="Hidden" />
                                        <StackPanel x:Name="CategoryLegendPanel" Grid.Column="1"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock x:Name="CategoryEmptyText" Text="Aucune donnée disponible."
                                                   Grid.ColumnSpan="2" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource PageSubtitle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="5,0,0,10" Padding="14"
                                    CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <TextBlock Text="Charges par Trimestre" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="260">
                                        <lvc:CartesianChart x:Name="QuarterChart" Background="Transparent" />
                                        <TextBlock x:Name="QuarterEmptyText" Text="Aucune donnée disponible."
                                                   Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource PageSubtitle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                            <StackPanel>
                                <TextBlock x:Name="MonthChartTitle" Text="Évolution Mensuelle des Charges"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Height="240">
                                    <lvc:CartesianChart x:Name="MonthChart" Background="Transparent" />
                                    <TextBlock x:Name="MonthEmptyText" Text="Aucune donnée disponible."
                                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource PageSubtitle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        </Grid>

    </DockPanel>
</UserControl>
