<UserControl x:Class="Lonnii.Client.Views.Modules.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Options — Membres et privilèges" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Ajouter un membre"
                        Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                <Button x:Name="PrivilegesButton" Content="Gérer les privilèges…" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Privileges_Click" />
                <Button x:Name="RoleButton" Content="Changer le rôle…" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Role_Click" />
                <Button x:Name="PasswordButton" Content="Mot de passe…" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Password_Click" />
                <Button x:Name="RemoveButton" Content="Retirer" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="Remove_Click" />
                <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Border}" />
                <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{StaticResource DangerLight}"
                BorderBrush="{StaticResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="MemberGrid" SelectionChanged="Grid_SelectionChanged"
                  MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="150" />
                <DataGridTextColumn Header="Prénom" Binding="{Binding FirstName}" Width="130" />
                <DataGridTemplateColumn Header="Rôle" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"
                                                Value="{Binding Role, Converter={StaticResource RoleLabel}}" />
                                        <Style.Triggers>
                                            <!-- The creator outranks every assigned role. -->
                                            <DataTrigger Binding="{Binding IsAdminGeneral}" Value="True">
                                                <Setter Property="Text" Value="Administrateur Général" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Membre depuis" Width="130"
                                    Binding="{Binding JoinedAt, StringFormat={}{0:dd/MM/yyyy}}" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
