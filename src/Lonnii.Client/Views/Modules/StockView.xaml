<UserControl x:Class="Lonnii.Client.Views.Modules.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                    <!-- Segoe MDL2 Assets, not the 📦 emoji: an emoji keeps its own built-in
                         colours regardless of Foreground, reading dark/low-contrast on this
                         Accent-coloured badge - same fix as the Ventes header. -->
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Gestion de Stock" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
          Toolbar: add product, the Stock/Analyse tabs, search/filter/sort and the view
          toggle all on one wrapping row - it wraps rather than clips at the window's
          minimum width, since there is no room left for a second row the way the old
          two-row toolbar had.
        -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <WrapPanel x:Name="StockToolbar" Orientation="Horizontal">

                <Button x:Name="AddButton" Content="＋ Ajouter Produit" Margin="0,0,16,6"
                        Style="{StaticResource SecondaryButton}" Click="Add_Click" />

                <Button x:Name="StockTabButton" Margin="0,0,6,6"
                        Style="{StaticResource ModuleTabButton}" Click="StockTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                   Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                        <TextBlock Text="Stock" Style="{StaticResource ButtonContentText}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AnalyseTabButton" Margin="0,0,20,6"
                        Style="{StaticResource ModuleTabButton}" Click="AnalyseTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                   Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                        <TextBlock Text="Analyse" Style="{StaticResource ButtonContentText}" />
                    </StackPanel>
                </Button>

                <StackPanel x:Name="StockToolsPanel" Orientation="Horizontal">
                    <Grid Width="220" Margin="0,0,10,6">
                        <TextBox x:Name="SearchBox"
                                 ToolTip="Rechercher par nom, SKU ou code-barres"
                                 TextChanged="Search_TextChanged"
                                 KeyDown="Search_KeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 Rechercher un produit…"
                                   Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <!--
                      An explicit ItemTemplate, not DisplayMemberPath: our custom ComboBox
                      template (see Theme/Styles.xaml) relies on WPF auto-generating
                      SelectionBoxItemTemplate from DisplayMemberPath, which does not
                      reliably happen on a from-scratch ControlTemplate - the closed box
                      fell back to the item's raw ToString(). An explicit template is
                      always honoured for both the dropdown and the closed box.
                    -->
                    <ComboBox x:Name="CategoryFilter" Width="160" Margin="0,0,10,6"
                              SelectedValuePath="Id" SelectionChanged="Filter_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox x:Name="SortField" Width="120" Margin="0,0,4,6"
                              SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Nom" IsSelected="True" />
                        <ComboBoxItem Content="Quantité" />
                        <ComboBoxItem Content="Prix d'achat" />
                        <ComboBoxItem Content="Prix de vente" />
                    </ComboBox>
                    <Button x:Name="SortDirectionButton" Content="▲" Width="30" MinWidth="30"
                            Padding="0" Margin="0,0,10,6" ToolTip="Ordre croissant"
                            Style="{StaticResource SecondaryButton}" Click="SortDirection_Click" />

                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="IconViewButton" Width="30" Padding="0"
                                    Style="{StaticResource PrimaryButton}" ToolTip="Vue en icônes"
                                    Click="IconView_Click">
                                <TextBlock Text="▦" Style="{StaticResource ButtonContentText}" />
                            </Button>
                            <Button x:Name="ListViewButton" Width="30" Padding="0" Margin="2,0,0,0"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Vue en liste"
                                    Click="ListView_Click">
                                <TextBlock Text="☰" Style="{StaticResource ButtonContentText}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="LowStockCheck" Content="Stock bas uniquement"
                              VerticalAlignment="Center" Margin="0,0,10,6"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />

                    <Button x:Name="MoreButton" Content="⋯ Plus" Margin="0,0,10,6"
                            Style="{StaticResource SecondaryButton}" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" Placement="Bottom">
                                <MenuItem x:Name="EditMenuItem" Header="Modifier" Click="Edit_Click" />
                                <MenuItem x:Name="AdjustMenuItem" Header="Ajuster le stock" Click="Adjust_Click" />
                                <MenuItem x:Name="HistoryMenuItem" Header="Historique" Click="History_Click" />
                                <MenuItem x:Name="DeleteMenuItem" Header="Supprimer" Click="Delete_Click" />
                                <Separator />
                                <MenuItem x:Name="CategoriesMenuItem" Header="Catégories…" Click="Categories_Click" />
                                <MenuItem Header="Actualiser" Click="Refresh_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="ExportButton" Content="📤 Exporter" Margin="0,0,0,6"
                            Style="{StaticResource SecondaryButton}" Click="Export_Click" />
                </StackPanel>

                <!-- Analyse's own filter - separate from StockToolsPanel above, which
                     filters the product list; this one only ever affects what the Analyse
                     tab's charts are computed over. Same toolbar row, same place, so
                     switching tabs swaps one filter row for the other rather than making
                     the user go looking for it. -->
                <StackPanel x:Name="AnalyseToolsPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="AnalyseCategoryFilter" Width="180" Margin="0,0,10,6"
                              SelectedValuePath="Id" SelectionChanged="AnalyseFilter_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox x:Name="AnalyseLowStockCheck" Content="Stock bas uniquement"
                              VerticalAlignment="Center" Margin="0,0,20,6"
                              Checked="AnalyseFilter_Changed" Unchecked="AnalyseFilter_Changed" />

                    <!-- A visible separator, not just margin, so the two filter groups
                         (product filters vs. the movement table's own date range) read as
                         two distinct groups rather than one crowded row. -->
                    <Border Width="1" Margin="0,2,20,8" Background="{DynamicResource Border}" />

                    <!-- Only affects the "Mouvements de stock" table below - the rest of
                         Analyse is a stock snapshot, not a period, so a date range on it
                         would not mean anything. Collapsed entirely without
                         can_view_stock_history, same as the table it filters. -->
                    <StackPanel x:Name="MovementFilterPanel" Orientation="Horizontal">
                        <TextBlock Text="Mouvements du" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <DatePicker x:Name="MovementDateDebutPicker" Width="120" Margin="0,0,10,6"
                                    SelectedDateChanged="MovementFilter_Changed" />
                        <TextBlock Text="au" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <DatePicker x:Name="MovementDateFinPicker" Width="120" Margin="0,0,10,6"
                                    SelectedDateChanged="MovementFilter_Changed" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- Pagination -->
        <Border x:Name="PaginationPanel" DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrevPageButton" Content="◀ Précédent" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" MinWidth="90" TextAlignment="Center" />
                <Button x:Name="NextPageButton" Content="Suivant ▶" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="NextPage_Click" />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Grid>
            <Grid x:Name="StockContentGrid" PreviewMouseLeftButtonDown="StockContentGrid_PreviewMouseLeftButtonDown">
            <DataGrid x:Name="ProductGrid" MouseDoubleClick="Grid_DoubleClick"
                      SelectionChanged="Grid_SelectionChanged"
                      PreviewMouseRightButtonDown="ProductGrid_PreviewMouseRightButtonDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="130" />

                    <DataGridTemplateColumn Header="Quantité" Width="90" SortMemberPath="Quantity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantityDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                            <Style.Triggers>
                                                <!-- Low stock is the one thing a shopkeeper scans for. -->
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Seuil" Binding="{Binding MinimumThreshold}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Prix d'achat" Width="130"
                                        Binding="{Binding CostPrice, Converter={StaticResource Currency}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Prix de vente" Width="130"
                                        Binding="{Binding Price, Converter={StaticResource Currency}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Emplacement" Binding="{Binding StorageLocation}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer x:Name="IconScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="IconGrid" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="IconGrid_SelectionChanged"
                         MouseDoubleClick="IconGrid_MouseDoubleClick"
                         PreviewMouseRightButtonDown="IconGrid_PreviewMouseRightButtonDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="12" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The box is the photo only: its own border and rounded corners
                                 on all four sides. Name, price and stock sit beneath it, on
                                 the transparent tile background, not sharing the photo's box.
                                 Selection highlights that box rather than a card that no
                                 longer exists around the text. -->
                            <StackPanel Width="150">
                                <!-- SurfaceAlt only behind the placeholder icon (set by the
                                     first DataTemplate.Trigger below). A real photo's own
                                     background is white, and Uniform stretch can letterbox a
                                     non-matching aspect ratio, so a grey SurfaceAlt fill would
                                     show as bands down the sides; white makes it invisible. -->
                                <Border x:Name="PhotoBox" Width="150" Height="100"
                                        Background="White"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}" />
                                        <!-- Uniform, not UniformToFill: a fill crops to the box,
                                             and product photos often carry a lot of empty margin
                                             around the product, so a crop can slice through the
                                             product itself instead of the margin. Uniform always
                                             shows the whole photo. -->
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="2,8,2,0">
                                    <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Product.Name}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Product.Price, Converter={StaticResource Currency}}"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Run Text="Qté : " />
                                            <Run Text="{Binding Product.QuantityDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <!-- Declared before the selection trigger below: when both
                                     conditions hold (a selected product with no photo), the
                                     later trigger's Background setter wins, so selection still
                                     shows through instead of the placeholder grey. -->
                                <DataTrigger Binding="{Binding HasNoThumbnail}" Value="True">
                                    <Setter TargetName="PhotoBox" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="PhotoBox" Property="Background" Value="{DynamicResource AccentLight}" />
                                    <Setter TargetName="PhotoBox" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="PhotoBox" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Border x:Name="EmptyPanel" Visibility="Collapsed"
                    Background="{DynamicResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="Aucun produit" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource PageSubtitle}"
                               TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#66FFFFFF">
                <TextBlock Text="Chargement…" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource TextSecondary}" />
            </Border>
            </Grid>

            <!-- Analyse tab: numbers and charts over the whole catalogue, filtered by its own
                 controls in the toolbar above (AnalyseToolsPanel) - independent of the Stock
                 tab's filter, so looking at one never disturbs the other. Unconstrained
                 width: nothing here reads better narrow, so it fills whatever room the
                 window gives it. -->
            <Border x:Name="AnalysePanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Aperçu du stock" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Calculé sur l'ensemble du catalogue, selon le filtre ci-dessus."
                                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />

                        <WrapPanel x:Name="AnalyseStatsPanel" Orientation="Horizontal" Margin="0,0,0,6" />

                        <!-- Stock value by category / low-stock health -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,5,10" Padding="14"
                                    CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <TextBlock Text="Valeur du Stock par Catégorie" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <!-- LiveCharts' own legend and tooltip are SkiaSharp-rendered
                                             and read blurry at most Windows display scales - same
                                             reasoning as Ventes' Statistiques charts. -->
                                        <lvc:PieChart x:Name="CategoryValuePieChart" Grid.Column="0"
                                                      Background="Transparent" TooltipPosition="Hidden" />
                                        <StackPanel x:Name="CategoryValueLegendPanel" Grid.Column="1"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock x:Name="CategoryValueEmptyText" Text="Aucune donnée disponible."
                                                   Grid.ColumnSpan="2"
                                                   Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource PageSubtitle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="5,0,0,10" Padding="14"
                                    CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <TextBlock Text="État du Stock" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="260">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <lvc:PieChart x:Name="StockHealthPieChart" Grid.Column="0"
                                                      Background="Transparent" TooltipPosition="Hidden" />
                                        <StackPanel x:Name="StockHealthLegendPanel" Grid.Column="1"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock x:Name="StockHealthEmptyText" Text="Aucune donnée disponible."
                                                   Grid.ColumnSpan="2"
                                                   Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource PageSubtitle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Which products tie up the most stock value -->
                        <Border Padding="14" CornerRadius="8" BorderThickness="1" Margin="0,0,0,10"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                            <StackPanel>
                                <TextBlock x:Name="TopStockValueTitle" Text="Produits Immobilisant le Plus de Valeur"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid Height="260">
                                    <lvc:CartesianChart x:Name="TopStockValueChart" Background="Transparent" />
                                    <TextBlock x:Name="TopStockValueEmptyText" Text="Aucun produit."
                                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource PageSubtitle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Every product's quantity and stock value, for the same filter as
                             the charts above - the numbers behind them, one row per product. -->
                        <Border Padding="14" CornerRadius="8" BorderThickness="1" Margin="0,0,0,10"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                            <StackPanel>
                                <TextBlock Text="Quantités par Produit" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <DataGrid x:Name="ProductQuantityGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          MaxHeight="360" CanUserSortColumns="True"
                                          PreviewMouseWheel="AnalyseGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="*" />
                                        <DataGridTextColumn Header="Quantité" Binding="{Binding QuantityDisplay}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Valeur (achat)" Binding="{Binding AchatValueDisplay}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Valeur (vente)" Binding="{Binding SaleValueDisplay}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn x:Name="ProductMargeColumn" Header="Marge" Binding="{Binding MargeDisplay}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="ProductQuantityEmptyText" Text="Aucun produit."
                                           Visibility="Collapsed" HorizontalAlignment="Center"
                                           Margin="0,20,0,20" Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                        </Border>

                        <!-- Mouvements de stock: how many, how much quantity, how much cost per
                             type - collapsed entirely without can_view_stock_history. -->
                        <Border x:Name="MovementStatsPanel" Padding="14" CornerRadius="8" BorderThickness="1" Margin="0,0,0,10"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                            <StackPanel>
                                <TextBlock Text="Mouvements de Stock" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <DataGrid x:Name="MovementStatsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          PreviewMouseWheel="AnalyseGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mouvement" Binding="{Binding Label}" Width="2*" />
                                        <DataGridTextColumn Header="Nombre" Binding="{Binding Count}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Quantité" Binding="{Binding QuantityDisplay}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Coût" Binding="{Binding CostDisplay}" Width="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="MovementStatsEmptyText" Text="Aucun mouvement sur cette période."
                                           Visibility="Collapsed" HorizontalAlignment="Center"
                                           Margin="0,20,0,20" Style="{StaticResource PageSubtitle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
