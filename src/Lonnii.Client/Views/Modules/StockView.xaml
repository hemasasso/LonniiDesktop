<UserControl x:Class="Lonnii.Client.Views.Modules.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                    <TextBlock Text="📦" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Gestion de Stock" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
          Toolbar: add product, the Stock/Analyse tabs, search/filter/sort and the view
          toggle all on one wrapping row - it wraps rather than clips at the window's
          minimum width, since there is no room left for a second row the way the old
          two-row toolbar had.
        -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <WrapPanel x:Name="StockToolbar" Orientation="Horizontal">

                <Button x:Name="AddButton" Content="＋ Ajouter Produit" Margin="0,0,16,6"
                        Style="{StaticResource SecondaryButton}" Click="Add_Click" />

                <Button x:Name="StockTabButton" Content="📦 Stock" Margin="0,0,6,6"
                        Style="{StaticResource ModuleTabButton}" Click="StockTab_Click" />
                <Button x:Name="AnalyseTabButton" Content="📈 Analyse" Margin="0,0,20,6"
                        Style="{StaticResource ModuleTabButton}" Click="AnalyseTab_Click" />

                <StackPanel x:Name="StockToolsPanel" Orientation="Horizontal">
                    <Grid Width="220" Margin="0,0,10,6">
                        <TextBox x:Name="SearchBox"
                                 ToolTip="Rechercher par nom, SKU ou code-barres"
                                 TextChanged="Search_TextChanged"
                                 KeyDown="Search_KeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 Rechercher un produit…"
                                   Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <!--
                      An explicit ItemTemplate, not DisplayMemberPath: our custom ComboBox
                      template (see Theme/Styles.xaml) relies on WPF auto-generating
                      SelectionBoxItemTemplate from DisplayMemberPath, which does not
                      reliably happen on a from-scratch ControlTemplate - the closed box
                      fell back to the item's raw ToString(). An explicit template is
                      always honoured for both the dropdown and the closed box.
                    -->
                    <ComboBox x:Name="CategoryFilter" Width="160" Margin="0,0,10,6"
                              SelectedValuePath="Id" SelectionChanged="Filter_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox x:Name="SortField" Width="120" Margin="0,0,4,6"
                              SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Nom" IsSelected="True" />
                        <ComboBoxItem Content="Quantité" />
                        <ComboBoxItem Content="Prix d'achat" />
                        <ComboBoxItem Content="Prix de vente" />
                    </ComboBox>
                    <Button x:Name="SortDirectionButton" Content="▲" Width="30" MinWidth="30"
                            Padding="0" Margin="0,0,10,6" ToolTip="Ordre croissant"
                            Style="{StaticResource SecondaryButton}" Click="SortDirection_Click" />

                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="IconViewButton" Content="▦" Width="30" Padding="0"
                                    Style="{StaticResource PrimaryButton}" ToolTip="Vue en icônes"
                                    Click="IconView_Click" />
                            <Button x:Name="ListViewButton" Content="☰" Width="30" Padding="0" Margin="2,0,0,0"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Vue en liste"
                                    Click="ListView_Click" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="LowStockCheck" Content="Stock bas uniquement"
                              VerticalAlignment="Center" Margin="0,0,10,6"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />

                    <Button x:Name="MoreButton" Content="⋯ Plus" Margin="0,0,10,6"
                            Style="{StaticResource SecondaryButton}" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" Placement="Bottom">
                                <MenuItem x:Name="EditMenuItem" Header="Modifier" Click="Edit_Click" />
                                <MenuItem x:Name="AdjustMenuItem" Header="Ajuster le stock" Click="Adjust_Click" />
                                <MenuItem x:Name="HistoryMenuItem" Header="Historique" Click="History_Click" />
                                <MenuItem x:Name="DeleteMenuItem" Header="Supprimer" Click="Delete_Click" />
                                <Separator />
                                <MenuItem x:Name="CategoriesMenuItem" Header="Catégories…" Click="Categories_Click" />
                                <MenuItem Header="Actualiser" Click="Refresh_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="ExportButton" Content="📤 Exporter" Margin="0,0,0,6"
                            Style="{StaticResource SecondaryButton}" Click="Export_Click" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- Pagination -->
        <Border x:Name="PaginationPanel" DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrevPageButton" Content="◀ Précédent" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" MinWidth="90" TextAlignment="Center" />
                <Button x:Name="NextPageButton" Content="Suivant ▶" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="NextPage_Click" />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Grid>
            <Grid x:Name="StockContentGrid">
            <DataGrid x:Name="ProductGrid" MouseDoubleClick="Grid_DoubleClick"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="130" />

                    <DataGridTemplateColumn Header="Quantité" Width="90" SortMemberPath="Quantity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantityDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                            <Style.Triggers>
                                                <!-- Low stock is the one thing a shopkeeper scans for. -->
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Seuil" Binding="{Binding MinimumThreshold}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Prix d'achat" Width="130"
                                        Binding="{Binding CostPrice, Converter={StaticResource Currency}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Prix de vente" Width="130"
                                        Binding="{Binding Price, Converter={StaticResource Currency}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Emplacement" Binding="{Binding StorageLocation}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer x:Name="IconScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="IconGrid" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="IconGrid_SelectionChanged"
                         MouseDoubleClick="IconGrid_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="12" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder" Width="150" Height="180"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <Border Width="150" Height="100"
                                            Background="{DynamicResource SurfaceAlt}"
                                            CornerRadius="6,6,0,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Product.Name}" />
                                        <TextBlock Text="{Binding Product.Price, Converter={StaticResource Currency}}"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                        <TextBlock Margin="0,2,0,0">
                                            <Run Text="Stock : " Foreground="{DynamicResource TextSecondary}" />
                                            <Run Text="{Binding Product.QuantityDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AccentLight}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Border x:Name="EmptyPanel" Visibility="Collapsed"
                    Background="{DynamicResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="Aucun produit" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource PageSubtitle}"
                               TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#66FFFFFF">
                <TextBlock Text="Chargement…" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource TextSecondary}" />
            </Border>
            </Grid>

            <!-- Analyse tab: a few numbers computed from the products already loaded, no
                 extra API calls of its own. -->
            <Border x:Name="AnalysePanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Aperçu du stock" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="Calculé sur les produits actuellement chargés, filtres compris."
                                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />
                        <WrapPanel x:Name="AnalyseStatsPanel" Orientation="Horizontal" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
