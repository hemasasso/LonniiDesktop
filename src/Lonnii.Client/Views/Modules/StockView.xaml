<UserControl x:Class="Lonnii.Client.Views.Modules.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Gestion de Stock" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
          Toolbar. Actions and filters sit on separate rows: side by side they did not fit
          at the default window width and the filters were clipped off the right edge.
        -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="AddButton" Content="Nouveau produit"
                            Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                    <Button x:Name="EditButton" Content="Modifier" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Edit_Click" />
                    <Button x:Name="AdjustButton" Content="Ajuster le stock" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Adjust_Click" />
                    <Button x:Name="HistoryButton" Content="Historique" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="History_Click" />
                    <Button x:Name="DeleteButton" Content="Supprimer" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Delete_Click" />
                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Border}" />
                    <Button x:Name="CategoriesButton" Content="Catégories…" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButton}" Click="Categories_Click" />
                    <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />

                    <Rectangle Width="1" Margin="10,2" Fill="{StaticResource Border}" />
                    <Button x:Name="IconViewButton" Content="▦ Icônes" Margin="0,0,4,0"
                            Style="{StaticResource PrimaryButton}" Click="IconView_Click" />
                    <Button x:Name="ListViewButton" Content="☰ Liste"
                            Style="{StaticResource SecondaryButton}" Click="ListView_Click" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Rechercher" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Width="240"
                             ToolTip="Rechercher par nom, SKU ou code-barres"
                             TextChanged="Search_TextChanged"
                             KeyDown="Search_KeyDown" />
                    <Button Content="OK" MinWidth="48" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Refresh_Click" />

                    <TextBlock Text="Catégorie" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" Margin="18,0,8,0" />
                    <ComboBox x:Name="CategoryFilter" Width="180"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="Filter_Changed" />

                    <CheckBox x:Name="LowStockCheck" Content="Stock bas uniquement"
                              VerticalAlignment="Center" Margin="18,0,0,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{StaticResource DangerLight}"
                BorderBrush="{StaticResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- Pagination -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrevPageButton" Content="◀ Précédent" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" MinWidth="90" TextAlignment="Center" />
                <Button x:Name="NextPageButton" Content="Suivant ▶" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="NextPage_Click" />
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Grid>
            <DataGrid x:Name="ProductGrid" MouseDoubleClick="Grid_DoubleClick"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produit" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding CategoryName}" Width="130" />

                    <DataGridTemplateColumn Header="Quantité" Width="90" SortMemberPath="Quantity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Quantity}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                            <Style.Triggers>
                                                <!-- Low stock is the one thing a shopkeeper scans for. -->
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Seuil" Binding="{Binding MinimumThreshold}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Prix d'achat" Width="130"
                                        Binding="{Binding CostPrice, Converter={StaticResource Currency}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Prix de vente" Width="130"
                                        Binding="{Binding Price, Converter={StaticResource Currency}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Emplacement" Binding="{Binding StorageLocation}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer x:Name="IconScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="IconGrid" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="IconGrid_SelectionChanged"
                         MouseDoubleClick="IconGrid_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="12" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder" Width="150" Height="180"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <Border Width="150" Height="100"
                                            Background="{StaticResource SurfaceAlt}"
                                            CornerRadius="6,6,0,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Product.Name}" />
                                        <TextBlock Text="{Binding Product.Price, Converter={StaticResource Currency}}"
                                                   Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                        <TextBlock Margin="0,2,0,0">
                                            <Run Text="Stock : " Foreground="{StaticResource TextSecondary}" />
                                            <Run Text="{Binding Product.Quantity, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentLight}" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <Border x:Name="EmptyPanel" Visibility="Collapsed"
                    Background="{StaticResource Surface}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="Aucun produit" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource PageSubtitle}"
                               TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#66FFFFFF">
                <TextBlock Text="Chargement…" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="14" Foreground="{StaticResource TextSecondary}" />
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
