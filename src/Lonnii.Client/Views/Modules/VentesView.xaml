<UserControl x:Class="Lonnii.Client.Views.Modules.VentesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:Lonnii.Client.Controls"
             Background="{DynamicResource Surface}">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="18,14"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Accent}">
                        <!-- Segoe MDL2 Assets rather than the 🛒 emoji: an emoji glyph keeps
                             its own built-in colours regardless of Foreground, which read as
                             a dark, low-contrast icon on this Accent-coloured badge. An icon
                             font glyph is plain vector art that takes Foreground like text does. -->
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Gestion des Ventes" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Live encaissé for the caller's own open session - visible at a glance
                         so the cashier does not have to open the caisse dialog just to see
                         where they stand. Collapsed while nothing is open. -->
                    <StackPanel x:Name="CaisseAmountPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Caisse (Encaissé)" Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="CaisseAmountText" FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource Success}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button x:Name="CaisseHistoryButton" Content="🕘 Historique Caisse" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" Click="CaisseHistory_Click" />
                    <Button x:Name="OpenCaisseButton" Content="🏦 Ouvrir Caisse"
                            Style="{StaticResource SecondaryButton}" Click="OpenCaisse_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Module tabs -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NouvelleVenteTabButton" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="NouvelleVenteTab_Click">
                    <TextBlock Text="＋ Nouvelle Vente" Style="{StaticResource ButtonContentText}" />
                </Button>
                <!-- Tag carries the identity SetActiveTab/ApplyTabVisuals compare against -
                     Content is now a StackPanel (icon + label) rather than a plain string,
                     since the 📈 emoji ignored Foreground and stayed dark on this tab's
                     Accent-coloured active state. -->
                <Button x:Name="ListeVentesTabButton" Tag="liste" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="OtherTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                   Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                        <TextBlock Text="Liste des Ventes" Style="{StaticResource ButtonContentText}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StatistiquesTabButton" Tag="statistiques" Margin="0,0,6,0"
                        Style="{StaticResource ModuleTabButton}" Click="OtherTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                   Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                        <TextBlock Text="Statistiques" Style="{StaticResource ButtonContentText}" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Margin="6,4,12,4" Fill="{DynamicResource Border}" />
                <!-- Not a tab: the client space opens in its own window, like Fournisseurs in Stock. -->
                <Button x:Name="ClientsButton" Style="{StaticResource SecondaryButton}" Click="Clients_Click"
                        ToolTip="Clients : classement par achats, créances, fiches">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                   Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                        <TextBlock Text="Clients" Style="{StaticResource ButtonContentText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status strip -->
        <Border x:Name="MessagePanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource DangerLight}"
                BorderBrush="{DynamicResource Danger}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <!-- The three tabs, stacked in one cell so whichever is visible fills the remaining
             DockPanel area - a DockPanel only stretches its LAST child to fill, so having
             these as separate un-docked siblings left the "Liste" and "Statistiques" panels
             sized to their content instead of the window. -->
        <Grid>

        <!-- Statistiques -->
        <Grid x:Name="StatistiquesPanel" Visibility="Collapsed">
            <DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StatsPeriodCombo" Width="170" Margin="0,0,8,0"
                                      SelectionChanged="StatsPeriod_Changed">
                                <ComboBoxItem Content="Aujourd'hui" Tag="today" />
                                <ComboBoxItem Content="7 derniers jours" Tag="week" />
                                <ComboBoxItem Content="Ce mois" Tag="month" IsSelected="True" />
                                <ComboBoxItem Content="Cette année" Tag="year" />
                                <ComboBoxItem Content="Période personnalisée" Tag="custom" />
                            </ComboBox>
                            <ComboBox x:Name="StatsCategoryCombo" Width="170" Margin="0,0,8,0"
                                      SelectionChanged="StatsFilters_Changed" />
                            <ComboBox x:Name="StatsProductCombo" Width="200"
                                      SelectionChanged="StatsFilters_Changed" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RefreshStats_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                           Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                                <TextBlock Text="Actualiser" Style="{StaticResource ButtonContentText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!-- KPI tiles, built in code-behind (BuildStatTile) -->
                            <WrapPanel x:Name="StatsTilesPanel" Orientation="Horizontal" Margin="0,0,0,6" />

                            <!-- Category / payment breakdown -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,0,5,10" Padding="14"
                                        CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                    <StackPanel>
                                        <TextBlock Text="Ventes par Catégorie" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Grid Height="260">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <!-- LiveCharts' own legend is rendered by SkiaSharp and reads
                                                 blurry at most Windows display scales - a plain WPF list
                                                 stays crisp and lets each row carry its percentage. -->
                                            <!-- TooltipPosition Hidden: LiveCharts' built-in
                                                 tooltip is SkiaSharp-rendered like its legend
                                                 was, and reads just as blurry - the legend to
                                                 the right already carries the same name/value. -->
                                            <lvc:PieChart x:Name="CategoryPieChart" Grid.Column="0"
                                                          Background="Transparent" TooltipPosition="Hidden" />
                                            <StackPanel x:Name="CategoryLegendPanel" Grid.Column="1"
                                                        VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock x:Name="CategoryEmptyText" Text="Aucune donnée disponible."
                                                       Grid.ColumnSpan="2"
                                                       Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Style="{StaticResource PageSubtitle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Margin="5,0,0,10" Padding="14"
                                        CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                    <StackPanel>
                                        <TextBlock Text="Répartition des Paiements" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Grid Height="260">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <lvc:PieChart x:Name="PaymentPieChart" Grid.Column="0"
                                                          Background="Transparent" TooltipPosition="Hidden" />
                                            <StackPanel x:Name="PaymentLegendPanel" Grid.Column="1"
                                                        VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock x:Name="PaymentEmptyText" Text="Aucune donnée disponible."
                                                       Grid.ColumnSpan="2"
                                                       Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Style="{StaticResource PageSubtitle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Revenue over time -->
                            <Border Padding="14" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <TextBlock x:Name="RevenueChartTitle" Text="Évolution du Chiffre d'Affaires"
                                               FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="240">
                                        <lvc:CartesianChart x:Name="RevenueChart" Background="Transparent" />
                                        <TextBlock x:Name="RevenueEmptyText" Text="Aucune donnée disponible."
                                                   Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource PageSubtitle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Top products -->
                            <Border Padding="14" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                <StackPanel>
                                    <TextBlock x:Name="TopProductsChartTitle" Text="Produits les Plus Vendus"
                                               FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid Height="260">
                                        <lvc:CartesianChart x:Name="TopProductsChart" Background="Transparent" />
                                        <TextBlock x:Name="TopProductsEmptyText" Text="Aucun produit vendu."
                                                   Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource PageSubtitle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="StatsEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <TextBlock Text="Aucune vente sur cette période." Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="StatsBusyPanel" Visibility="Collapsed" Background="#66FFFFFF">
                        <TextBlock Text="Chargement…" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>

            </DockPanel>
        </Grid>

        <!-- Liste des Ventes -->
        <Grid x:Name="ListeVentesPanel" Visibility="Collapsed">
            <DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="240" Margin="0,0,8,0">
                                <TextBox x:Name="VenteSearchBox"
                                         TextChanged="VenteSearch_TextChanged" KeyDown="VenteSearch_KeyDown" />
                                <TextBlock x:Name="VenteSearchPlaceholder" Text="🔍 N° vente, client ou vendeur…"
                                           Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <!-- The Vendeur label is replaced at load by the shop's own SellerLabel
                                 from Paramètre Reçu et Facture - see VentesView.ApplySellerLabel. -->
                            <ComboBox x:Name="VenteSearchTypeCombo" Width="130" Margin="0,0,8,0"
                                      SelectionChanged="VenteFilters_Changed">
                                <ComboBoxItem Content="Tous" Tag="both" IsSelected="True" />
                                <ComboBoxItem Content="Client" Tag="client" />
                                <ComboBoxItem x:Name="VendeurSearchItem" Content="Vendeur" Tag="vendeur" />
                                <ComboBoxItem Content="Caissier" Tag="caissier" />
                            </ComboBox>
                            <ComboBox x:Name="VenteStatusCombo" Width="150" Margin="0,0,8,0"
                                      SelectionChanged="VenteFilters_Changed">
                                <ComboBoxItem Content="Tous les statuts" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="Payé" Tag="paid" />
                                <ComboBoxItem Content="Partiel" Tag="partial" />
                                <ComboBoxItem Content="En attente" Tag="pending" />
                                <ComboBoxItem Content="Avoir" Tag="avoir" />
                                <ComboBoxItem Content="Annulé" Tag="cancelled" />
                            </ComboBox>
                            <ComboBox x:Name="VenteDateFilterCombo" Width="170"
                                      SelectionChanged="VenteDateFilter_Changed">
                                <ComboBoxItem Content="Aujourd'hui" Tag="today" IsSelected="True" />
                                <ComboBoxItem Content="7 derniers jours" Tag="week" />
                                <ComboBoxItem Content="Ce mois" Tag="month" />
                                <ComboBoxItem Content="Cette année" Tag="year" />
                                <ComboBoxItem Content="Période personnalisée" Tag="custom" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ExportVentesButton" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" Click="ExportVentes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬇" Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                                    <TextBlock Text="Exporter" Style="{StaticResource ButtonContentText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="RefreshVentes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                               Style="{StaticResource ButtonContentText}" Margin="0,0,6,0" />
                                    <TextBlock Text="Actualiser" Style="{StaticResource ButtonContentText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="VentePaginationPanel" DockPanel.Dock="Bottom" Margin="0,6" Visibility="Collapsed">
                    <controls:PaginationBar x:Name="VentePagerBar" PageChanged="VentePagerBar_PageChanged" />
                </Border>

                <Grid>
                    <ScrollViewer x:Name="VenteListScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,10">
                            <Grid x:Name="VenteListHeaderRow" Margin="0,0,0,6" />
                            <ItemsControl x:Name="VenteListRows" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="VenteListEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <TextBlock Text="Aucune vente trouvée." Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="VenteListBusyPanel" Visibility="Collapsed" Background="#66FFFFFF">
                        <TextBlock Text="Chargement…" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>

            </DockPanel>
        </Grid>

        <!-- Nouvelle Vente -->
        <Grid x:Name="NouvelleVentePanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <DockPanel Grid.Column="0">

                <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarPanel}">
                    <StackPanel>
                        <Grid Width="320" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox"
                                     ToolTip="Rechercher un produit"
                                     TextChanged="Search_TextChanged"
                                     KeyDown="Search_KeyDown" />
                            <TextBlock x:Name="SearchPlaceholder" Text="🔍 Rechercher un produit…"
                                       Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="CategoryPillPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Catalogue pager: only one page of tiles (and so of thumbnails to
                     download) is built at a time, so a shop with hundreds of products still
                     opens Nouvelle Vente instantly. -->
                <Border x:Name="CatalogPager" DockPanel.Dock="Bottom" Padding="12,6"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <!-- A 3-column Grid (*, Auto, *) split the leftover space evenly between the
                         count text and the "Par page" combo, regardless of how much either
                         actually needed - on a narrow window the Auto centre (prev/page/next)
                         claimed its width first and could leave the two Star columns with
                         almost nothing, clipping the page-size combo. A DockPanel instead gives
                         the count text and the "Par page" group their natural width first, and
                         only what floats in the middle (the pager buttons) gets squeezed. -->
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="CatalogCountText" DockPanel.Dock="Left" Style="{StaticResource PageSubtitle}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Par page" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CatalogPageSizeCombo" Width="70" SelectionChanged="CatalogPageSize_Changed">
                                <ComboBoxItem Content="8" IsSelected="True" />
                                <ComboBoxItem Content="12" />
                                <ComboBoxItem Content="24" />
                                <ComboBoxItem Content="48" />
                                <ComboBoxItem Content="96" />
                            </ComboBox>
                        </StackPanel>
                        <controls:PaginationBar x:Name="CatalogPagerBar" PageChanged="CatalogPagerBar_PageChanged" />
                    </DockPanel>
                </Border>

                <Grid>
                    <!-- ListBox's own default template already carries an internal ScrollViewer;
                         left enabled, it fights this explicit outer one for vertical scroll and
                         the visible viewport ends up cropping the last row mid-card with no way
                         to scroll the rest into view. Disabling it here hands all vertical
                         scrolling to ProductScroll, so a row is either fully shown or fully
                         scrolled past, never sliced in half. -->
                    <ScrollViewer x:Name="ProductScroll" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ProductGrid" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="ProductGrid_SelectionChanged"
                                 PreviewMouseWheel="ProductGrid_PreviewMouseWheel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Centered, not left-aligned: on a wide window a row of
                                         150px cards otherwise hugs the left edge with a bare
                                         gap down the right, instead of sitting in the middle
                                         of the space actually given to the catalogue. -->
                                    <WrapPanel Orientation="Horizontal" Margin="12" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="12,6,12,18" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- The box is the photo only: its own border and rounded
                                         corners on all four sides. Name, price and stock sit
                                         beneath it, on the transparent tile background, not
                                         sharing the photo's box. -->
                                    <StackPanel Width="150">
                                        <Border Width="150" Height="80"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="8" ClipToBounds="True">
                                            <!-- SurfaceAlt only behind the placeholder icon. A
                                                 real photo's own background is white, and Uniform
                                                 stretch can letterbox a non-matching aspect ratio,
                                                 so a grey SurfaceAlt fill would show as bands down
                                                 the sides; white makes the letterbox invisible. -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNoThumbnail}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVis}}" />
                                                <!-- Uniform, not UniformToFill: a fill crops to
                                                     the box, and product photos often carry a lot
                                                     of empty margin around the product, so a crop
                                                     can slice through the product itself instead of
                                                     the margin. Uniform always shows the whole photo. -->
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="2,8,2,0">
                                            <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Product.Name}" />
                                            <TextBlock Margin="0,2,0,0" Text="{Binding PriceDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Product.PrixFixe}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- On its own line, not next to the price: a Vente
                                                 Mixte product's display can read "17 paquet & 5
                                                 unité", which overflowed past the 150px tile when
                                                 it shared a horizontal row with the price. Trimmed
                                                 with the full text kept in the tooltip. -->
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Product.QuantityDisplay, Mode=OneWay}">
                                                <Run Text="Qté : " />
                                                <Run Text="{Binding Product.QuantityDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
                        <TextBlock Text="Aucun produit ne correspond à votre recherche."
                                   Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#66FFFFFF">
                        <TextBlock Text="Chargement…" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Cart -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <DockPanel Margin="14">

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="CartTitleText" Text="PANIER (0)" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <Button x:Name="ClearCartButton" HorizontalAlignment="Right"
                                Style="{StaticResource DangerButton}"
                                MinWidth="0" Padding="10,4" FontSize="12"
                                Click="ClearCart_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Style="{StaticResource ButtonContentText}" Margin="0,0,4,0" />
                                <TextBlock Text="Vider" Style="{StaticResource ButtonContentText}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Capped rather than left to its natural (Auto) height: with the
                         checkout fields expanded (Paiement/Facture checked) this section can
                         easily need more room than a small laptop screen gives the cart column,
                         and DockPanel would otherwise let it grow without limit and push the
                         product list out of view entirely instead of just scrolling. -->
                    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Visibility gated on can_apply_discount in code-behind - without
                             this, a vendeur who cannot apply a per-line discount (BuildCartRow)
                             could still zero out the whole sale here regardless. -->
                        <Border x:Name="RemiseGlobalePanel"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Warning}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Remise globale"
                                           Foreground="{DynamicResource Warning}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock DockPanel.Dock="Right" x:Name="RemiseCurrencyText"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBox x:Name="RemiseGlobaleBox" Text="0" />
                            </DockPanel>
                        </Border>

                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="SOUS-TOTAL" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="SubtotalText" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="ItemDiscountRow" Visibility="Collapsed" Margin="0,2,0,0">
                                    <TextBlock Text="REMISE ARTICLES" FontSize="11"
                                               Foreground="{DynamicResource Danger}" />
                                    <TextBlock x:Name="ItemDiscountText" FontSize="11"
                                               Foreground="{DynamicResource Danger}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="RemiseSummaryRow" Visibility="Collapsed" Margin="0,2,0,0">
                                    <TextBlock Text="REMISE GLOBALE" FontSize="11"
                                               Foreground="{DynamicResource Danger}" />
                                    <TextBlock x:Name="RemiseSummaryText" FontSize="11"
                                               Foreground="{DynamicResource Danger}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Only when the workspace's prices are HT: the TVA the till adds. -->
                                <Grid x:Name="TvaRow" Visibility="Collapsed" Margin="0,2,0,0">
                                    <TextBlock x:Name="TvaLabelText" Text="TVA" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TvaText" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Total" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TotalText" Text="0"
                                               FontWeight="Bold" FontSize="18"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="VenteRapideCheck" Content="Paiement"
                                      Margin="0,0,16,0" />
                            <CheckBox x:Name="AvecFactureCheck" Content="Facture"
                                      Checked="AvecFacture_Checked" Unchecked="AvecFacture_Unchecked" />
                        </StackPanel>

                        <!-- Shown instead of the checkboxes above for a user without
                             can_add_payment: their cart can only produce an unpaid facture. -->
                        <TextBlock x:Name="FactureOnlyNotice" Visibility="Collapsed"
                                   Text="Mode facture uniquement : vous n'êtes pas autorisé à encaisser."
                                   Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />

                        <!-- Only meaningful once a checkout mode is chosen - collapsed for
                             neither checked, same as the payment-method row and for the
                             same reason: nothing would be done with what is typed here. -->
                        <StackPanel x:Name="ClientFieldsPanel">
                            <Grid Margin="0,0,0,6">
                                <TextBox x:Name="ClientNomBox" PreviewKeyDown="ClientNom_PreviewKeyDown" />
                                <TextBlock x:Name="ClientNomPlaceholder" Text="Nom client (optionnel)"
                                           Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <!-- Known clients matching what is typed, best customers first. -->
                            <Popup x:Name="ClientSuggestPopup" PlacementTarget="{Binding ElementName=ClientNomBox}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   Width="{Binding ActualWidth, ElementName=ClientNomBox}">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1">
                                    <ListBox x:Name="ClientSuggestList" MaxHeight="240" BorderThickness="0"
                                             PreviewMouseLeftButtonUp="ClientSuggest_MouseUp"
                                             KeyDown="ClientSuggest_KeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <!-- Téléphone and email share a row - two separate rows cost more
                                 vertical space than this section can spare once Paiement or
                                 Facture is checked and the payment-method row appears below. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="ClientTelephoneBox" ToolTip="Téléphone du client" />
                                    <TextBlock x:Name="ClientTelephonePlaceholder" Text="Téléphone (optionnel)"
                                               Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="ClientEmailBox" ToolTip="Email du client" />
                                    <TextBlock x:Name="ClientEmailPlaceholder" Text="Email (optionnel)"
                                               Foreground="{DynamicResource TextMuted}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                            <!-- Shown as soon as the name or phone matches a client who still owes. -->
                            <Border x:Name="ClientDuePanel" Visibility="Collapsed" Margin="0,0,0,6" Padding="10,6"
                                    Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Warning}"
                                    BorderThickness="1" CornerRadius="3">
                                <TextBlock x:Name="ClientDueText" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Warning}" />
                            </Border>
                        </StackPanel>

                        <!-- Only meaningful when money is actually changing hands: hidden for
                             a facture, which is by definition unpaid. -->
                        <!-- Segoe MDL2 Assets glyphs, not emoji: the button's own Style swaps
                             Foreground between white (selected/Primary) and dark (Secondary),
                             and only a real icon font follows that - an emoji keeps its own
                             built-in colour no matter what Foreground says. -->
                        <StackPanel x:Name="PaymentModePanel" Orientation="Horizontal"
                                    Margin="0,4,0,6" HorizontalAlignment="Center">
                            <Button x:Name="PaymentCashButton"
                                    Width="44" Height="30" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Espèces"
                                    Click="PaymentMode_Click" Tag="cash">
                                <TextBlock Text="&#xEC59;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource ButtonContentText}" />
                            </Button>
                            <Button x:Name="PaymentMobileButton"
                                    Width="44" Height="30" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Mobile Money"
                                    Click="PaymentMode_Click" Tag="mobile_money">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource ButtonContentText}" />
                            </Button>
                            <Button x:Name="PaymentCarteButton"
                                    Width="44" Height="30"
                                    Style="{StaticResource SecondaryButton}" ToolTip="Carte"
                                    Click="PaymentMode_Click" Tag="carte">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource ButtonContentText}" />
                            </Button>
                        </StackPanel>

                        <Button x:Name="ValidateButton"
                                Style="{StaticResource PrimaryButton}"
                                Padding="0,8" IsEnabled="False"
                                Click="Validate_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="ValidateButtonIcon" Text="&#xE8FB;"
                                           Style="{StaticResource ButtonContentText}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="ValidateButtonLabel" Text="Payer &amp; Valider"
                                           Style="{StaticResource ButtonContentText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- MinHeight so the product list always keeps some real space, even
                         alongside the (now capped, see the ScrollViewer above) checkout
                         section on a short window - it should never be squeezed to nothing. -->
                    <Grid MinHeight="120">
                        <Border x:Name="CartEmptyPanel">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="34" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="Votre panier est vide" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,2" />
                                <TextBlock Text="Cliquez sur un produit pour l'ajouter"
                                           Style="{StaticResource PageSubtitle}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="CartScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CartList" />
                        </ScrollViewer>
                    </Grid>

                </DockPanel>
            </Border>

        </Grid>

        </Grid>

    </DockPanel>
</UserControl>
