<Window x:Class="Lonnii.Client.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="185" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ValueBox" Grid.Row="1" />

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="Valider" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
